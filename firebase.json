{
  "hosting": {
    "public": "dist/client",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/admin",
        "headers": [
          { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/admin",
        "run": {
          "serviceId": "rajarata-engineering-admin",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "/admin/**",
        "run": {
          "serviceId": "rajarata-engineering-admin",
          "region": "asia-south1",
          "pinTag": true
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
