---
/**
 * Contact page.
 *
 * Route shell with the shared layout. Section components land in
 * src/components/contact/ and are rendered here as the Phase 6
 * steps come in.
 *
 * `pt-20` clears the fixed header — same arrangement as Home,
 * Services, About Us, and Projects.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import EmergencySupport from '../components/contact/EmergencySupport.astro';
---

<Base
  title="Rajarata Engineering | Contact"
  description="[REPLACE: contact page meta description]"
>
  <Header />

  <main class="w-full pt-20 bg-surface">
    <ContactHero />
    <EmergencySupport />
  </main>

  <Footer />
</Base>