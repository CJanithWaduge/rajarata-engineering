---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Chip from '../components/ui/Chip.astro';
import Field from '../components/ui/Field.astro';
---

<Base title="Rajarata Engineering | Electrical Engineering & Contracting" description="[REPLACE: 1-2 sentence company introduction]">
  <Header />

  <!-- pt-20 clears the fixed header. This padding is the page's job. -->
  <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
    <section class="bg-surface-container-lowest py-16">
      <Container>
        <h1 class="font-display-hero text-display-hero text-primary-container">Rajarata</h1>
        <p class="font-body-lg text-body-lg text-secondary">Step 6 header check</p>
      </Container>
    </section>

    <!-- one full screen of scroll, to confirm the fixed header behaves -->
    <section class="bg-surface-container-low py-16">
      <Container class="space-y-6">
        <h2 class="font-headline-md text-headline-md text-on-surface">Scroll test</h2>
        <p class="font-body-md text-body-md text-secondary">
          Tab the nav, then scroll. The header should stay put and the red underline
          should sit under the active item only.
        </p>
        <div class="flex flex-wrap gap-3">
          <Chip>Operational</Chip>
          <Chip variant="critical">Critical</Chip>
          <Chip variant="elv">ELV</Chip>
          <Chip variant="warning" dot>HV warning</Chip>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          <Card>
            <h3 class="font-title-lg text-title-lg">Card</h3>
            <p class="font-body-md text-body-md text-secondary">Primitives still work.</p>
          </Card>
          <Card inverted>
            <h3 class="font-title-lg text-title-lg">Inverted</h3>
            <p class="font-body-md text-body-md text-white/70">Accent strip on the left.</p>
          </Card>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          <Field name="scratch-name" label="Full Name" placeholder="e.g. A. Perera" required />
          <Field
            name="scratch-error"
            label="Company"
            error="Company name is required before we can quote."
            required
          />
        </div>
        <div class="flex flex-wrap gap-4">
          <Button>Primary</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="outline">Outline</Button>
          <Button size="sm">Primary sm</Button>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</Base>
