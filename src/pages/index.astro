---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import AboutIntro from '../components/home/AboutIntro.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
---

<Base title="Rajarata Engineering | Electrical Engineering & Contracting" description="[REPLACE: 1-2 sentence company introduction]">
  <Header />

  <!-- pt-20 clears the fixed header. This padding is the page's job. -->
  <main class="w-full pt-20 bg-surface">
    <Hero />
    <TrustStrip />
    <AboutIntro />
    <ServicesGrid />
    <WhyChoose />
  </main>

  <Footer />
</Base>