---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Container from '../components/Container.astro';
---

<Base
  title="Rajarata Engineering | Electrical Engineering & Contracting"
  description="[REPLACE: 1-2 sentence company introduction]"
>
  <!-- padded: the standard section wrapper -->
  <Container class="pt-16 pb-12">
    <div class="flex items-center gap-3">
      <Logo class="h-10 w-auto" />
      <span class="flex flex-col">
        <span class="font-title-lg text-title-lg tracking-tight text-on-surface uppercase"
          >Rajarata</span
        >
        <span
          class="font-label-caps text-label-caps tracking-widest text-primary uppercase"
          >Engineering</span
        >
      </span>
    </div>
  </Container>

  <!-- unpadded: full-bleed background, content still width-capped -->
  <Container padded={false}>
    <div class="bg-surface-container px-4 sm:px-6 lg:px-8 py-6">
      <p class="font-body-md text-body-md text-secondary">
        Unpadded variant — background spans the full width, inner content keeps
        its own gutters.
      </p>
    </div>
  </Container>

  <!-- narrow variant, to confirm w-full + max-w holds -->
  <div class="bg-surface-container-lowest">
    <Container class="py-6">
      <h1 class="font-display-hero text-display-hero text-primary-container">
        Rajarata
      </h1>
      <p class="font-body-md text-body-md text-secondary">Step 4 container check</p>
      <div
        class="bg-surface-container p-4 rounded-card shadow-card border border-outline-variant"
      >
        card &middot; 18px radius
      </div>
    </Container>
  </div>

  <!-- dark logo, for the footer later -->
  <div class="p-6 bg-[#0b0f17]">
    <Logo variant="dark" class="h-10 w-auto" />
  </div>
</Base>
