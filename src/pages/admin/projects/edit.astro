---
/**
 * Admin — Project editor (Phase 11, Step A11.6).
 *
 * Draft editing is emulator-only. Saving changes the working copy and never
 * updates the statically generated public pages.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import FormSection from '../../../components/admin/FormSection.astro';
import AdminField from '../../../components/admin/AdminField.astro';
import AssetThumb from '../../../components/admin/AssetThumb.astro';
import EditorActionBar from '../../../components/admin/EditorActionBar.astro';
import { CONTENT_SCHEMA_VERSION, type ProjectDraft } from '../../../lib/contentModel';
import { getDraftFirestore } from '../../../lib/firebaseAdmin';
import { getProjectDraft } from '../../../lib/draftRepository';

const focusRing =
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';

const types = [
  'LV Distribution',
  'Industrial Grade',
  'Switchgear & Enclosures',
  'Containment & Pulling',
  'Statutory Compliance',
  'Operations & SLA',
  'ELV & Automation',
  'Surge & Transient Defense',
];

const id = Astro.url.searchParams.get('id');
let loadError = '';
let record: ProjectDraft = {
  schemaVersion: CONTENT_SCHEMA_VERSION,
  id: '',
  order: 0,
  category: '',
  title: '',
  summary: '',
  specifications: '',
  location: '',
  year: null,
  reference: '',
  clientName: null,
  imageRef: null,
  altText: '',
  featured: false,
  archived: false,
  updatedAt: new Date().toISOString(),
};

if (id) {
  try {
    record = await getProjectDraft(getDraftFirestore(), Astro.locals.authUser, id);
  } catch (error) {
    loadError = error instanceof Error ? error.message : 'The project draft could not be loaded.';
    console.error('Project draft could not be loaded.', error);
  }
}
---

<AdminLayout title="Edit project" pageLabel="Edit project">
  <div class="space-y-6 pb-4" data-editor-root>
    <AdminPageHeader title={id ? 'Edit project draft' : 'Create project draft'} description="Update the unpublished working copy.">
      <Fragment slot="actions">
        <StatusChip status={record.archived ? 'archived' : 'draft'} />
        <a
          href="/admin/projects"
          class={`inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`}
        >
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_back</span>
          Back to projects
        </a>
      </Fragment>
    </AdminPageHeader>

    {loadError && <AdminNotice tone="error" title="Couldn’t load project draft">{loadError}</AdminNotice>}

    <form
      novalidate
      data-editor-form
      data-draft-kind="projects"
      data-expected-updated-at={id ? record.updatedAt : 'null'}
      hidden={Boolean(loadError)}
      class="space-y-6"
    >
      <input type="hidden" name="imageRef" value={record.imageRef ?? ''} />
      <input type="hidden" name="archived" value={String(record.archived)} />
      <FormSection
        title="Identity"
        description="How the project is named and addressed. The reference is stable and anchors the public link."
      >
        <AdminField
          name="title"
          label="Project title"
          value={record.title}
          helper="Shown as the portfolio card and page heading."
        />
        <AdminField
          name="id"
          label="Stable identifier"
          value={record.id}
          required
          requiredMessage="Enter a stable lowercase identifier."
          readonly={Boolean(id)}
          mono
          helper="Read-only: it anchors the public URL and cannot be edited after creation."
        />
        <AdminField
          name="type"
          type="select"
          label="Type / category"
          value={record.category}
          options={types.map((t) => ({ value: t, label: t }))}
          helper="Groups the project on the public portfolio."
        />
      </FormSection>

      <FormSection title="Summary and specification" description="Short and long copy for the project.">
        <AdminField
          name="summary"
          type="textarea"
          label="Short summary"
          rows={3}
          maxlength={180}
          counter
          value={record.summary}
          helper="Used on the portfolio card. Keep it to a single sentence."
        />
        <AdminField
          name="description"
          type="textarea"
          label="Detailed description / specification"
          rows={8}
          value={record.specifications}
          helper="Plain text only. Formatted text is not enabled and arbitrary HTML, scripts, or embeds are not accepted."
        />
      </FormSection>

      <FormSection
        title="Image, alt text, and caption"
        description="Media is retained as a reference; upload and selection are handled in the media-management phase."
      >
        <div class="flex flex-wrap items-center gap-4">
          <AssetThumb variant="missing" class="w-24" />
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                disabled
                title="Assigning an asset to this field is not connected."
                class={`inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface-variant opacity-60 ${focusRing}`}
              >
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">perm_media</span>
                Choose image
              </button>
              <a
                href="/admin/media"
                class={`inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`}
              >
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">folder_open</span>
                Open media library
              </a>
            </div>
            <p class="font-body-sm text-body-sm text-secondary">
              No asset is assigned in this preview. Cropping and focal-point controls are not part of
              the confirmed asset model, and selecting an asset for this field is not connected yet.
            </p>
          </div>
        </div>

        <AdminField
          name="alt"
          label="Image alt text"
          value={record.altText}
          maxlength={150}
          counter
          helper="Describe the content and purpose of the image, not the file name."
        />
      </FormSection>

      <FormSection
        title="Portfolio details"
        description="Optional labels shown on the public portfolio."
      >
        <AdminNotice tone="warning" title="Verified business data only">
          Location, year, and client must come from confirmed records. Do not enter unverified
          claims — leave a field blank instead.
        </AdminNotice>

        <div class="grid gap-5 sm:grid-cols-2">
          <AdminField
            name="location"
            label="Location"
            optional
            value={record.location}
            placeholder="e.g. Anuradhapura"
            helper="Only from verified business data."
          />
          <AdminField
            name="year"
            label="Year"
            optional
            value={record.year ?? ''}
            placeholder="e.g. 2025"
            helper="Only from verified business data."
          />
        </div>
        <AdminField
          name="client"
          label="Client"
          optional
          value={record.clientName ?? ''}
          placeholder="Only if the client has approved being named"
          helper="Only from verified business data. Never guess a client name."
        />
      </FormSection>

      <FormSection title="Placement" description="Ordering and featured status.">
        <AdminField
          name="order"
          type="number"
          label="Display order"
          value={record.order}
          helper="Lower numbers appear first in the portfolio."
        />

        <div class="flex items-start gap-3" data-field>
          <input
            id="featured"
            name="featured"
            type="checkbox"
            class="mt-0.5 h-5 w-5 shrink-0 rounded-chip border-[1.5px] border-outline-variant accent-primary-container focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
          />
          <label for="featured" class="min-w-0">
            <span class="block font-label-sm text-label-sm font-semibold text-on-surface">
              Featured project
            </span>
            <span class="block font-body-sm text-body-sm text-secondary">
              Surface this project near the top of the public portfolio.
            </span>
          </label>
        </div>
      </FormSection>

      <div
        data-editor-message
        role="alert"
        aria-live="assertive"
        class="hidden rounded-control border border-outline-variant bg-surface-container p-4 font-body-sm text-body-sm text-on-surface"
      >
      </div>

      <EditorActionBar />
    </form>

    <p class="font-body-sm text-body-sm text-secondary">
      Saving writes the validated working copy to the local Firestore emulator. It does not publish
      content or modify the public build. Location, year, and client details must come from verified
      business records.
    </p>
  </div>
</AdminLayout>

<script>
  import '../../../lib/adminEditor';
</script>
