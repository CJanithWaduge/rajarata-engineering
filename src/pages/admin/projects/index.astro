---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import type { ProjectDraft } from '../../../lib/contentModel';
import { getDraftFirestore } from '../../../lib/firebaseAdmin';
import { listProjectDrafts } from '../../../lib/draftRepository';

let projects: ProjectDraft[] = [];
let loadError = '';
try {
  projects = await listProjectDrafts(getDraftFirestore(), Astro.locals.authUser);
} catch (error) {
  loadError = error instanceof Error ? error.message : 'Draft storage is unavailable.';
  console.error('Project drafts could not be listed.', error);
}
const categories = [...new Set(projects.map(({ category }) => category).filter(Boolean))].sort();
const dateLabel = (value: string) => new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(new Date(value));
const focus = 'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';
---

<AdminLayout title="Projects" pageLabel="Projects">
  <div class="space-y-6" data-draft-list>
    <AdminPageHeader title="Projects" description="Manage unpublished portfolio drafts. Saving does not change the public site.">
      <Fragment slot="actions">
        <a href="/admin/projects/edit" class={`inline-flex h-10 items-center gap-2 rounded-control bg-primary-container px-5 font-label-md text-label-md text-on-primary ${focus}`}>
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">add</span>
          Add project
        </a>
      </Fragment>
    </AdminPageHeader>

    <AdminNotice tone="info" title="Drafts only">
      These records are stored in the local Firestore emulator. Publishing is not available, and
      draft changes do not affect public pages.
    </AdminNotice>

    {loadError ? (
      <AdminNotice tone="error" title="Couldn’t load project drafts">{loadError}</AdminNotice>
    ) : projects.length === 0 ? (
      <section class="rounded-card border border-outline-variant bg-surface-container-lowest p-6 shadow-card">
        <EmptyState icon="engineering" title="No project drafts yet">
          Create a draft when verified project details are available.
        </EmptyState>
      </section>
    ) : (
      <section class="overflow-hidden rounded-card border border-outline-variant bg-surface-container-lowest shadow-card">
        <div class="grid gap-3 border-b border-outline-variant bg-surface-container-low p-4 sm:grid-cols-3">
          <label class="space-y-1.5 font-label-sm text-label-sm font-semibold text-on-surface">
            Search
            <input id="project-search" type="search" class="h-11 w-full rounded-control border border-outline-variant bg-surface-container-lowest px-3 font-body-md text-body-md" placeholder="Title or identifier" />
          </label>
          <label class="space-y-1.5 font-label-sm text-label-sm font-semibold text-on-surface">
            Category
            <select id="project-category" class="h-11 w-full rounded-control border border-outline-variant bg-surface-container-lowest px-3 font-body-md text-body-md">
              <option value="all">All categories</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>
          <p class="self-end pb-2 font-body-sm text-body-sm text-secondary" aria-live="polite">
            <span id="project-count">{projects.length}</span> draft{projects.length === 1 ? '' : 's'}
          </p>
        </div>
        <div class="divide-y divide-outline-variant">
          {projects.map((project) => (
            <article
              data-draft-record
              data-id={project.id}
              data-name={project.title.toLocaleLowerCase()}
              data-category={project.category}
              data-updated-at={project.updatedAt}
              class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="font-title-md text-title-md text-on-surface">{project.title || 'Untitled draft'}</h2>
                  <StatusChip status={project.archived ? 'archived' : 'draft'} />
                </div>
                <p class="mt-1 font-mono text-body-sm text-body-sm text-secondary">{project.id}</p>
                <p class="mt-1 font-body-sm text-body-sm text-secondary">
                  {project.category || 'Uncategorized'} · Updated {dateLabel(project.updatedAt)}
                  {project.year ? ` · ${project.year}` : ''}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <a href={`/admin/projects/edit?id=${encodeURIComponent(project.id)}`} class={`inline-flex h-10 items-center rounded-control border border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focus}`}>Edit draft</a>
                <button
                  type="button"
                  data-draft-archive
                  data-kind="projects"
                  data-action={project.archived ? 'restore' : 'archive'}
                  data-id={project.id}
                  data-updated-at={project.updatedAt}
                  class={`inline-flex h-10 items-center rounded-control border border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focus}`}
                >{project.archived ? 'Restore' : 'Archive'}</button>
              </div>
            </article>
          ))}
          <p id="project-no-results" hidden class="p-6 text-center font-body-md text-body-md text-secondary">No project drafts match these filters.</p>
        </div>
      </section>
    )}
  </div>
</AdminLayout>

<script>
  import '../../../lib/adminDraftList';
</script>
