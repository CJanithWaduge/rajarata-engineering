---
/**
 * Admin — route frame (Phase 11, Step A11.1).
 *
 * Establishes `/admin` and proves the shell: navigation rail, context bar,
 * content canvas, and status presentation. The real dashboard overview is
 * built in Step A11.3; for now this renders the frame with an explicit
 * frontend-only notice so nothing reads as live content.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../components/admin/AdminNotice.astro';
import StatusChip from '../../components/admin/StatusChip.astro';
---

<AdminLayout title="Dashboard" pageLabel="Dashboard">
  <div class="space-y-6">
    <AdminPageHeader
      title="Admin console"
      description="Manage the approved public-site content, review a draft, and publish a release."
    />

    <AdminNotice tone="unavailable" title="Frontend preview — backend not connected">
      This console shows the approved admin layout and states. Authentication, content storage,
      media uploads, draft preview delivery, and publishing are not connected yet, so no control
      here saves or publishes real content.
    </AdminNotice>

    <section
      aria-labelledby="frame-heading"
      class="rounded-card border border-outline-variant bg-surface-container-lowest p-6 shadow-card"
    >
      <h2 id="frame-heading" class="font-headline-sm text-headline-sm text-on-surface">
        Shell frame
      </h2>
      <p class="mt-1 font-body-md text-body-md text-secondary">
        Responsive navigation, page context, administrator identity, and status presentation are
        in place. Content screens are added in the following steps.
      </p>

      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-control border border-outline-variant bg-surface-container-low p-4">
          <p class="font-label-caps text-label-caps uppercase tracking-widest text-secondary">
            Publication states
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <StatusChip status="draft" />
            <StatusChip status="published" />
            <StatusChip status="archived" />
          </div>
        </div>
        <div class="rounded-control border border-outline-variant bg-surface-container-low p-4">
          <p class="font-label-caps text-label-caps uppercase tracking-widest text-secondary">
            Pipeline states
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <StatusChip status="queued" />
            <StatusChip status="building" />
            <StatusChip status="deploying" />
            <StatusChip status="live" />
            <StatusChip status="failed" />
          </div>
        </div>
        <div class="rounded-control border border-outline-variant bg-surface-container-low p-4">
          <p class="font-label-caps text-label-caps uppercase tracking-widest text-secondary">
            Backend boundary
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <StatusChip status="unavailable" />
            <StatusChip status="attention" />
          </div>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>
