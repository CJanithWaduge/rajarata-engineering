---
/**
 * Admin sign-in (Phase 11, Step A11.2).
 *
 * Branded, accessible sign-in UI with labeled fields, a password visibility
 * control, inline validation, and a submitting state. Firebase Authentication
 * issues a short-lived ID token that the server exchanges for an HttpOnly
 * session cookie only after verifying the administrator claim.
 */
import AdminAuthLayout from '../../layouts/AdminAuthLayout.astro';
import Logo from '../../components/Logo.astro';

const focusRing =
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';

const inputBase =
  'w-full h-12 px-4 rounded-control bg-surface-container-lowest text-on-surface ' +
  'placeholder:text-secondary/60 border-[1.5px] border-outline-variant shadow-sm ' +
  'transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 ' +
  'focus-visible:outline-primary-container disabled:opacity-60 disabled:cursor-not-allowed';
---

<AdminAuthLayout title="Sign in">
  <div
    class="rounded-card border border-outline-variant bg-surface-container-lowest p-6 shadow-card sm:p-8"
  >
    <a href="/admin/login" class={`inline-flex items-center gap-3 rounded-control ${focusRing}`}>
      <Logo class="h-9 w-auto" />
    </a>

    <h1 class="mt-6 font-headline-md text-headline-md text-on-surface">Admin sign in</h1>
    <p class="mt-1 font-body-md text-body-md text-secondary">
      Sign in with the administrator account provisioned for you.
    </p>

    <form class="mt-6 space-y-5" novalidate data-login-form>
      <div class="space-y-1.5">
        <label
          for="login-email"
          class="font-label-sm text-label-sm font-semibold text-on-surface">Email address</label
        >
        <input
          id="login-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="username"
          spellcheck="false"
          placeholder="name@example.com"
          required
          aria-describedby="login-email-error"
          class={inputBase}
        />
        <p
          id="login-email-error"
          class="hidden font-body-sm text-body-sm text-primary-container"
        >
        </p>
      </div>

      <div class="space-y-1.5">
        <label
          for="login-password"
          class="font-label-sm text-label-sm font-semibold text-on-surface">Password</label
        >
        <div class="relative">
          <input
            id="login-password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="Enter your password"
            required
            aria-describedby="login-password-error"
            class={`${inputBase} pr-12`}
          />
          <button
            type="button"
            data-password-toggle
            aria-label="Show password"
            aria-pressed="false"
            class={`absolute right-2 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-control text-secondary hover:bg-surface-container-high ${focusRing}`}
          >
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true"
              >visibility</span
            >
          </button>
        </div>
        <p
          id="login-password-error"
          class="hidden font-body-sm text-body-sm text-primary-container"
        >
        </p>
      </div>

      <div
        id="login-form-message"
        role="alert"
        aria-live="assertive"
        class="hidden rounded-control border p-3 font-body-sm text-body-sm"
      >
      </div>

      <button
        type="submit"
        class={`inline-flex h-12 w-full items-center justify-center gap-2 rounded-control bg-primary-container px-7 font-label-md text-label-md text-on-primary shadow-sm transition-all duration-150 hover:bg-primary hover:shadow-md active:translate-y-[1px] motion-reduce:transition-none disabled:cursor-not-allowed disabled:opacity-60 ${focusRing}`}
      >
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">login</span>
        <span data-login-submit-label>Sign in</span>
      </button>
    </form>

    <div class="mt-6 space-y-2 border-t border-outline-variant pt-4">
      <p class="font-body-sm text-body-sm text-secondary">
        Password reset is handled by the project custodian.
      </p>
      <p class="font-body-sm text-body-sm text-secondary">
        Administrator accounts are provisioned by an authorised process — there is no public
        registration.
      </p>
    </div>
  </div>

  <p class="mt-6 text-center">
    <a
      href="/"
      class={`inline-flex items-center gap-1.5 font-label-md text-label-md text-secondary hover:text-on-surface ${focusRing}`}
    >
      <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_back</span>
      Back to public site
    </a>
  </p>
</AdminAuthLayout>

<script>
  import { signInWithEmailAndPassword, signOut } from 'firebase/auth';
  import { getFirebaseAuth } from '../../lib/firebaseClient';

  const form = document.querySelector<HTMLFormElement>('[data-login-form]');

  if (form) {
    const email = form.querySelector<HTMLInputElement>('#login-email');
    const password = form.querySelector<HTMLInputElement>('#login-password');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = form.querySelector<HTMLElement>('[data-login-submit-label]');
    const message = form.querySelector<HTMLElement>('#login-form-message');
    const toggle = form.querySelector<HTMLButtonElement>('[data-password-toggle]');

    const setFieldError = (input: HTMLInputElement | null, text: string) => {
      if (!input) return;
      const error = document.getElementById(`${input.id}-error`);
      input.setAttribute('aria-invalid', text ? 'true' : 'false');
      if (error) {
        error.textContent = text;
        error.classList.toggle('hidden', !text);
      }
    };

    const clearMessage = () => {
      if (!message) return;
      message.textContent = '';
      message.classList.add('hidden');
      message.classList.remove(
        'border-primary-container',
        'bg-error-container',
        'text-on-error-container',
        'bg-surface-container',
        'text-on-surface',
        'border-outline-variant'
      );
    };

    const showMessage = (text: string, tone: 'error' | 'info') => {
      if (!message) return;
      message.textContent = text;
      message.classList.remove('hidden');
      if (tone === 'error') {
        message.classList.add('border-primary-container', 'bg-error-container', 'text-on-error-container');
      } else {
        message.classList.add('border-outline-variant', 'bg-surface-container', 'text-on-surface');
      }
      message.setAttribute('tabindex', '-1');
      message.focus();
    };

    const getErrorMessage = (error: unknown): string => {
      if (typeof error === 'object' && error !== null && 'code' in error) {
        const code = error.code;
        if (
          code === 'auth/invalid-credential' ||
          code === 'auth/user-not-found' ||
          code === 'auth/wrong-password' ||
          code === 'auth/invalid-email'
        ) {
          return 'The email address or password is incorrect.';
        }
        if (code === 'auth/too-many-requests') {
          return 'Too many attempts. Please wait and try again.';
        }
      }

      if (
        error instanceof Error &&
        error.message === 'Firebase web configuration is incomplete.'
      ) {
        return 'Authentication is not configured for this environment. Contact the project operator.';
      }

      return 'Sign-in could not be completed. Please try again.';
    };

    const getCsrfToken = async (): Promise<string> => {
      const response = await fetch('/admin/session-csrf', {
        method: 'GET',
        credentials: 'same-origin',
        cache: 'no-store',
      });
      if (!response.ok) throw new Error('Unable to verify the security token.');

      const payload: unknown = await response.json();
      if (
        typeof payload !== 'object' ||
        payload === null ||
        !('csrfToken' in payload) ||
        typeof payload.csrfToken !== 'string'
      ) {
        throw new Error('The security token response was invalid.');
      }
      return payload.csrfToken;
    };

    const setBusy = (busy: boolean) => {
      if (!submit) return;
      submit.disabled = busy;
      submit.setAttribute('aria-busy', String(busy));
      form.setAttribute('aria-busy', String(busy));
      if (submitLabel) submitLabel.textContent = busy ? 'Signing in…' : 'Sign in';
    };

    // Password visibility toggle — keeps the control labelled and pressed-state
    // accurate so screen readers announce the current mode.
    toggle?.addEventListener('click', () => {
      if (!password) return;
      const reveal = password.type === 'password';
      password.type = reveal ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', String(reveal));
      toggle.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
      const icon = toggle.querySelector('.material-symbols-outlined');
      if (icon) icon.textContent = reveal ? 'visibility_off' : 'visibility';
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearMessage();

      const emailValue = email?.value.trim() ?? '';
      const passwordValue = password?.value ?? '';
      // Deliberately generic messages — never reveal whether an account exists.
      const emailError = !emailValue
        ? 'Enter your email address.'
        : !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailValue)
          ? 'Enter a valid email address.'
          : '';
      const passwordError = !passwordValue ? 'Enter your password.' : '';

      setFieldError(email, emailError);
      setFieldError(password, passwordError);

      if (emailError || passwordError) {
        const firstInvalid = emailError ? email : password;
        firstInvalid?.focus();
        return;
      }

      setBusy(true);
      let auth: Awaited<ReturnType<typeof getFirebaseAuth>> | undefined;
      try {
        auth = await getFirebaseAuth();
        const credential = await signInWithEmailAndPassword(auth, emailValue, passwordValue);
        const idToken = await credential.user.getIdToken(true);
        const csrfToken = await getCsrfToken();
        const response = await fetch('/admin/session', {
          method: 'POST',
          credentials: 'same-origin',
          cache: 'no-store',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
          },
          body: JSON.stringify({ idToken }),
        });

        await signOut(auth);
        if (!response.ok) {
          const text =
            response.status === 403
              ? 'This account is not authorized to use the Admin Console.'
              : response.status === 503
                ? 'Authentication is temporarily unavailable. Please try again.'
                : 'Sign-in could not be completed. Please try again.';
          showMessage(text, response.status === 503 ? 'info' : 'error');
          return;
        }

        const requestedReturnTo = new URLSearchParams(window.location.search).get('returnTo');
        const returnTo =
          requestedReturnTo?.startsWith('/admin/') &&
          !requestedReturnTo.startsWith('//') &&
          !requestedReturnTo.startsWith('/admin/login')
            ? requestedReturnTo
            : '/admin/';
        window.location.assign(returnTo);
      } catch (error) {
        if (auth?.currentUser) {
          try {
            await signOut(auth);
          } catch (signOutError) {
            console.error('Could not clear temporary Firebase Auth state.', signOutError);
            showMessage(
              'Sign-in could not be completed safely. Close this tab and contact the project operator.',
              'error',
            );
            setBusy(false);
            return;
          }
        }
        showMessage(getErrorMessage(error), 'error');
      } finally {
        setBusy(false);
      }
    });
  }
</script>
