---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';

const focusRing =
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';
const secondaryButton =
  `inline-flex min-h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`;
---

<AdminLayout title="Publishing History" pageLabel="Publishing History">
  <div class="space-y-6" data-publishing-root>
    <AdminPageHeader
      title="Publishing History"
      description="Publish a complete saved snapshot, inspect verified deployment status, or restore an earlier live release."
    >
      <Fragment slot="actions">
        <button
          type="button"
          data-publish-open
          class={`inline-flex h-10 items-center gap-2 rounded-control bg-primary-container px-5 font-label-md text-label-md text-on-primary hover:bg-primary ${focusRing}`}
        >
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">rocket_launch</span>
          Publish current draft
        </button>
      </Fragment>
    </AdminPageHeader>

    <section
      class="rounded-card border border-outline-variant bg-surface-container-lowest p-5 shadow-card"
      aria-labelledby="release-status-heading"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 id="release-status-heading" class="font-title-lg text-title-lg text-on-surface">
            Deployment status
          </h2>
          <p data-current-live class="mt-1 font-body-md text-body-md text-secondary">
            Checking the most recent confirmed Hosting release…
          </p>
        </div>
        <button type="button" data-refresh class={secondaryButton}>
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">refresh</span>
          Refresh status
        </button>
      </div>
      <div
        data-active-release
        class="mt-4 hidden rounded-control border border-outline-variant bg-surface-container-low p-4"
        aria-live="polite"
      ></div>
    </section>

    <section
      class="rounded-card border border-outline-variant bg-surface-container-lowest shadow-card"
      aria-labelledby="release-history-heading"
    >
      <header class="border-b border-outline-variant px-5 py-4">
        <h2 id="release-history-heading" class="font-title-lg text-title-lg text-on-surface">
          Release history
        </h2>
        <p class="mt-1 font-body-sm text-body-sm text-secondary">
          Up to 20 immutable snapshots are retained. A release is marked live only after Hosting confirms it.
        </p>
      </header>
      <div class="space-y-3 p-5" data-release-list aria-live="polite" aria-busy="true">
        <p class="font-body-md text-body-md text-secondary" role="status">Loading releases…</p>
      </div>
    </section>

    <p data-feedback class="font-body-sm text-body-sm text-secondary" role="status" aria-live="polite"></p>
  </div>

  <dialog
    data-confirm-dialog
    aria-labelledby="confirm-title"
    class={`w-[min(600px,92vw)] rounded-card border border-outline-variant bg-surface-container-lowest p-0 text-on-surface shadow-overlay backdrop:bg-inverse-surface/60 ${focusRing}`}
  >
    <div class="flex items-start justify-between gap-4 border-b border-outline-variant px-5 py-4">
      <h2 data-confirm-title id="confirm-title" class="font-headline-sm text-headline-sm text-on-surface">
        Confirm publish
      </h2>
      <button
        type="button"
        data-confirm-close
        aria-label="Close confirmation"
        class={`flex h-9 w-9 items-center justify-center rounded-control text-on-surface-variant hover:bg-surface-container-high ${focusRing}`}
      >
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">close</span>
      </button>
    </div>
    <div class="space-y-4 px-5 py-4">
      <p data-confirm-description class="font-body-md text-body-md text-secondary"></p>
      <div data-confirm-snapshot hidden class="rounded-control border border-outline-variant bg-surface-container-low p-4">
        <p class="font-label-caps text-label-caps uppercase tracking-widest text-secondary">
          Snapshot to restore
        </p>
        <p data-confirm-release class="mt-1 break-all font-body-md text-body-md text-on-surface"></p>
      </div>
      <p class="font-body-sm text-body-sm text-secondary">
        The previous public release remains live unless the publishing pipeline confirms the new deployment.
      </p>
      <p data-confirm-error class="hidden font-body-sm text-body-sm text-error" role="alert"></p>
    </div>
    <div class="flex flex-col-reverse gap-2 border-t border-outline-variant px-5 py-4 sm:flex-row sm:justify-end">
      <button type="button" data-confirm-close class={secondaryButton}>Cancel</button>
      <button
        type="button"
        data-confirm-submit
        class={`inline-flex h-10 items-center justify-center gap-2 rounded-control bg-primary-container px-5 font-label-md text-label-md text-on-primary hover:bg-primary disabled:cursor-not-allowed disabled:opacity-60 ${focusRing}`}
      >
        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">rocket_launch</span>
        <span data-confirm-label>Confirm publish</span>
      </button>
    </div>
  </dialog>
</AdminLayout>

<script>
  type ReleaseStatus = 'queued' | 'snapshotting' | 'building' | 'deploying' | 'live' | 'failed' | 'rollback';
  interface Release {
    id: string;
    createdAt: string;
    completedAt: string | null;
    createdBy: string;
    status: ReleaseStatus;
    hostVersionId: string | null;
    buildId: string | null;
    failure: { code: string; message: string } | null;
    rollbackOf: string | null;
    snapshot: {
      services: unknown[];
      projects: unknown[];
      pages: unknown[];
      media: unknown[];
    };
  }
  interface HistoryResponse {
    releases: Release[];
    activeReleaseId: string | null;
  }

  const root = document.querySelector<HTMLElement>('[data-publishing-root]');
  const list = root?.querySelector<HTMLElement>('[data-release-list]');
  const currentLive = root?.querySelector<HTMLElement>('[data-current-live]');
  const activePanel = root?.querySelector<HTMLElement>('[data-active-release]');
  const feedback = root?.querySelector<HTMLElement>('[data-feedback]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-confirm-dialog]');
  const confirmDescription = dialog?.querySelector<HTMLElement>('[data-confirm-description]');
  const confirmSnapshot = dialog?.querySelector<HTMLElement>('[data-confirm-snapshot]');
  const confirmRelease = dialog?.querySelector<HTMLElement>('[data-confirm-release]');
  const confirmError = dialog?.querySelector<HTMLElement>('[data-confirm-error]');
  const confirmButton = dialog?.querySelector<HTMLButtonElement>('[data-confirm-submit]');
  const confirmTitle = dialog?.querySelector<HTMLElement>('[data-confirm-title]');
  const statusStyles: Record<ReleaseStatus, string> = {
    queued: 'border-outline-variant bg-surface-container text-secondary',
    snapshotting: 'border-primary-fixed bg-primary-fixed text-on-primary-fixed',
    building: 'border-primary-fixed bg-primary-fixed text-on-primary-fixed',
    deploying: 'border-primary-fixed bg-primary-fixed text-on-primary-fixed',
    live: 'border-tertiary-fixed bg-tertiary-fixed text-on-tertiary-fixed',
    failed: 'border-error-container bg-error-container text-on-error-container',
    rollback: 'border-primary-fixed bg-primary-fixed text-on-primary-fixed',
  };
  const statuses = new Set<ReleaseStatus>([
    'queued', 'snapshotting', 'building', 'deploying', 'live', 'failed', 'rollback',
  ]);
  let pendingAction: { action: 'publish' } | { action: 'rollback'; releaseId: string } | undefined;
  let pollingTimer: number | undefined;

  function node<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className = '',
    text = '',
  ): HTMLElementTagNameMap[K] {
    const result = document.createElement(tag);
    if (className) result.className = className;
    if (text) result.textContent = text;
    return result;
  }

  function formatDate(value: string | null): string {
    if (!value) return 'Not completed';
    const date = new Date(value);
    return Number.isNaN(date.valueOf()) ? 'Unknown time' : date.toLocaleString();
  }

  function parseHistory(value: unknown): HistoryResponse | undefined {
    if (!value || typeof value !== 'object') return undefined;
    const candidate = value as Partial<HistoryResponse>;
    if (!Array.isArray(candidate.releases) ||
        !(candidate.activeReleaseId === null || typeof candidate.activeReleaseId === 'string')) {
      return undefined;
    }
    const releases = candidate.releases.filter((release): release is Release =>
      Boolean(release && typeof release.id === 'string' && statuses.has(release.status)),
    );
    return { releases, activeReleaseId: candidate.activeReleaseId };
  }

  function appendStatus(parent: HTMLElement, status: ReleaseStatus): void {
    parent.append(node(
      'span',
      `inline-flex items-center rounded-chip border px-2.5 py-1 font-label-sm text-label-sm ${statusStyles[status]}`,
      status === 'rollback' ? 'Rollback queued' : status[0].toUpperCase() + status.slice(1),
    ));
  }

  function snapshotSummary(release: Release): string {
    const parts = [
      `${release.snapshot.services.length} services`,
      `${release.snapshot.projects.length} projects`,
      `${release.snapshot.pages.length} page records`,
      `${release.snapshot.media.length} media assets`,
    ];
    return parts.join(' · ');
  }

  function renderRelease(release: Release, currentLiveId: string | null, busy: boolean): HTMLElement {
    const details = node('details', 'group rounded-control border border-outline-variant bg-surface-container-low');
    const summary = node(
      'summary',
      'flex cursor-pointer list-none flex-wrap items-center justify-between gap-3 p-4 hover:bg-surface-container-high focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container [&::-webkit-details-marker]:hidden',
    );
    const identity = node('span', 'min-w-0');
    identity.append(
      node('span', 'block break-all font-title-md text-title-md text-on-surface', release.id),
      node('span', 'mt-1 block font-body-sm text-body-sm text-secondary',
        `${formatDate(release.createdAt)} · ${snapshotSummary(release)}`),
    );
    summary.append(identity);
    appendStatus(summary, release.status);
    details.append(summary);

    const body = node('div', 'space-y-4 border-t border-outline-variant p-4');
    const metadata = node('dl', 'grid gap-3 sm:grid-cols-2');
    const values: Array<[string, string]> = [
      ['Requested', formatDate(release.createdAt)],
      ['Completed', formatDate(release.completedAt)],
      ['Build ID', release.buildId || 'Not reported'],
      ['Hosting version', release.hostVersionId || 'Not confirmed'],
    ];
    if (release.rollbackOf) values.push(['Restored from', release.rollbackOf]);
    values.forEach(([label, value]) => {
      const item = node('div');
      item.append(
        node('dt', 'font-label-caps text-label-caps uppercase tracking-widest text-secondary', label),
        node('dd', 'mt-1 break-all font-body-sm text-body-sm text-on-surface', value),
      );
      metadata.append(item);
    });
    body.append(metadata);

    if (release.failure) {
      const failure = node(
        'p',
        'rounded-control border border-error-container bg-error-container p-3 font-body-sm text-body-sm text-on-error-container',
        `Failure (${release.failure.code}): ${release.failure.message}`,
      );
      body.append(failure);
    }
    if (release.status === 'live' && release.id === currentLiveId) {
      const liveRow = node('div', 'flex flex-wrap items-center gap-2');
      liveRow.append(
        node('span', 'font-label-md text-label-md text-tertiary', 'Currently confirmed live'),
      );
      const siteLink = node('a', 'inline-flex min-h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container');
      siteLink.href = '/';
      siteLink.append(
        node('span', 'material-symbols-outlined text-[18px]', 'open_in_new'),
        document.createTextNode('View public site'),
      );
      liveRow.append(siteLink);
      body.append(liveRow);
    } else if (release.status === 'live' && !busy) {
      const rollback = node('button', 'inline-flex min-h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container', 'Roll back to this release') as HTMLButtonElement;
      rollback.type = 'button';
      rollback.addEventListener('click', () => openConfirm({
        action: 'rollback',
        releaseId: release.id,
      }));
      body.append(rollback);
    }
    body.append(node(
      'p',
      'font-body-sm text-body-sm text-secondary',
      'Snapshots are retained as immutable history. Rollback creates a new release; it never rewrites this record.',
    ));
    details.append(body);
    return details;
  }

  function render(data: HistoryResponse): void {
    if (!list || !currentLive || !activePanel) return;
    const publishButton = root?.querySelector<HTMLButtonElement>('[data-publish-open]');
    if (publishButton) publishButton.disabled = Boolean(data.activeReleaseId);
    const current = data.releases.find((release) => release.status === 'live');
    currentLive.textContent = current
      ? `Current confirmed release: ${current.id} · completed ${formatDate(current.completedAt)}`
      : 'No release has yet been confirmed live. The current public site has not been changed by this view.';

    activePanel.replaceChildren();
    activePanel.classList.toggle('hidden', !data.activeReleaseId);
    if (data.activeReleaseId) {
      const active = data.releases.find(({ id }) => id === data.activeReleaseId);
      activePanel.append(
        node('p', 'font-label-md text-label-md text-on-surface',
          active ? `Release ${active.id} is ${active.status}.` : 'A release operation is in progress.'),
        node('p', 'mt-1 font-body-sm text-body-sm text-secondary',
          'Status remains in progress until the trusted pipeline records a verified result.'),
      );
    }

    list.replaceChildren();
    list.setAttribute('aria-busy', 'false');
    if (data.releases.length === 0) {
      list.append(node(
        'p',
        'py-8 text-center font-body-md text-body-md text-secondary',
        'No releases have been recorded yet.',
      ));
      return;
    }
    data.releases.forEach((release) => {
      list.append(renderRelease(release, current?.id ?? null, Boolean(data.activeReleaseId)));
    });
  }

  async function loadHistory(): Promise<void> {
    if (!list) return;
    try {
      const response = await fetch('/admin/api/publishing', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      });
      const payload: unknown = await response.json();
      if (!response.ok) throw new Error('Release history is unavailable. Check your session and retry.');
      const data = parseHistory(payload);
      if (!data) throw new Error('The publishing service returned an invalid release history response.');
      render(data);
      if (data.activeReleaseId) {
        if (pollingTimer === undefined) {
          pollingTimer = window.setInterval(() => void loadHistory(), 10_000);
        }
      } else if (pollingTimer !== undefined) {
        window.clearInterval(pollingTimer);
        pollingTimer = undefined;
      }
    } catch (error) {
      list.replaceChildren(node(
        'p',
        'rounded-control border border-error-container bg-error-container p-4 font-body-sm text-body-sm text-on-error-container',
        error instanceof Error ? error.message : 'Release history could not be loaded.',
      ));
      list.setAttribute('aria-busy', 'false');
    }
  }

  async function getCsrfToken(): Promise<string> {
    const response = await fetch('/admin/session-csrf', {
      credentials: 'same-origin',
      cache: 'no-store',
      headers: { Accept: 'application/json' },
    });
    const payload: unknown = await response.json();
    if (!response.ok || !payload || typeof payload !== 'object' ||
        !('csrfToken' in payload) || typeof payload.csrfToken !== 'string') {
      throw new Error('Your secure session could not be verified. Sign in again and retry.');
    }
    return payload.csrfToken;
  }

  function openConfirm(action: { action: 'publish' } | { action: 'rollback'; releaseId: string }): void {
    if (!dialog || !confirmDescription || !confirmButton || !confirmTitle) return;
    pendingAction = action;
    if (confirmError) {
      confirmError.textContent = '';
      confirmError.classList.add('hidden');
    }
    const isRollback = action.action === 'rollback';
    confirmTitle.textContent = isRollback ? 'Confirm rollback' : 'Confirm publish';
    confirmDescription.textContent = isRollback
      ? 'A new release will be built from this previously published snapshot. The current site remains live unless Hosting confirms the restore.'
      : 'This publishes all saved services, projects, page copy, business details, SEO metadata, and referenced media as one immutable snapshot.';
    const label = confirmButton.querySelector<HTMLElement>('[data-confirm-label]');
    if (label) label.textContent = isRollback ? 'Confirm rollback' : 'Confirm publish';
    confirmButton.querySelector('span')?.replaceChildren(
      document.createTextNode(isRollback ? 'history' : 'rocket_launch'),
    );
    if (confirmSnapshot && confirmRelease) {
      confirmSnapshot.hidden = !isRollback;
      confirmRelease.textContent = isRollback ? action.releaseId : '';
    }
    dialog.showModal();
  }

  document.querySelectorAll<HTMLElement>('[data-publish-open]').forEach((button) => {
    button.addEventListener('click', () => openConfirm({ action: 'publish' }));
  });
  document.querySelectorAll<HTMLElement>('[data-confirm-close]').forEach((button) => {
    button.addEventListener('click', () => dialog?.close());
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  root?.querySelector('[data-refresh]')?.addEventListener('click', () => void loadHistory());

  confirmButton?.addEventListener('click', async () => {
    if (!pendingAction || !confirmButton || !feedback) return;
    confirmButton.disabled = true;
    feedback.textContent = 'Submitting the release request…';
    if (confirmError) {
      confirmError.textContent = '';
      confirmError.classList.add('hidden');
    }
    try {
      const csrfToken = await getCsrfToken();
      const response = await fetch('/admin/api/publishing', {
        method: 'POST',
        credentials: 'same-origin',
        cache: 'no-store',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
        },
        body: JSON.stringify({
          ...pendingAction,
          requestId: crypto.randomUUID(),
        }),
      });
      const payload: unknown = await response.json();
      if (!response.ok) {
        let message = 'The publishing request was not accepted.';
        if (payload && typeof payload === 'object') {
          if ('detail' in payload && typeof payload.detail === 'string') message = payload.detail;
          else if ('issues' in payload && Array.isArray(payload.issues)) {
            message = payload.issues.filter((issue): issue is string => typeof issue === 'string').join(' ');
          }
        }
        throw new Error(message);
      }
      dialog?.close();
      feedback.textContent = 'Request accepted. Waiting for the pipeline to report a verified result.';
      await loadHistory();
    } catch (error) {
      const message = error instanceof Error ? error.message : 'The publishing request failed.';
      if (confirmError) {
        confirmError.textContent = message;
        confirmError.classList.remove('hidden');
      }
      feedback.textContent = message;
    } finally {
      confirmButton.disabled = false;
    }
  });

  void loadHistory();
</script>
