---
/**
 * Admin — Site content editors (Phase 11, Step A11.7).
 *
 * Frontend sections for Home, About Us, Contact, Business Details, and SEO
 * metadata, using the Phase 10 editable-content inventory and the shared
 * field/validation/status/preview patterns from the service and project
 * editors.
 *
 * This editor writes only validated drafts through the Admin SSR API. Draft
 * changes do not affect the public static build.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import FormSection from '../../../components/admin/FormSection.astro';
import AdminField from '../../../components/admin/AdminField.astro';
import TagInput from '../../../components/admin/TagInput.astro';
import AssetThumb from '../../../components/admin/AssetThumb.astro';
import { listMediaDrafts, type MediaListItem } from '../../../lib/mediaRepository';
import EditorActionBar from '../../../components/admin/EditorActionBar.astro';
import { CONTENT_SCHEMA_VERSION, type PageDraft, type PageSectionDraft, type SeoDraft } from '../../../lib/contentModel';
import { getDraftFirestore } from '../../../lib/firebaseAdmin';
import {
  DraftNotFoundError,
  getBusinessDetailsDraft,
  getPageDraft,
  getSeoDraft,
} from '../../../lib/draftRepository';

const focusRing =
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';

const sections = [
  { id: 'home', label: 'Home' },
  { id: 'about', label: 'About Us' },
  { id: 'contact', label: 'Contact' },
  { id: 'business', label: 'Business Details' },
  { id: 'seo', label: 'SEO' },
];

const seoRoutes = [
  { key: 'home', path: '/', label: 'Home' },
  { key: 'services', path: '/services', label: 'Services' },
  { key: 'projects', path: '/projects', label: 'Projects' },
  { key: 'about', path: '/about-us', label: 'About Us' },
  { key: 'contact', path: '/contact', label: 'Contact' },
];

const now = new Date().toISOString();
let loadError = '';
const blankPage = (pageId: PageDraft['pageId']): PageDraft => ({
  schemaVersion: CONTENT_SCHEMA_VERSION,
  pageId,
  sections: {},
  updatedAt: now,
});
const blankBusiness = {
  schemaVersion: CONTENT_SCHEMA_VERSION,
  address: '',
  phone: '',
  email: '',
  hours: '',
  whatsapp: '',
  updatedAt: now,
};
const blankSeo: SeoDraft = {
  schemaVersion: CONTENT_SCHEMA_VERSION,
  routes: {},
  updatedAt: now,
};
let homePage = blankPage('home');
let aboutPage = blankPage('about');
let contactPage = blankPage('contact');
let business = blankBusiness;
let seo = blankSeo;
let mediaLoadError = '';
let mediaAssets: MediaListItem[] = [];
const expected = { home: 'null', about: 'null', contact: 'null', business: 'null', seo: 'null' };

try {
  const firestore = getDraftFirestore();
  const actor = Astro.locals.authUser;
  const readIfPresent = async <T,>(read: () => Promise<T>): Promise<T | undefined> => {
    try {
      return await read();
    } catch (error) {
      if (error instanceof DraftNotFoundError) return undefined;
      throw error;
    }
  };
  const [savedHome, savedAbout, savedContact, savedBusiness, savedSeo] = await Promise.all([
    readIfPresent(() => getPageDraft(firestore, actor, 'home')),
    readIfPresent(() => getPageDraft(firestore, actor, 'about')),
    readIfPresent(() => getPageDraft(firestore, actor, 'contact')),
    readIfPresent(() => getBusinessDetailsDraft(firestore, actor)),
    readIfPresent(() => getSeoDraft(firestore, actor)),
  ]);
  if (savedHome) { homePage = savedHome; expected.home = savedHome.updatedAt; }
  if (savedAbout) { aboutPage = savedAbout; expected.about = savedAbout.updatedAt; }
  if (savedContact) { contactPage = savedContact; expected.contact = savedContact.updatedAt; }
  if (savedBusiness) { business = savedBusiness; expected.business = savedBusiness.updatedAt; }
  if (savedSeo) { seo = savedSeo; expected.seo = savedSeo.updatedAt; }
} catch (error) {
  loadError = error instanceof Error ? error.message : 'Draft storage is unavailable.';
  console.error('Site content drafts could not be loaded.', error);
}

try {
  mediaAssets = await listMediaDrafts(getDraftFirestore(), Astro.locals.authUser);
} catch (error) {
  mediaLoadError = 'The media library is unavailable. Site-content drafts can still be saved.';
  console.error('Media assets could not be loaded in the site-content editor.', error);
}

const section = (page: PageDraft, key: string): PageSectionDraft => page.sections[key] ?? {};
const homeHero = section(homePage, 'hero');
const homeTrust = section(homePage, 'trustStrip');
const aboutHero = section(aboutPage, 'hero');
const aboutHeritage = section(aboutPage, 'heritage');
const aboutVisionMission = section(aboutPage, 'visionMission');
const aboutIndustries = section(aboutPage, 'industries');
const aboutPillars = section(aboutPage, 'pillars');
const aboutMethodology = section(aboutPage, 'methodology');
const aboutCta = section(aboutPage, 'cta');
const contactDesks = section(contactPage, 'operationalDesks');
const contactQuotation = section(contactPage, 'quotation');
const contactVisitors = section(contactPage, 'visitorInformation');
---

<AdminLayout title="Site Content" pageLabel="Site Content">
  <div class="space-y-6 pb-4" data-editor-root>
    <AdminPageHeader
      title="Site Content"
      description="Home, About Us, Contact, Business Details, and SEO metadata."
    >
      <Fragment slot="actions">
        <StatusChip status="draft" label="Working copy" />
      </Fragment>
    </AdminPageHeader>

    <AdminNotice tone={loadError ? 'error' : 'info'} title={loadError ? 'Couldn’t load content drafts' : 'Drafts only'}>
      {loadError || 'Values load from the local Firestore emulator. Saving updates unpublished drafts only; it never changes the public site.'}
    </AdminNotice>

    <!-- Section sub-navigation -->
    <nav
      aria-label="Site content sections"
      class="sticky top-16 z-10 overflow-x-auto rounded-control border border-outline-variant bg-surface-container-lowest p-1 shadow-card"
    >
      <ul class="flex gap-1">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class={`inline-flex h-9 items-center whitespace-nowrap rounded-control px-3 font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface ${focusRing}`}
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <form
      novalidate
      data-editor-form
      data-draft-kind="siteContent"
      data-expected-updated-at="null"
      data-expected-home={expected.home}
      data-expected-about={expected.about}
      data-expected-contact={expected.contact}
      data-expected-business={expected.business}
      data-expected-seo={expected.seo}
      hidden={Boolean(loadError)}
      class="space-y-6"
    >
      <input type="hidden" name="business-schema-version" value={CONTENT_SCHEMA_VERSION} />
      <!-- Home -->
      <div id="home" class="scroll-mt-36">
        <FormSection title="Home page" description="Content for the public landing route.">
          <AdminField
            name="home-heroHeading"
            label="Hero heading"
            maxlength={90}
            counter
            value={homeHero.heading ?? ''}
            helper="The primary statement at the top of the home page."
          />
          <AdminField
            name="home-heroIntro"
            type="textarea"
            label="Hero introduction"
            rows={3}
            maxlength={240}
            counter
            value={homeHero.intro ?? ''}
            helper="One or two sentences of supporting copy under the heading."
          />
          <AdminField
            name="home-heroCta"
            label="Primary CTA label"
            maxlength={30}
            counter
            value={homeHero.ctaLabel ?? ''}
            helper="Destination is code-controlled (/contact) and cannot be edited here."
          />
          <TagInput
            name="home-trustStrip"
            label="Trust-strip items"
            values={homeTrust.items ?? []}
            placeholder="Add a trust-strip item"
            helper="Short supporting labels shown beneath the hero."
          />
          <AdminNotice tone="warning" title="Claims need owner verification">
            Safety, certification, response-time, performance, and client or project claims must be
            confirmed by the business before publishing. Do not enter unverified claims.
          </AdminNotice>
        </FormSection>
      </div>

      <!-- About Us -->
      <div id="about" class="scroll-mt-36">
        <FormSection title="About Us" description="Content for the public About route.">
          <AdminField
            name="about-intro"
            type="textarea"
            label="Introduction"
            rows={3}
            value={aboutHero.intro ?? ''}
          />
          <AdminField
            name="about-story"
            type="textarea"
            label="Company story / heritage"
            rows={6}
            value={aboutHeritage.body ?? ''}
            helper="Factual history and expertise require verification before publishing."
          />
          <div class="grid gap-5 sm:grid-cols-2">
            <AdminField name="about-vision" type="textarea" label="Vision" rows={4} value={aboutVisionMission.heading ?? ''} />
            <AdminField name="about-mission" type="textarea" label="Mission" rows={4} value={aboutVisionMission.body ?? ''} />
          </div>
          <TagInput
            name="about-industries"
            label="Industries served"
            values={aboutIndustries.items ?? []}
            placeholder="Add an industry"
          />
          <TagInput
            name="about-pillars"
            label="Core pillars"
            values={aboutPillars.items ?? []}
            placeholder="Add a pillar"
          />
          <AdminField
            name="about-process"
            type="textarea"
            label="Process / methodology"
            rows={5}
            value={aboutMethodology.body ?? ''}
          />
          <AdminField name="about-cta" label="CTA copy" maxlength={80} counter value={aboutCta.body ?? ''} />
          <AdminNotice tone="warning" title="Claims need owner verification">
            All factual history, expertise, safety, compliance, and quality assertions require owner
            verification. Section anchors remain code-controlled.
          </AdminNotice>
        </FormSection>
      </div>

      <!-- Contact -->
      <div id="contact" class="scroll-mt-36">
        <FormSection title="Contact page" description="Copy and locations for the public Contact route.">
          <AdminField
            name="contact-deskLabel"
            label="Operational desk label"
            maxlength={60}
            counter
            value={contactDesks.label ?? ''}
          />
          <AdminField
            name="contact-deskDetails"
            type="textarea"
            label="Operational desk details"
            rows={3}
            value={contactDesks.body ?? ''}
          />
          <AdminField
            name="contact-support"
            type="textarea"
            label="Support copy"
            rows={3}
            value={contactQuotation.body ?? ''}
          />
          <AdminField
            name="contact-visitor"
            type="textarea"
            label="Visitor information"
            rows={3}
            value={contactVisitors.body ?? ''}
          />
          <AdminNotice tone="info" title="Contact details are shared">
            Address, phone, email, and hours come from <a class={`font-label-md text-label-md text-primary hover:underline ${focusRing}`} href="#business">Business Details</a
            >. Contact actions only become links after verified values are supplied. Form field
            semantics and submission behavior are code-controlled and are not edited here.
          </AdminNotice>
        </FormSection>
      </div>

      <!-- Business Details -->
      <div id="business" class="scroll-mt-36">
        <FormSection
          title="Business Details"
          description="Shared contact details shown in the footer on every route."
        >
          <AdminField
            name="business-address"
            label="Address"
            value={business.address}
          />
          <div class="grid gap-5 sm:grid-cols-2">
            <AdminField
              name="business-phone"
              label="Phone"
              value={business.phone}
              helper="Shown as a tap-to-call link on public surfaces."
            />
            <AdminField
              name="business-email"
              label="Email"
              type="email"
              value={business.email}
              helper="Shown as a mail link on public surfaces."
            />
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <AdminField
              name="business-hours"
              label="Business hours"
              value={business.hours}
              placeholder="e.g. Mon – Fri, 8:00 – 17:30"
            />
            <AdminField
              name="business-whatsapp"
              label="WhatsApp number"
              optional
              value={business.whatsapp}
              placeholder="94771234567"
              helper="Draft value only. The public static link currently uses PUBLIC_WHATSAPP_NUMBER at build time; these values will connect through the publishing pipeline later."
            />
          </div>
          <AdminNotice tone="warning" title="Confirm every value with the business">
            Default placeholder values must never become active contact links. Verify each detail
            before it is published.
          </AdminNotice>
        </FormSection>
      </div>

      <!-- SEO -->
      <div id="seo" class="scroll-mt-36">
        <FormSection
          title="SEO metadata"
          description="Per-route title, description, and optional social preview image."
        >
          {mediaLoadError && <AdminNotice tone="error" title="Media selection unavailable">{mediaLoadError}</AdminNotice>}

          {
            seoRoutes.map((route) => (
              <div class="space-y-5 rounded-control border border-outline-variant bg-surface-container-low p-4">
                <p class="font-label-md text-label-md text-on-surface">
                  {route.label} <span class="font-mono text-body-sm text-body-sm text-secondary">{route.path}</span>
                </p>
                <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_144px] sm:items-start">
                  <div class="space-y-2">
                    <label for={`seo-share-image-${route.key}`} class="font-label-sm text-label-sm font-semibold text-on-surface">
                      Social preview image
                    </label>
                    <select
                      id={`seo-share-image-${route.key}`}
                      name={`seo-share-image-${route.key}`}
                      data-media-select
                      disabled={Boolean(mediaLoadError)}
                      class={`block h-12 w-full rounded-control border-[1.5px] border-outline-variant bg-surface-container-lowest px-3 font-body-md text-body-md text-on-surface ${focusRing}`}
                    >
                      <option
                        value=""
                        selected={!seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef}
                      >
                        No share image
                      </option>
                      {seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef &&
                        !mediaAssets.some((asset) => asset.id === seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef) && (
                          <option
                            value={seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef ?? ''}
                            selected
                          >
                            Assigned media is unavailable
                          </option>
                        )}
                      {mediaAssets
                        .filter((asset) =>
                          !asset.archived ||
                          asset.id === seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef
                        )
                        .map((asset) => (
                          <option
                            value={asset.id}
                            selected={asset.id === seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef}
                            data-media-url={`/admin/api/media?id=${encodeURIComponent(asset.id)}&image=1`}
                            data-media-alt={asset.alt}
                          >
                            {asset.filename}{asset.archived ? ' (archived — existing assignment)' : ''}
                          </option>
                        ))}
                    </select>
                    <p data-media-preview-status role="status" class="font-body-sm text-body-sm text-secondary">
                      {seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef
                        ? 'Loading protected image preview…'
                        : 'Optional. No image assigned.'}
                    </p>
                  </div>
                  <div class="overflow-hidden rounded-control border border-outline-variant bg-surface-container-low">
                    <img
                      data-media-preview
                      src={seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef
                        ? `/admin/api/media?id=${encodeURIComponent(seo.routes[route.key as keyof typeof seo.routes]!.shareImageRef!)}&image=1`
                        : undefined}
                      alt=""
                      aria-hidden="true"
                      class={`aspect-[4/3] w-full object-contain ${seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef ? '' : 'hidden'}`}
                    />
                    <div
                      data-media-fallback
                      class={`flex aspect-[4/3] items-center justify-center ${seo.routes[route.key as keyof typeof seo.routes]?.shareImageRef ? 'hidden' : ''}`}
                    >
                      <AssetThumb variant="missing" class="w-14" />
                    </div>
                  </div>
                </div>
                <AdminField
                  name={`seo-title-${route.key}`}
                  label="SEO title"
                  optional
                  maxlength={60}
                  counter
                  value={seo.routes[route.key as keyof typeof seo.routes]?.title ?? ''}
                  placeholder={`Leave blank to use the ${route.label} page heading`}
                />
                <AdminField
                  name={`seo-description-${route.key}`}
                  type="textarea"
                  label="Meta description"
                  optional
                  rows={2}
                  maxlength={160}
                  counter
                  value={seo.routes[route.key as keyof typeof seo.routes]?.description ?? ''}
                  placeholder="Summarise the page for search results"
                />
              </div>
            ))
          }

          <AdminNotice tone="warning" title="Do not invent metadata">
            Metadata and social profiles must reflect real content. No metadata value or social
            profile should be invented to fill these fields.
          </AdminNotice>
        </FormSection>
      </div>

      <div
        data-editor-message
        role="alert"
        aria-live="assertive"
        class="hidden rounded-control border border-outline-variant bg-surface-container p-4 font-body-sm text-body-sm text-on-surface"
      >
      </div>

      <EditorActionBar savedNote="Saving stores drafts only; publishing is a separate, unavailable step." />
    </form>

    <p class="font-body-sm text-body-sm text-secondary">
      Saving writes structured drafts to the local Firestore emulator. No draft fields are included
      in the public static output until the separate publishing phase.
    </p>
  </div>
</AdminLayout>

<script>
  import '../../../lib/adminEditor';
</script>
