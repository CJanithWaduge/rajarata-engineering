---
/**
 * Admin — Service editor (Phase 11, Step A11.6).
 *
 * Draft editing is emulator-only. Saving changes the working copy and never
 * updates the statically generated public pages.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import FormSection from '../../../components/admin/FormSection.astro';
import AdminField from '../../../components/admin/AdminField.astro';
import TagInput from '../../../components/admin/TagInput.astro';
import AssetThumb from '../../../components/admin/AssetThumb.astro';
import EditorActionBar from '../../../components/admin/EditorActionBar.astro';
import { CONTENT_SCHEMA_VERSION, type ServiceDraft } from '../../../lib/contentModel';
import { getDraftFirestore } from '../../../lib/firebaseAdmin';
import { getServiceDraft } from '../../../lib/draftRepository';

const focusRing =
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';

const categories = [
  'LV Distribution',
  'Industrial Grade',
  'Switchgear & Enclosures',
  'Containment & Pulling',
  'Statutory Compliance',
  'Operations & SLA',
  'ELV & Automation',
  'Surge & Transient Defense',
];

const id = Astro.url.searchParams.get('id');
const now = new Date().toISOString();
let loadError = '';
let record: ServiceDraft = {
  schemaVersion: CONTENT_SCHEMA_VERSION,
  id: '',
  order: 0,
  category: '',
  title: '',
  summary: '',
  body: '',
  scope: '',
  suitability: [],
  imageRef: null,
  archived: false,
  updatedAt: now,
};

if (id) {
  try {
    record = await getServiceDraft(getDraftFirestore(), Astro.locals.authUser, id);
  } catch (error) {
    loadError = error instanceof Error ? error.message : 'The service draft could not be loaded.';
    console.error('Service draft could not be loaded.', error);
  }
}
---

<AdminLayout title="Edit service" pageLabel="Edit service">
  <div class="space-y-6 pb-4" data-editor-root>
    <AdminPageHeader title={id ? 'Edit service draft' : 'Create service draft'} description="Update the unpublished working copy.">
      <Fragment slot="actions">
        <StatusChip status="draft" />
        <a
          href="/admin/services"
          class={`inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`}
        >
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_back</span>
          Back to services
        </a>
      </Fragment>
    </AdminPageHeader>

    {loadError && <AdminNotice tone="error" title="Couldn’t load service draft">{loadError}</AdminNotice>}

    <form
      novalidate
      data-editor-form
      data-draft-kind="services"
      data-expected-updated-at={id ? record.updatedAt : 'null'}
      data-draft-available={!loadError}
      hidden={Boolean(loadError)}
      class="space-y-6"
    >
      <input type="hidden" name="imageRef" value={record.imageRef ?? ''} />
      <input type="hidden" name="archived" value={String(record.archived)} />
      <FormSection
        title="Identity"
        description="How the service is named and addressed. The identifier is stable and anchors the public link."
      >
        <AdminField
          name="title"
          label="Service name"
          value={record.title}
          helper="Shown as the card and page heading."
        />
        <AdminField
          name="id"
          label="Stable identifier"
          value={record.id}
          required
          requiredMessage="Enter a stable lowercase identifier."
          readonly={Boolean(id)}
          mono
          helper="Read-only: it anchors the public URL and cannot be edited after creation."
        />
      </FormSection>

      <FormSection title="Summary and description" description="Short and long copy for the service.">
        <AdminField
          name="summary"
          type="textarea"
          label="Short card summary"
          rows={3}
          maxlength={180}
          counter
          value={record.summary}
          helper="Used on the directory card. Keep it to a single sentence."
        />
        <AdminField
          name="description"
          type="textarea"
          label="Detailed description"
          rows={8}
          value={record.body}
          helper="Plain text only. Formatted text is not enabled and arbitrary HTML, scripts, or embeds are not accepted."
        />
      </FormSection>

      <FormSection title="Classification and scope" description="Category, scope of work, and audience.">
        <AdminField
          name="category"
          type="select"
          label="Category"
          value={record.category}
          options={categories.map((c) => ({ value: c, label: c }))}
          helper="Determines the icon and grouping on the public site."
        />

        <AdminField
          name="scope"
          type="textarea"
          label="Scope of work"
          rows={5}
          value={record.scope}
          helper="Comma-separated systems and deliverables covered by this service."
        />

        <TagInput
          name="suitableFor"
          label="Suitable for"
          values={record.suitability}
          placeholder="e.g. Manufacturing plants"
          helper="One audience or building type per entry."
        />

        <AdminField
          name="order"
          type="number"
          label="Display order"
          value={record.order}
          helper="Lower numbers appear first in the directory."
        />
      </FormSection>

      <FormSection title="Image" description="Asset selection is handled in the media-management phase.">
        <div class="flex flex-wrap items-center gap-4">
          <AssetThumb variant="missing" class="w-24" />
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                disabled
                title="Image selection is not part of Phase 14."
                class={`inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface-variant opacity-60 ${focusRing}`}
              >
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">perm_media</span>
                Choose image
              </button>
              <a
                href="/admin/media"
                class={`inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`}
              >
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">folder_open</span>
                Open media library
              </a>
            </div>
            <p class="font-body-sm text-body-sm text-secondary">
              {record.imageRef ? `Assigned media reference: ${record.imageRef}` : 'No media is assigned.'}
              Draft media selection remains outside Phase 14.
            </p>
          </div>
        </div>
      </FormSection>

      <div
        data-editor-message
        role="alert"
        aria-live="assertive"
        class="hidden rounded-control border border-outline-variant bg-surface-container p-4 font-body-sm text-body-sm text-on-surface"
      >
      </div>

      <EditorActionBar />
    </form>

    <p class="font-body-sm text-body-sm text-secondary">
      Saving writes the validated working copy to the local Firestore emulator. It does not publish
      content or modify the public build.
    </p>
  </div>
</AdminLayout>

<script>
  import '../../../lib/adminEditor';
</script>
