---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import type { ServiceDraft } from '../../../lib/contentModel';
import { getDraftFirestore } from '../../../lib/firebaseAdmin';
import { listServiceDrafts } from '../../../lib/draftRepository';

let services: ServiceDraft[] = [];
let loadError = '';
try {
  services = await listServiceDrafts(getDraftFirestore(), Astro.locals.authUser);
} catch (error) {
  loadError = error instanceof Error ? error.message : 'Draft storage is unavailable.';
  console.error('Service drafts could not be listed.', error);
}
const categories = [...new Set(services.map(({ category }) => category).filter(Boolean))].sort();
const dateLabel = (value: string) => new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(new Date(value));
const focus = 'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';
---

<AdminLayout title="Services" pageLabel="Services">
  <div class="space-y-6" data-draft-list>
    <AdminPageHeader title="Services" description="Manage unpublished service drafts. Saving does not change the public site.">
      <Fragment slot="actions">
        <a href="/admin/services/edit" class={`inline-flex h-10 items-center gap-2 rounded-control bg-primary-container px-5 font-label-md text-label-md text-on-primary ${focus}`}>
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">add</span>
          Add service
        </a>
      </Fragment>
    </AdminPageHeader>

    <AdminNotice tone="info" title="Drafts only">
      These records are stored in the local Firestore emulator. Publishing is not available, and
      draft changes do not affect public pages.
    </AdminNotice>

    {loadError ? (
      <AdminNotice tone="error" title="Couldn’t load service drafts">{loadError}</AdminNotice>
    ) : services.length === 0 ? (
      <section class="rounded-card border border-outline-variant bg-surface-container-lowest p-6 shadow-card">
        <EmptyState icon="electrical_services" title="No service drafts yet">
          Create a draft when you have verified content to enter.
        </EmptyState>
      </section>
    ) : (
      <section class="overflow-hidden rounded-card border border-outline-variant bg-surface-container-lowest shadow-card">
        <div class="grid gap-3 border-b border-outline-variant bg-surface-container-low p-4 sm:grid-cols-3">
          <label class="space-y-1.5 font-label-sm text-label-sm font-semibold text-on-surface">
            Search
            <input id="service-search" type="search" class="h-11 w-full rounded-control border border-outline-variant bg-surface-container-lowest px-3 font-body-md text-body-md" placeholder="Name or identifier" />
          </label>
          <label class="space-y-1.5 font-label-sm text-label-sm font-semibold text-on-surface">
            Category
            <select id="service-category" class="h-11 w-full rounded-control border border-outline-variant bg-surface-container-lowest px-3 font-body-md text-body-md">
              <option value="all">All categories</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>
          <p class="self-end pb-2 font-body-sm text-body-sm text-secondary" aria-live="polite">
            <span id="service-count">{services.length}</span> draft{services.length === 1 ? '' : 's'}
          </p>
        </div>
        <div class="divide-y divide-outline-variant">
          {services.map((service) => (
            <article
              data-draft-record
              data-id={service.id}
              data-name={service.title.toLocaleLowerCase()}
              data-category={service.category}
              data-updated-at={service.updatedAt}
              class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="font-title-md text-title-md text-on-surface">{service.title || 'Untitled draft'}</h2>
                  <StatusChip status={service.archived ? 'archived' : 'draft'} />
                </div>
                <p class="mt-1 font-mono text-body-sm text-body-sm text-secondary">{service.id}</p>
                <p class="mt-1 font-body-sm text-body-sm text-secondary">
                  {service.category || 'Uncategorized'} · Updated {dateLabel(service.updatedAt)}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <a href={`/admin/services/edit?id=${encodeURIComponent(service.id)}`} class={`inline-flex h-10 items-center rounded-control border border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focus}`}>Edit draft</a>
                <button
                  type="button"
                  data-draft-archive
                  data-kind="services"
                  data-action={service.archived ? 'restore' : 'archive'}
                  data-id={service.id}
                  data-updated-at={service.updatedAt}
                  class={`inline-flex h-10 items-center rounded-control border border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focus}`}
                >{service.archived ? 'Restore' : 'Archive'}</button>
              </div>
            </article>
          ))}
          <p id="service-no-results" hidden class="p-6 text-center font-body-md text-body-md text-secondary">No service drafts match these filters.</p>
        </div>
      </section>
    )}
  </div>
</AdminLayout>

<script>
  import '../../../lib/adminDraftList';
</script>
