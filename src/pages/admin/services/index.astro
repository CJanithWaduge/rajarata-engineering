---
/**
 * Admin — Services list (Phase 11, Step A11.4).
 *
 * A manageable tabular list with search, category/state filters, status
 * labels, row actions, and a responsive stacked-card treatment. Filtering
 * operates on explicitly illustrative local rows only — nothing is loaded
 * from or written to the public site, and no row action claims to save or
 * publish content.
 *
 * Service names and categories mirror the approved public services copy so
 * the console is recognisable; identifiers are shown as read-only technical
 * metadata. Update timestamps are marked as samples.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import RowActions from '../../../components/admin/RowActions.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import Skeleton from '../../../components/admin/Skeleton.astro';

interface ServiceRecord {
  id: string;
  name: string;
  category: string;
  state: 'published' | 'draft' | 'archived';
  updated: string;
}

const services: ServiceRecord[] = [
  { id: 'service-01', name: 'Residential & Commercial Electrical Wiring', category: 'LV Distribution', state: 'published', updated: 'Sample · 12 Oct' },
  { id: 'service-02', name: 'Industrial Electrical Installations', category: 'Industrial Grade', state: 'published', updated: 'Sample · 12 Oct' },
  { id: 'service-03', name: 'MDB / SMDB Panel Installation', category: 'Switchgear & Enclosures', state: 'published', updated: 'Sample · 11 Oct' },
  { id: 'service-04', name: 'Cable Tray Installation & Cable Laying', category: 'Containment & Pulling', state: 'draft', updated: 'Sample · 10 Oct' },
  { id: 'service-05', name: 'Testing & Commissioning', category: 'Statutory Compliance', state: 'published', updated: 'Sample · 09 Oct' },
  { id: 'service-06', name: 'Electrical Maintenance & Troubleshooting', category: 'Operations & SLA', state: 'published', updated: 'Sample · 09 Oct' },
  { id: 'service-07', name: 'All Kinds of ELV Solutions', category: 'ELV & Automation', state: 'draft', updated: 'Sample · 08 Oct' },
  { id: 'service-08', name: 'Lightning Protection System (LPS)', category: 'Surge & Transient Defense', state: 'archived', updated: 'Sample · 02 Oct' },
];

const categories = [...new Set(services.map((s) => s.category))];

/** Edit and preview are functional navigation; publish and archive are not implemented yet. */
const actionsFor = (s: { id: string }) => [
  { label: 'Edit service', icon: 'edit', href: `/admin/services/edit?id=${s.id}` },
  { label: 'Preview draft', icon: 'visibility', href: '/admin/preview?from=%2Fadmin%2Fservices%2Fedit' },
  { label: 'Publish', icon: 'rocket_launch', disabled: true, reason: 'Publishing is not connected.' },
  { label: 'Archive', icon: 'inventory_2', disabled: true, reason: 'Archiving is not connected.', danger: true },
];

const chipStatus: Record<ServiceRecord['state'], 'published' | 'draft' | 'archived'> = {
  published: 'published',
  draft: 'draft',
  archived: 'archived',
};

const views = [
  { key: 'records', label: 'Illustrative records' },
  { key: 'empty', label: 'No records' },
  { key: 'loading', label: 'Loading' },
  { key: 'error', label: 'Couldn’t load' },
];

const focusRing =
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';

const controlCls =
  'h-12 w-full rounded-control border-[1.5px] border-outline-variant bg-surface-container-lowest px-3 font-body-md text-body-md text-on-surface placeholder:text-secondary/60 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';

const thCls =
  'px-4 py-3 text-left font-label-md text-label-md text-secondary whitespace-nowrap';
---

<AdminLayout title="Services" pageLabel="Services">
  <div class="space-y-6" data-services-root>
    <AdminPageHeader
      title="Services"
      description="Manage the electrical service records shown on the public site."
    >
      <Fragment slot="actions">
        <button
          type="button"
          disabled
          title="Adding services is unavailable until content storage is connected."
          class={`inline-flex h-10 items-center gap-2 rounded-control bg-primary-container px-5 font-label-md text-label-md text-on-primary opacity-60 ${focusRing}`}
        >
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">add</span>
          Add service
        </button>
      </Fragment>
    </AdminPageHeader>

    <AdminNotice tone="unavailable" title="Illustrative records — not connected">
      These rows are sample data for reviewing the layout. Nothing here is read from or written to
      the public site. Edit and draft preview open the corresponding screens; publish and archive
      are unavailable.
    </AdminNotice>

    <!-- State preview (frontend only) -->
    <div
      class="flex flex-col gap-3 rounded-control border border-outline-variant bg-surface-container-low px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-wrap items-center gap-2">
        <span id="svc-view-label" class="font-label-sm text-label-sm font-semibold text-secondary">
          State preview
        </span>
        <div role="group" aria-labelledby="svc-view-label" class="flex flex-wrap gap-1.5">
          {
            views.map((v) => (
              <button
                type="button"
                data-svc-view-btn={v.key}
                aria-pressed={v.key === 'records' ? 'true' : 'false'}
                class="inline-flex min-h-10 items-center rounded-chip border border-outline-variant bg-surface-container-lowest px-2.5 py-1 font-label-sm text-label-sm text-on-surface-variant hover:border-outline aria-pressed:border-primary-container aria-pressed:bg-primary-fixed aria-pressed:text-on-primary-fixed focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container sm:min-h-9"
              >
                {v.label}
              </button>
            ))
          }
        </div>
      </div>
      <p class="font-body-sm text-body-sm text-secondary">Local layout preview — nothing is fetched.</p>
    </div>

    <section
      class="rounded-card border border-outline-variant bg-surface-container-lowest shadow-card"
    >
      <!-- Records view -->
      <div data-svc-view="records">
        <!-- Toolbar -->
        <div class="border-b border-outline-variant p-4 sm:p-5">
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div class="space-y-1.5">
              <label for="svc-search" class="font-label-sm text-label-sm font-semibold text-on-surface">
                Search services
              </label>
              <input
                id="svc-search"
                type="search"
                placeholder="Name or identifier"
                autocomplete="off"
                class={controlCls}
              />
            </div>
            <div class="space-y-1.5">
              <label for="svc-category" class="font-label-sm text-label-sm font-semibold text-on-surface">
                Category
              </label>
              <select id="svc-category" class={controlCls}>
                <option value="all">All categories</option>
                {categories.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>
            <div class="space-y-1.5">
              <label for="svc-state" class="font-label-sm text-label-sm font-semibold text-on-surface">
                Publication state
              </label>
              <select id="svc-state" class={controlCls}>
                <option value="all">All states</option>
                <option value="published">Published</option>
                <option value="draft">Draft</option>
                <option value="archived">Archived</option>
              </select>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <p class="font-body-sm text-body-sm text-secondary" aria-live="polite">
              Showing <span id="svc-count" class="font-label-md text-label-md text-on-surface">{services.length}</span>
              of <span class="font-label-md text-label-md text-on-surface">{services.length}</span> services
            </p>
            <button
              type="button"
              data-svc-clear
              class={`inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`}
            >
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">filter_alt_off</span>
              Clear filters
            </button>
          </div>
        </div>

        <!-- Desktop table -->
        <div class="hidden xl:block">
          <table class="w-full border-collapse">
            <caption class="sr-only">Services, with category, publication state, last updated, and row actions.</caption>
            <thead>
              <tr class="border-b border-outline-variant bg-surface-container-low">
                <th scope="col" class={thCls}>Service</th>
                <th scope="col" class={thCls}>Category</th>
                <th scope="col" class={thCls}>State</th>
                <th scope="col" class={thCls}>Last updated</th>
                <th scope="col" class={`${thCls} text-right`}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {
                services.map((s) => (
                  <tr
                    data-service-row
                    data-id={s.id}
                    data-name={s.name.toLowerCase()}
                    data-category={s.category}
                    data-state={s.state}
                    class="border-b border-outline-variant last:border-b-0 hover:bg-surface-container-low"
                  >
                    <td class="px-4 py-3 align-top">
                      <p class="font-title-md text-title-md text-on-surface">{s.name}</p>
                      <p class="font-mono text-body-sm text-body-sm text-secondary">{s.id}</p>
                    </td>
                    <td class="px-4 py-3 align-top font-body-md text-body-md text-secondary">
                      {s.category}
                    </td>
                    <td class="px-4 py-3 align-top">
                      <StatusChip status={chipStatus[s.state]} />
                    </td>
                    <td class="px-4 py-3 align-top font-body-sm text-body-sm text-secondary whitespace-nowrap">
                      {s.updated}
                    </td>
                    <td class="px-4 py-3 align-top text-right">
                      <RowActions actions={actionsFor(s)} label={`Actions for ${s.name}`} />
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- Mobile stacked cards -->
        <ul class="divide-y divide-outline-variant xl:hidden">
          {
            services.map((s) => (
              <li
                data-service-card
                data-id={s.id}
                data-name={s.name.toLowerCase()}
                data-category={s.category}
                data-state={s.state}
                class="space-y-3 p-4"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-title-md text-title-md text-on-surface">{s.name}</p>
                    <p class="font-mono text-body-sm text-body-sm text-secondary">{s.id}</p>
                  </div>
                  <StatusChip status={chipStatus[s.state]} />
                </div>
                <dl class="grid grid-cols-2 gap-2 font-body-sm text-body-sm">
                  <div>
                    <dt class="text-secondary">Category</dt>
                    <dd class="text-on-surface">{s.category}</dd>
                  </div>
                  <div>
                    <dt class="text-secondary">Last updated</dt>
                    <dd class="text-on-surface">{s.updated}</dd>
                  </div>
                </dl>
                <RowActions actions={actionsFor(s)} label={`Actions for ${s.name}`} />
              </li>
            ))
          }
        </ul>

        <!-- No search results -->
        <div id="svc-noresults" hidden>
          <EmptyState icon="search_off" title="No services match your filters">
            <p>Adjust the search or clear the filters to see all illustrative records.</p>
            <button
              type="button"
              data-svc-clear
              class={`mt-3 inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`}
            >
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">filter_alt_off</span>
              Clear filters
            </button>
          </EmptyState>
        </div>
      </div>

      <!-- Empty view -->
      <div data-svc-view="empty" hidden>
        <EmptyState icon="electrical_services" title="No services yet">
          <p>Services will be listed here once content storage is connected. This state is illustrative.</p>
        </EmptyState>
      </div>

      <!-- Loading view -->
      <div data-svc-view="loading" hidden class="p-5">
        <p class="sr-only" role="status">Loading services…</p>
        <div class="space-y-4">
          {
            Array.from({ length: 5 }).map(() => (
              <div class="flex items-center gap-4">
                <Skeleton class="h-4 w-1/3" />
                <Skeleton class="h-4 w-1/6" />
                <Skeleton class="h-6 w-24 rounded-chip" />
                <Skeleton class="ml-auto h-8 w-28" />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Error view -->
      <div data-svc-view="error" hidden class="p-5">
        <AdminNotice tone="error" title="Couldn’t load services">
          The content service did not respond. This is a visual state preview — no request was made.
        </AdminNotice>
      </div>
    </section>

    <p class="font-body-sm text-body-sm text-secondary">
      Row actions are deliberately unavailable: this phase is frontend only and no content is
      persisted or published.
    </p>
  </div>
</AdminLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-services-root]');

  if (root) {
    const search = root.querySelector<HTMLInputElement>('#svc-search');
    const category = root.querySelector<HTMLSelectElement>('#svc-category');
    const state = root.querySelector<HTMLSelectElement>('#svc-state');
    const count = root.querySelector<HTMLElement>('#svc-count');
    const noResults = root.querySelector<HTMLElement>('#svc-noresults');
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-service-row]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-service-card]'));
    const total = rows.length;

    const shows = (el: HTMLElement, q: string, cat: string, st: string) => {
      const name = el.dataset.name ?? '';
      const id = (el.dataset.id ?? '').toLowerCase();
      const matchesQuery = !q || name.includes(q) || id.includes(q);
      const matchesCategory = cat === 'all' || el.dataset.category === cat;
      const matchesState = st === 'all' || el.dataset.state === st;
      return matchesQuery && matchesCategory && matchesState;
    };

    const applyFilters = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      const cat = category?.value ?? 'all';
      const st = state?.value ?? 'all';

      let visible = 0;
      rows.forEach((row) => {
        const show = shows(row, q, cat, st);
        row.hidden = !show;
        if (show) visible += 1;
      });
      const visibleIds = new Set(rows.filter((r) => !r.hidden).map((r) => r.dataset.id));
      cards.forEach((card) => {
        card.hidden = !visibleIds.has(card.dataset.id);
      });

      if (count) count.textContent = String(visible);
      if (noResults) noResults.hidden = !(visible === 0 && total > 0);
    };

    const clearFilters = () => {
      if (search) search.value = '';
      if (category) category.value = 'all';
      if (state) state.value = 'all';
      applyFilters();
    };

    search?.addEventListener('input', applyFilters);
    category?.addEventListener('change', applyFilters);
    state?.addEventListener('change', applyFilters);
    root.querySelectorAll('[data-svc-clear]').forEach((btn) =>
      btn.addEventListener('click', clearFilters)
    );

    // State preview switching (frontend only).
    const viewButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-svc-view-btn]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-view]'));
    viewButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.svcViewBtn;
        viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.svcView !== key;
        });
      });
    });
  }
</script>
