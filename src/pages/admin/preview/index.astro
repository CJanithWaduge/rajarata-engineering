---
/**
 * Authenticated, server-rendered preview of the currently saved CMS drafts.
 * This route and its protected image requests are gated by Admin middleware.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import DraftPreviewCanvas from '../../../components/admin/DraftPreviewCanvas.astro';
import { PAGE_IDS, type PageId } from '../../../lib/contentModel';
import { getDraftFirestore, getDraftStorage } from '../../../lib/firebaseAdmin';
import {
  collectDraftPreviewIssues,
  loadDraftPreview,
  type DraftPreviewSnapshot,
} from '../../../lib/draftPreview';

const pageParam = Astro.url.searchParams.get('page');
const validPage = PAGE_IDS.includes(pageParam as PageId);
const pageId: PageId = validPage ? pageParam as PageId : 'home';
const selectedIdParam = Astro.url.searchParams.get('id');
const selectedId = selectedIdParam && /^[a-z][a-z0-9-]{0,62}[a-z0-9]$/.test(selectedIdParam)
  ? selectedIdParam
  : null;
const allowedReturnPaths = new Set([
  '/admin/services/edit',
  '/admin/projects/edit',
  '/admin/content',
]);
const fromParam = Astro.url.searchParams.get('from');
const returnPath = fromParam && allowedReturnPaths.has(fromParam) ? fromParam : '/admin/content';
const returnUrl = new URL(returnPath, Astro.url);
if (
  selectedId &&
  (returnPath === '/admin/services/edit' || returnPath === '/admin/projects/edit')
) {
  returnUrl.searchParams.set('id', selectedId);
}
const returnHref = `${returnUrl.pathname}${returnUrl.search}`;

let snapshot: DraftPreviewSnapshot | undefined;
let issues: ReturnType<typeof collectDraftPreviewIssues> = [];
let loadError = '';

if (!validPage && pageParam) {
  Astro.response.status = 400;
  loadError = 'The requested preview page is not supported.';
} else if (!Astro.locals.authUser?.admin) {
  Astro.response.status = 403;
  loadError = 'A verified administrator session is required to load draft content.';
} else {
  try {
    snapshot = await loadDraftPreview(
      getDraftFirestore(),
      getDraftStorage(),
      Astro.locals.authUser,
    );
    issues = collectDraftPreviewIssues(snapshot);
  } catch (error) {
    Astro.response.status = 503;
    loadError = 'The saved draft preview could not be loaded. Check local emulator availability and retry.';
    console.error('Draft preview could not be loaded.', error);
  }
}

const blockingCount = issues.filter(({ blocking }) => blocking).length;
const viewportOptions = [
  { key: 'desktop', label: 'Desktop', width: '1280px', icon: 'desktop_windows' },
  { key: 'tablet', label: 'Tablet', width: '768px', icon: 'tablet_mac' },
  { key: 'mobile', label: 'Mobile', width: '390px', icon: 'smartphone' },
];
const focusRing =
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';
const toggleButton =
  'inline-flex min-h-10 items-center gap-1.5 rounded-control border border-outline-variant bg-surface-container-lowest px-3 font-label-sm text-label-sm text-on-surface-variant hover:border-outline aria-pressed:border-primary-container aria-pressed:bg-primary-fixed aria-pressed:text-on-primary-fixed focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container sm:min-h-9';
---

<AdminLayout title="Draft preview" pageLabel="Draft preview">
  <div class="space-y-6" data-preview-root>
    <AdminPageHeader
      title="Draft preview"
      description="Review the latest saved draft data and media before a release."
    >
      <Fragment slot="actions">
        <StatusChip status={blockingCount > 0 ? 'attention' : 'draft'} label={`${blockingCount} blocking`} />
        <a href={returnHref} class={`inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`}>
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_back</span>
          Return to editor
        </a>
      </Fragment>
    </AdminPageHeader>

    <AdminNotice tone="warning" title="Draft preview — not published">
      This page is rendered on demand from saved draft records. It does not update the public site,
      create a release, or publish content.
    </AdminNotice>

    <div class="sticky top-16 z-20 -mx-4 border-y border-outline-variant bg-surface-container-lowest/95 px-4 py-3 backdrop-blur-md sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <p class="flex items-center gap-2 font-label-md text-label-md text-on-surface">
          <span class="material-symbols-outlined text-[20px] text-primary-container" aria-hidden="true">visibility</span>
          Draft preview — not published
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <span id="preview-viewport-label" class="font-label-sm text-label-sm text-secondary">Viewport</span>
          <div role="group" aria-labelledby="preview-viewport-label" class="flex flex-wrap gap-1.5">
            {viewportOptions.map((option) => (
              <button
                type="button"
                data-preview-viewport-btn={option.key}
                data-preview-viewport-label={option.label}
                data-preview-viewport-width={option.width}
                aria-pressed={option.key === 'desktop' ? 'true' : 'false'}
                class={toggleButton}
              >
                <span class="material-symbols-outlined text-[16px]" aria-hidden="true">{option.icon}</span>
                {option.label}
              </button>
            ))}
          </div>
          <p data-preview-viewport-note aria-live="polite" class="font-label-sm text-label-sm text-secondary">
            Desktop · 1280px
          </p>
        </div>
      </div>
    </div>

    {loadError ? (
      <AdminNotice tone="error" title="Preview unavailable">{loadError}</AdminNotice>
    ) : snapshot ? (
      <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
        <section aria-label="Saved draft preview" class="min-w-0 overflow-hidden rounded-card border border-outline-variant bg-surface-container-lowest shadow-card">
          <div
            data-preview-frame
            data-viewport="desktop"
            class="mx-auto w-full data-[viewport=desktop]:max-w-[1280px] data-[viewport=tablet]:max-w-[768px] data-[viewport=mobile]:max-w-[390px]"
          >
            <DraftPreviewCanvas
              pageId={pageId}
              selectedId={selectedId}
              from={returnPath}
              snapshot={snapshot}
            />
          </div>
        </section>

        <aside class="space-y-4 xl:sticky xl:top-32 xl:self-start">
          <section class="rounded-card border border-outline-variant bg-surface-container-lowest shadow-card">
            <header class="flex items-center justify-between gap-3 border-b border-outline-variant px-5 py-4">
              <h2 class="font-title-lg text-title-lg text-on-surface">Validation</h2>
              <StatusChip status={blockingCount > 0 ? 'attention' : 'info'} label={`${blockingCount} blocking`} />
            </header>
            <div class="space-y-4 p-5">
              {issues.length > 0 ? (
                <ul class="space-y-3">
                  {issues.map((issue) => (
                    <li class:list={[
                      'space-y-1 border-l-2 pl-3',
                      issue.blocking ? 'border-primary-container' : 'border-outline-variant',
                    ]}>
                      <p class="flex items-center gap-2 font-label-md text-label-md text-on-surface">
                        <span class:list={[
                          'material-symbols-outlined text-[16px]',
                          issue.blocking ? 'text-primary-container' : 'text-secondary',
                        ]} aria-hidden="true">{issue.blocking ? 'error' : 'info'}</span>
                        {issue.blocking ? 'Blocking' : 'Suggestion'} · {issue.scope}
                      </p>
                      <p class="font-body-sm text-body-sm text-secondary">{issue.message}</p>
                      <a href={issue.href} class={`inline-flex font-label-sm text-label-sm text-primary hover:underline ${focusRing}`}>
                        Go to field
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="font-body-sm text-body-sm text-secondary">
                  No blocking content or media issues were detected in the saved drafts.
                </p>
              )}
              <p class="border-t border-outline-variant pt-3 font-body-sm text-body-sm text-secondary">
                Diagnostics are based on saved draft data. Unsaved editor changes are not included.
              </p>
            </div>
          </section>

          <section class="rounded-card border border-outline-variant bg-surface-container-lowest shadow-card">
            <div class="space-y-3 p-5">
              <h2 class="font-title-lg text-title-lg text-on-surface">Publish</h2>
              <p class="font-body-sm text-body-sm text-secondary">
                Previewing is available; publishing remains disabled until the separate release pipeline is implemented.
              </p>
              <button type="button" disabled class={`inline-flex h-10 w-full items-center justify-center gap-2 rounded-control bg-primary-container px-4 font-label-md text-label-md text-on-primary opacity-60 ${focusRing}`}>
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">rocket_launch</span>
                Publish unavailable
              </button>
            </div>
          </section>
        </aside>
      </div>
    ) : null}
  </div>
</AdminLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-preview-root]');
  const frame = root?.querySelector<HTMLElement>('[data-preview-frame]');
  const viewportButtons = Array.from(
    root?.querySelectorAll<HTMLButtonElement>('[data-preview-viewport-btn]') ?? [],
  );
  const viewportNote = root?.querySelector<HTMLElement>('[data-preview-viewport-note]');

  viewportButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.previewViewportBtn ?? 'desktop';
      viewportButtons.forEach((candidate) =>
        candidate.setAttribute('aria-pressed', String(candidate === button)),
      );
      if (frame) frame.dataset.viewport = key;
      if (viewportNote) {
        viewportNote.textContent = `${button.dataset.previewViewportLabel ?? key} · ${button.dataset.previewViewportWidth ?? ''}`;
      }
    });
  });
</script>
