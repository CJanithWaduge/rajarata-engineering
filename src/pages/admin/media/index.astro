---
/**
 * Admin media library. Draft objects are uploaded and served only through the
 * verified Admin SSR session; permanent deletion is not offered.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminNotice from '../../../components/admin/AdminNotice.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import AssetThumb from '../../../components/admin/AssetThumb.astro';
import { MAX_MEDIA_BYTES } from '../../../lib/contentModel';
import { getDraftFirestore } from '../../../lib/firebaseAdmin';
import { listMediaDrafts, type MediaListItem } from '../../../lib/mediaRepository';

const actor = Astro.locals.authUser;
let assets: MediaListItem[] = [];
let loadError = '';

try {
  assets = await listMediaDrafts(getDraftFirestore(), actor);
} catch (error) {
  loadError = 'The local media library could not be loaded. Check that the Firestore and Storage emulators are running.';
  console.error('Media library could not be loaded.', error);
}

const focusRing =
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';
const secondaryButton =
  `inline-flex h-10 items-center gap-2 rounded-control border-[1.5px] border-outline-variant px-4 font-label-md text-label-md text-on-surface hover:bg-surface-container-high ${focusRing}`;
const primaryButton =
  `inline-flex h-10 items-center gap-2 rounded-control bg-primary-container px-4 font-label-md text-label-md text-on-primary hover:bg-primary disabled:cursor-not-allowed disabled:opacity-50 ${focusRing}`;
const sizeLabel = `${(MAX_MEDIA_BYTES / (1024 * 1024)).toFixed(0)} MiB`;
---

<AdminLayout title="Media Library" pageLabel="Media Library">
  <div class="space-y-6 pb-4" data-media-root>
    <AdminPageHeader
      title="Media Library"
      description="Upload and manage private draft images used by service, project, and site-content editors."
    />

    <AdminNotice tone="warning" title="Draft images stay private">
      Uploads are stored under the draft-only Storage path and are visible to administrators only.
      Archiving never deletes an object; replacing an image means uploading a new asset and changing
      its references. The public site changes only through a future release.
    </AdminNotice>

    <section class="rounded-card border border-outline-variant bg-surface-container-lowest shadow-card">
      <header class="border-b border-outline-variant px-5 py-4">
        <h2 class="font-title-lg text-title-lg text-on-surface">Upload an image</h2>
        <p class="mt-1 font-body-sm text-body-sm text-secondary">
          JPEG, PNG, or WebP · maximum {sizeLabel} · alt text required
        </p>
      </header>

      <div class="space-y-5 p-5">
        <div
          data-dropzone
          class="rounded-control border-[1.5px] border-dashed border-outline bg-surface-container-low p-6 text-center data-[drag=true]:border-primary-container data-[drag=true]:bg-primary-fixed/40"
        >
          <span class="material-symbols-outlined text-[32px] text-secondary" aria-hidden="true">upload</span>
          <p class="mt-2 font-title-md text-title-md text-on-surface">Choose an image to upload</p>
          <p class="mx-auto mt-1 max-w-[32rem] font-body-sm text-body-sm text-secondary">
            Drag and drop an image here, or use the button. Files are validated in the browser and
            again by the Admin service before they reach Storage.
          </p>
          <input
            id="media-file"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            hidden
          />
          <button type="button" data-file-trigger class={`mt-4 ${secondaryButton}`}>
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">folder_open</span>
            Choose file
          </button>
        </div>

        <div data-selected hidden class="grid gap-5 lg:grid-cols-[260px_1fr]">
          <div class="space-y-2">
            <div class="overflow-hidden rounded-control border border-outline-variant bg-surface-container-low">
              <img data-selected-img alt="" aria-hidden="true" class="hidden aspect-[4/3] w-full object-contain" />
              <div data-selected-placeholder class="flex aspect-[4/3] w-full items-center justify-center">
                <AssetThumb variant="unavailable" class="w-16" />
              </div>
            </div>
            <p data-selected-meta class="font-body-sm text-body-sm text-secondary"></p>
          </div>

          <div class="space-y-4">
            <div class="flex items-start justify-between gap-3">
              <p data-selected-name class="font-title-md text-title-md break-all text-on-surface"></p>
              <button type="button" data-selected-clear class={`font-label-md text-label-md text-primary hover:underline ${focusRing}`}>
                Clear
              </button>
            </div>

            <div class="space-y-1.5" data-field>
              <label for="media-alt" class="font-label-sm text-label-sm font-semibold text-on-surface">
                Alt text <span class="text-primary-container" aria-hidden="true">*</span>
              </label>
              <textarea
                id="media-alt"
                rows="3"
                maxlength="500"
                required
                aria-describedby="media-alt-helper media-alt-error"
                placeholder="Describe the image’s content and purpose"
                class="w-full rounded-control border-[1.5px] border-outline-variant bg-surface-container-lowest px-3 py-3 font-body-md text-body-md text-on-surface placeholder:text-secondary/60 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
              ></textarea>
              <p id="media-alt-helper" class="font-body-sm text-body-sm text-secondary">
                Describe the image, not its filename. Alt text is never generated from the filename.
              </p>
              <p id="media-alt-error" class="hidden font-body-sm text-body-sm text-primary-container"></p>
            </div>

            <div class="flex flex-wrap gap-2">
              <button type="button" data-upload-submit disabled class={primaryButton}>
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">cloud_upload</span>
                Upload to library
              </button>
              <a href="/admin/media" data-upload-view-link hidden class={secondaryButton}>
                View in library
              </a>
            </div>
            <p data-upload-message role="status" aria-live="polite" class="font-body-sm text-body-sm text-secondary"></p>
            <div data-upload-progress-wrap hidden class="space-y-1">
              <div
                data-upload-progress
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                aria-label="Image upload progress"
                class="h-2 w-full overflow-hidden rounded-chip bg-surface-container-high"
              >
                <div data-upload-progress-bar class="h-full w-0 rounded-chip bg-primary-container"></div>
              </div>
              <div class="flex items-center justify-between gap-3">
                <p data-upload-progress-label class="font-body-sm text-body-sm text-secondary">0%</p>
                <button type="button" data-upload-cancel class={`${secondaryButton} h-9`}>
                  Cancel upload
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-card border border-outline-variant bg-surface-container-lowest shadow-card">
      <header class="flex flex-wrap items-end justify-between gap-3 border-b border-outline-variant px-5 py-4">
        <div>
          <h2 class="font-title-lg text-title-lg text-on-surface">Library assets</h2>
          <p class="mt-1 font-body-sm text-body-sm text-secondary">
            {assets.length} {assets.length === 1 ? 'asset' : 'assets'} · files are retained until a future release-retention process can prove they are unused.
          </p>
        </div>
        <a href="/admin/services" class={secondaryButton}>Service drafts</a>
      </header>

      <div class="space-y-5 p-5">
        <AdminNotice tone="warning" title="Archive is reversible; deletion is disabled">
          Existing draft or retained-release references remain usable when an asset is archived.
          Upload a replacement separately, update references, and keep this object for rollback
          safety. No permanent-delete action is available.
        </AdminNotice>

        {loadError ? (
          <AdminNotice tone="error" title="Couldn’t load media">{loadError}</AdminNotice>
        ) : assets.length === 0 ? (
          <EmptyState icon="perm_media" title="No media yet">
            Upload the first JPEG, PNG, or WebP asset above. It will remain private until a later
            publishing phase.
          </EmptyState>
        ) : (
          <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {assets.map((asset) => (
              <li
                id={`asset-${asset.id}`}
                data-media-card
                data-id={asset.id}
                data-updated-at={asset.updatedAt}
                class="space-y-3 rounded-control border border-outline-variant bg-surface-container-low p-3"
              >
                <div class="overflow-hidden rounded-control border border-outline-variant bg-surface-container-lowest">
                  <img
                    data-asset-image
                    src={`/admin/api/media?id=${encodeURIComponent(asset.id)}&image=1`}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    width={asset.width}
                    height={asset.height}
                    class="aspect-[4/3] w-full object-contain"
                  />
                  <div data-asset-fallback hidden class="flex aspect-[4/3] items-center justify-center">
                    <AssetThumb variant="missing" class="w-16" />
                  </div>
                </div>
                <div class="space-y-1">
                  <p class="font-title-md text-title-md break-all text-on-surface">{asset.filename}</p>
                  <p class="font-body-sm text-body-sm text-secondary">
                    {asset.contentType} · {(asset.bytes / 1024).toFixed(0)} KB · {asset.width} × {asset.height}
                  </p>
                  <p class="font-body-sm text-body-sm text-secondary">
                    Alt: <span data-alt-value>{asset.alt}</span>
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <StatusChip status={asset.archived ? 'archived' : 'draft'} />
                  <span class="font-body-sm text-body-sm text-secondary">
                    {asset.usedBy.length} {asset.usedBy.length === 1 ? 'reference' : 'references'}
                  </span>
                </div>
                {asset.usedBy.length > 0 && (
                  <ul class="space-y-0.5 border-l-2 border-outline-variant pl-3 font-body-sm text-body-sm text-secondary">
                    {asset.usedBy.map((use) => <li>{use}</li>)}
                  </ul>
                )}
                <div class="space-y-2 border-t border-outline-variant pt-3" data-alt-editor>
                  <label for={`alt-${asset.id}`} class="font-label-sm text-label-sm font-semibold text-on-surface">
                    Edit alt text
                  </label>
                  <textarea
                    id={`alt-${asset.id}`}
                    data-alt-input
                    rows="2"
                    maxlength="500"
                    required
                    class="w-full rounded-control border-[1.5px] border-outline-variant bg-surface-container-lowest px-3 py-2 font-body-sm text-body-sm text-on-surface focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
                  >{asset.alt}</textarea>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <button type="button" data-alt-save disabled class={secondaryButton}>Save alt text</button>
                    <button
                      type="button"
                      data-archive-action={asset.archived ? 'restore' : 'archive'}
                      data-references={asset.usedBy.length}
                      class={secondaryButton}
                    >
                      {asset.archived ? 'Restore' : 'Archive'}
                    </button>
                  </div>
                  <p data-card-message role="status" class="font-body-sm text-body-sm text-secondary"></p>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  import '../../../lib/adminMediaLibrary';
</script>
