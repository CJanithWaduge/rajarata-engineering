---
/**
 * About Us page.
 *
 * Route shell with the shared layout. Section components land in
 * src/components/about/ and are rendered here as the Phase 4 steps
 * come in.
 *
 * `pt-20` clears the fixed header — same arrangement as Home and
 * Services, and for the same reason: the header is a sibling of <main>,
 * not its parent.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutHero from '../components/about/AboutHero.astro';
import EngineeringHeritage from '../components/about/EngineeringHeritage.astro';
import VisionMission from '../components/about/VisionMission.astro';
import CorePillars from '../components/about/CorePillars.astro';
import ProjectMethodology from '../components/about/ProjectMethodology.astro';
import IndustriesServed from '../components/about/IndustriesServed.astro';
import AboutCta from '../components/about/AboutCta.astro';

export const prerender = true;
---

<Base
  title="Rajarata Engineering | About Us"
  description="Sample company profile template for an electrical engineering business. History, qualifications, policies, and claims must be verified before publication."
>
  <Header />

  <main class="w-full pt-20 bg-surface">
    <AboutHero />
    <EngineeringHeritage />
    <VisionMission />
    <CorePillars />
    <ProjectMethodology />
    <IndustriesServed />
    <AboutCta />
  </main>

  <Footer />
</Base>