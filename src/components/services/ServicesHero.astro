---
/**
 * Services hero (Step S3.1)
 * Shell: section, responsive container, and background grid motif.
 */
---

<section class="relative w-full overflow-hidden bg-surface-container-lowest pb-16 pt-8 sm:pb-24 sm:pt-12">
  <div class="absolute inset-0 pointer-events-none opacity-40">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern height="40" id="grid-pattern" patternUnits="userSpaceOnUse" width="40">
          <path class="text-surface-variant" d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect fill="url(#grid-pattern)" height="100%" width="100%"></rect>
    </svg>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 font-label-sm text-label-sm text-secondary mb-6 sm:mb-8">
      <a class="hover:text-primary transition-colors flex items-center gap-1.5" href="/">
        <span class="material-symbols-outlined text-[16px]">home</span>
        <span>Home</span>
      </a>
      <span class="text-outline-variant">/</span>
    <!-- Main Headline Cluster -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
      <div class="lg:col-span-8 flex flex-col space-y-4">
        <div class="inline-flex items-center gap-2 self-start px-3 py-1 rounded-md bg-error-container text-on-error-container font-label-caps text-label-caps uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
          Utility Grade &amp; Industrial Capability
        </div>
        <h1 class="font-display-hero text-headline-lg lg:text-display-hero text-on-surface tracking-tight leading-none text-balance">
          Electrical Engineering Solutions for Every Requirement
        </h1>
        <p class="font-body-lg text-body-lg text-secondary max-w-2xl leading-relaxed pt-2">
          [REPLACE: Short company service introduction - Rajarata Engineering provides comprehensive, compliant, and precision-driven electrical contracting services. From megawatt industrial distribution systems to intelligent Extra Low Voltage automation, our certified engineers deliver turnkey reliability across Sri Lanka.]
        </p>
      </div>
      <!-- Quick Filter / Anchor Chips -->
      <div class="lg:col-span-4 flex flex-col justify-end space-y-3">
        <span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary">Quick Service Categories</span>
        <div class="flex flex-wrap gap-2">
          <a class="px-3.5 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm transition-all duration-150 flex items-center gap-2" href="#service-02">
            <span class="material-symbols-outlined text-[16px] text-primary">factory</span>
            Industrial Installations
          </a>
          <a class="px-3.5 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm transition-all duration-150 flex items-center gap-2" href="#service-01">
            <span class="material-symbols-outlined text-[16px] text-primary">apartment</span>
            Commercial Wiring
          </a>
          <a class="px-3.5 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm transition-all duration-150 flex items-center gap-2" href="#service-07">
            <span class="material-symbols-outlined text-[16px] text-tertiary">settings_ethernet</span>
            ELV &amp; Automation
          </a>
        </div>
      </div>
    </div>
