---
/**
 * Services directory (Steps S3.17–S3.28)
 * Section shell, heading row, and responsive card grid.
 */
import ServiceCard from './ServiceCard.astro';
---

<section class="w-full py-16 sm:py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-4">
      <div>
        <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-bold">Engineering Services Directory</span>
        <h2 class="font-headline-lg text-headline-md sm:text-headline-lg text-on-surface tracking-tight mt-1">
          Complete Electrical Lifecycle Capabilities
        </h2>
      </div>
      <p class="font-body-md text-body-md text-secondary max-w-md">
        Standardized according to BS 7671, CEB, and LECO requirements with end-to-end commissioning guarantees.
      </p>
    </div>
    <!-- Services 2-Column Desktop Grid / 1-Column Mobile -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
      <!-- 01 Residential & Commercial Electrical Wiring -->
      <ServiceCard
        id="service-01"
        number="01"
        categoryIcon="apartment"
        categoryLabel="LV Distribution"
        title="Residential & Commercial Electrical Wiring"
        description="[REPLACE: Detailed definition - Full architectural electrical infrastructure planning, rough-in, conduit installation, and final wiring designed for continuous high efficiency, fire resistance, and full compliance with municipal building codes.]"
        scope="[REPLACE: Distribution boards, modular switches, concealed conduit networks, architectural lighting fixtures, dedicated circuit breakers, sub-metering, and load calculation checks.]"
        suitableFor={['Residential complexes', 'Commercial buildings', 'Retail plazas', 'Corporate headquarters']}
      />
      <!-- 02 Industrial Electrical Installations -->
      <ServiceCard
        id="service-02"
        number="02"
        accent="error"
        categoryIcon="precision_manufacturing"
        categoryLabel="Industrial Grade"
        title="Industrial Electrical Installations"
        description="[REPLACE: Industrial plant electrical installation description - Robust electrical engineering engineered for heavy machinery, automated production environments, high-capacity switchgear, and mission-critical power continuity under severe thermal and environmental loads.]"
        scope="[REPLACE: High voltage substations, motor control centers (MCC), variable frequency drives (VFD), heavy industrial trunking, generator synchronization panels, and harmonics filter banks.]"
        suitableFor={['Manufacturing plants', 'Processing facilities', 'Agro-processing factories', 'Logistics hubs']}
      />
      <!-- 03 MDB / SMDB Panel Installation -->
      <ServiceCard
        id="service-03"
        number="03"
        categoryIcon="developer_board"
        categoryLabel="Switchgear & Enclosures"
        title="MDB / SMDB Panel Installation"
        description="[REPLACE: Main and sub-main distribution board fabrication and installation - Customized sheet metal enclosure engineering, modular form-separation assembly, and fault-current calculated assembly guaranteeing fault isolation and safe operation.]"
        scope="[REPLACE: Electrolytic copper busbar systems, air circuit breakers (ACB), molded case circuit breakers (MCCB), surge suppression units, smart digital metering, and dynamic phase balancing.]"
        suitableFor={['High-rise developments', 'Substation buildings', 'Commercial complexes', 'Hospitals']}
      />
    </div>
  </div>
</section>
