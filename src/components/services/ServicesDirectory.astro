---
/**
 * Services directory (Steps S3.17–S3.28)
 * Section shell, heading row, and responsive card grid.
 */
import ServiceCard from './ServiceCard.astro';
---

<section class="w-full py-16 sm:py-24 bg-surface" data-scroll-reveal>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-4">
      <div>
        <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-bold">Engineering Services Directory</span>
        <h2 class="font-headline-lg text-headline-md sm:text-headline-lg text-on-surface tracking-tight mt-1">
          Complete Electrical Lifecycle Capabilities
        </h2>
      </div>
      <p class="font-body-md text-body-md text-secondary max-w-[28rem]">
        The service descriptions below are sample template copy. Confirm actual capabilities, applicable standards, and delivery terms before publication.
      </p>
    </div>
    <!-- Services 2-Column Desktop Grid / 1-Column Mobile -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
      <!-- 01 Residential & Commercial Electrical Wiring -->
      <ServiceCard
        id="service-01"
        number="01"
        categoryIcon="apartment"
        categoryLabel="LV Distribution"
        title="Residential & Commercial Electrical Wiring"
        description="Sample description for residential and commercial electrical wiring. Replace with a verified summary of the actual service before publication."
        scope="Example scope may include circuits, lighting, wiring accessories, and distribution equipment. Confirm actual scope and applicable requirements before use."
        suitableFor={['Residential complexes', 'Commercial buildings', 'Retail plazas', 'Corporate headquarters']}
      />
      <!-- 02 Industrial Electrical Installations -->
      <ServiceCard
        id="service-02"
        number="02"
        accent="error"
        categoryIcon="precision_manufacturing"
        categoryLabel="Industrial Grade"
        title="Industrial Electrical Installations"
        description="Sample description for industrial electrical installation. Replace with a verified summary of available services and project limits."
        scope="Example scope may include plant distribution, control equipment, and cable infrastructure. Verify equipment, voltage range, and qualifications before use."
        suitableFor={['Manufacturing plants', 'Processing facilities', 'Agro-processing factories', 'Logistics hubs']}
      />
      <!-- 03 MDB / SMDB Panel Installation -->
      <ServiceCard
        id="service-03"
        number="03"
        categoryIcon="developer_board"
        categoryLabel="Switchgear & Enclosures"
        title="MDB / SMDB Panel Installation"
        description="Sample description for main and sub-main distribution board work. Confirm design responsibility, ratings, and installation scope before publication."
        scope="Example scope may include enclosures, protective devices, metering, and busbar systems. Verify specifications and standards for each project."
        suitableFor={['High-rise developments', 'Substation buildings', 'Commercial complexes', 'Hospitals']}
      />
      <!-- 04 Cable Tray Installation & Cable Laying -->
      <ServiceCard
        id="service-04"
        number="04"
        accent="surface"
        categoryIcon="linear_scale"
        categoryLabel="Containment & Pulling"
        title="Cable Tray Installation & Cable Laying"
        description="Sample description for cable containment and cable laying. Specify actual installation types and site limitations before publication."
        scope="Example scope may include tray, trunking, cable pulling, and termination work. Confirm materials and design requirements for each project."
        suitableFor={['Utility infrastructure', 'Power distribution rooms', 'Processing facilities', 'Campus networks']}
      />
      <!-- 05 Testing & Commissioning -->
      <ServiceCard
        id="service-05"
        number="05"
        accent="error"
        categoryIcon="fact_check"
        categoryLabel="Statutory Compliance"
        title="Testing & Commissioning"
        description="Sample description for electrical testing and commissioning. Confirm available methods, instruments, qualifications, and reporting scope before use."
        scope="Example scope may include visual inspection and electrical measurements. Do not imply certification or regulatory approval unless verified."
        suitableFor={['New plant commissioning', 'Municipal statutory audits', 'Pre-insurance surveys', 'Facility handovers']}
      />
      <!-- 06 Electrical Maintenance & Troubleshooting -->
      <ServiceCard
        id="service-06"
        number="06"
        accent="surface"
        categoryIcon="build"
        categoryLabel="Operations & SLA"
        title="Electrical Maintenance & Troubleshooting"
        description="Sample description for electrical maintenance. Confirm response hours, service availability, and any exclusions before publication."
        scope="Example scope may include scheduled inspections and fault diagnosis. List only maintenance activities actually offered."
        suitableFor={['Critical healthcare centers', 'Hotel chains', 'Automated factories', 'Commercial properties']}
      />
      <!-- 07 All Kinds of ELV Solutions -->
      <ServiceCard
        id="service-07"
        number="07"
        accent="tertiary"
        categoryIcon="router"
        categoryLabel="ELV & Automation"
        title="All Kinds of ELV Solutions"
        description="Sample description for extra-low-voltage systems. Confirm supported systems, design responsibility, and integration partners before publication."
        scope="Example scope may include communications, access, security, and building-control systems. Verify which products and services are available."
        suitableFor={['Smart office towers', 'Luxury residential villas', 'Hospitality resorts', 'Educational universities']}
      />
      <!-- 08 Lightning Protection System (LPS) -->
      <ServiceCard
        id="service-08"
        number="08"
        accent="error"
        categoryIcon="bolt"
        categoryLabel="Surge & Transient Defense"
        title="Lightning Protection System (LPS)"
        description="Sample description for lightning and surge protection. A qualified professional must confirm design requirements and applicable standards."
        scope="Example scope may include air terminals, down conductors, earthing, and surge protective devices. Verify product selection and compliance before use."
        suitableFor={['Data centers & telecom towers', 'Elevated commercial towers', 'Chemical & fuel depots', 'Industrial compounds']}
      />
    </div>
  </div>
</section>
