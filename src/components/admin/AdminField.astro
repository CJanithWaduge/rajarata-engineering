---
/**
 * Admin form field (Phase 11, A11.6).
 *
 * One component renders a labeled text / textarea / select / number control
 * with a required or optional marker, helper text, an optional character
 * counter for fields that have a real limit, and an inline error region that
 * the editor runtime fills in. Placeholders supplement labels; they never
 * replace them.
 */
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'url' | 'number' | 'textarea' | 'select';
  value?: string | number;
  placeholder?: string;
  required?: boolean;
  optional?: boolean;
  helper?: string;
  requiredMessage?: string;
  rows?: number;
  maxlength?: number;
  /** Show an "n / max" counter. Only use where a real limit exists. */
  counter?: boolean;
  options?: Option[];
  disabled?: boolean;
  readonly?: boolean;
  mono?: boolean;
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  value = '',
  placeholder,
  required,
  optional,
  helper,
  requiredMessage,
  rows = 6,
  maxlength,
  counter,
  options = [],
  disabled,
  readonly,
  mono,
  class: className,
} = Astro.props;

const id = name;
const errorId = `${id}-error`;
const helperId = `${id}-helper`;
const counterId = `${id}-counter`;
const describedBy = [helper ? helperId : null, counter && maxlength ? counterId : null, errorId]
  .filter(Boolean)
  .join(' ');

const controlBase =
  'w-full rounded-control border-[1.5px] border-outline-variant bg-surface-container-lowest px-3 ' +
  'font-body-md text-body-md text-on-surface placeholder:text-secondary/60 shadow-sm transition-colors ' +
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container ' +
  'disabled:cursor-not-allowed disabled:opacity-60 read-only:bg-surface-container-low';

const inputCls = `h-12 ${controlBase}`;
const textareaCls = `py-3 ${mono ? 'font-mono' : ''} ${controlBase}`;
const selectCls = `h-12 pr-9 ${controlBase}`;

const stringValue = String(value ?? '');
---

<div class={`space-y-1.5 ${className ?? ''}`} data-field>
  <label for={id} class="flex flex-wrap items-center gap-1.5">
    <span class="font-label-sm text-label-sm font-semibold text-on-surface">{label}</span>
    {required && <span class="text-primary-container" aria-hidden="true">*</span>}
    {required && <span class="sr-only">(required)</span>}
    {optional && <span class="font-body-sm text-body-sm text-secondary">(optional)</span>}
    {readonly && <span class="font-body-sm text-body-sm text-secondary">· read-only</span>}
  </label>

  {
    type === 'textarea' ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        maxlength={maxlength}
        placeholder={placeholder}
        disabled={disabled}
        readonly={readonly}
        required={required}
        data-required-message={requiredMessage}
        aria-describedby={describedBy}
        class={textareaCls}
      >{stringValue}</textarea>
    ) : type === 'select' ? (
      <select
        id={id}
        name={name}
        disabled={disabled}
        required={required}
        data-required-message={requiredMessage}
        aria-describedby={describedBy}
        class={selectCls}
      >
        <option value="">Select…</option>
        {options.map((option) => (
          <option value={option.value} selected={option.value === stringValue}>
            {option.label}
          </option>
        ))}
      </select>
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        value={stringValue}
        maxlength={maxlength}
        placeholder={placeholder}
        disabled={disabled}
        readonly={readonly}
        required={required}
        data-required-message={requiredMessage}
        aria-describedby={describedBy}
        class={inputCls}
      />
    )
  }

  <div class="flex items-start justify-between gap-3">
    {helper ? <p id={helperId} class="font-body-sm text-body-sm text-secondary">{helper}</p> : <span></span>}
    {
      counter && maxlength ? (
        <p id={counterId} class="shrink-0 font-body-sm text-body-sm text-secondary" data-counter-for={id}>
          <span data-counter-value>{stringValue.length}</span>/{maxlength}
        </p>
      ) : null
    }
  </div>

  <p id={errorId} class="hidden font-body-sm text-body-sm text-primary-container"></p>
</div>
