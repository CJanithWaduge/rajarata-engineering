---
/**
 * Workshop & office visitor information (Steps C6.36–C6.41)
 * Facility map card plus Site Access Protocol instructions. Address
 * stays a placeholder; directions are not built until a verified
 * location is supplied (see C6.39).
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 bg-surface">
  <Container>
    <div class="mb-8">
      <div>
        <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest"
          >Site Operations</span
        >
        <h2 class="font-headline-md text-headline-md text-on-surface tracking-tight mt-1">
          Workshop &amp; Office Visitor Instructions
        </h2>
      </div>
      <p class="font-body-md text-body-md text-secondary mt-1">
        Coordinate panel inspections, FAT (Factory Acceptance Testing), or technical meetings at our
        facilities.
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-8 flex flex-col">
      <div
        class="relative w-full h-80 sm:h-96 lg:h-full min-h-[350px] rounded-2xl shadow-md overflow-hidden flex flex-col justify-between p-6"
        data-location="Colombo, Sri Lanka"
      >
        <img
          class="absolute inset-0 w-full h-full object-cover"
          alt="Approximate map view of the Rajarata Engineering facility area"
          loading="lazy"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuAGCkEDt4NzfLXijJm_Y2QlNetjfGk4dlw-VjrB-Df6v1mAS97ocyHcr6LK4RbMEnUlElgSg4_yb5YCA5qyAiPXWeL91gnCicHjVNUpAvVLClXTwdoBD5JjCJkR615H-PcwC5IJdGyttWHMuXkqkOAEJ5_1BLQJHy4Jy9aNE-HSFRkHRnlD7fSjSJgobOlGKCkSH_hWXOwUUefAsT3ybCjSH9tWbThtVelnqczpL98aCJv-LUw9kJWmwA"
        />
        <div
          class="relative bg-inverse-surface/90 text-inverse-on-surface backdrop-blur-md px-4 py-2.5 rounded-xl shadow-lg w-fit flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-primary text-[20px]">pin_drop</span>
          <span class="font-title-md text-title-md font-bold">Rajarata Engineering Facility</span>
        </div>
        <div class="relative bg-surface-container-lowest/95 backdrop-blur-md p-4 rounded-xl shadow-lg self-start max-w-sm">
          <p class="font-label-caps text-label-caps uppercase text-secondary">Location</p>
          <p class="font-body-sm text-body-sm text-on-surface font-semibold mt-0.5">[REPLACE: BUSINESS ADDRESS]</p>
          <div class="mt-3 flex items-center gap-2">
            <a
              class="inline-flex items-center gap-1 font-label-sm text-label-sm text-primary hover:underline font-bold focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
              href="#"
            >
              <span>Get Driving Directions</span>
              <span class="material-symbols-outlined text-[16px]">navigation</span>
            </a>
          </div>
        </div>
      </div>
    </div>
      <div class="lg:col-span-4 bg-surface-container-lowest p-6 sm:p-8 rounded-2xl shadow-sm flex flex-col justify-between">
        <div>
          <h3
            class="font-title-lg text-title-lg text-on-surface font-bold mb-4 flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-primary">security</span>
            <span>Site Access Protocol</span>
          </h3>
          <ul class="space-y-4 font-body-sm text-body-sm text-secondary">
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>
              <span
                ><strong class="text-on-surface">Prior Appointment:</strong> Visitors must register at
                least 2 hours prior to arrival for safety clearance and security badge issue.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>
              <span
                ><strong class="text-on-surface">PPE Requirement:</strong> Steel-toe boots, hi-vis vest,
                and hard hats are mandatory inside the panel fabrication &amp; testing yard.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>
              <span
                ><strong class="text-on-surface">Heavy Deliveries:</strong> Switchgear freight and heavy
                container unloading hours: Mon–Fri, 9:00 AM – 4:00 PM via Bay 2.</span
              >
            </li>
          </ul>
        </div>
        <div class="mt-8 pt-6 bg-surface-container-low p-4 rounded-xl">
          <span class="font-label-caps text-label-caps uppercase text-secondary block mb-1"
            >Direct Gate Dispatch</span
          >
          <div class="flex items-center justify-between">
            <span class="font-title-md text-title-md text-on-surface font-semibold"
              >Security Gate House</span
            >
            <a
              class="text-primary hover:text-primary-container focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
              href="tel:[REPLACE: PHONE NUMBER]"
              aria-label="Call security gate house"
            >
              <span class="material-symbols-outlined text-2xl">call</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>