---
/**
 * Workshop & office visitor information (Steps C6.36–C6.41)
 * Sample map illustration and generic visitor-instruction template.
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 bg-surface" data-scroll-reveal>
  <Container>
    <div class="mb-8">
      <div>
        <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest"
          >Site Operations</span
        >
        <h2 class="font-headline-md text-headline-md text-on-surface tracking-tight mt-1">
          Workshop &amp; Office Visitor Instructions
        </h2>
      </div>
      <p class="font-body-md text-body-md text-secondary mt-1">
        Sample visitor guidance for a template preview. Confirm the actual location and access requirements before use.
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-8 flex flex-col">
      <div
        class="relative w-full h-80 sm:h-96 lg:h-full min-h-[350px] rounded-2xl shadow-md overflow-hidden flex flex-col justify-between p-6"
        data-location="Sample location — not geocoded"
      >
        <img
          class="absolute inset-0 w-full h-full object-cover"
          alt="Illustrative map artwork labeled as a sample location; it does not show a real business address"
          loading="lazy"
          src="/images/sample-location.svg"
        />
        <div
          class="relative bg-inverse-surface/90 text-inverse-on-surface backdrop-blur-md px-4 py-2.5 rounded-xl shadow-lg w-fit flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-primary text-[20px]">pin_drop</span>
          <span class="font-title-md text-title-md font-bold">Sample Location</span>
        </div>
        <div class="relative bg-surface-container-lowest/95 backdrop-blur-md p-4 rounded-xl shadow-lg self-start max-w-[24rem]">
          <p class="font-label-caps text-label-caps uppercase text-secondary">Location</p>
          <p class="font-body-sm text-body-sm text-on-surface font-semibold mt-0.5">No real visitor address is configured for this demo.</p>
          <div class="mt-3 flex items-center gap-2">
            <span class="font-label-sm text-label-sm text-secondary">
              Map is illustrative only; do not use it for directions.
            </span>
          </div>
        </div>
      </div>
    </div>
      <div class="card-interactive card-tilt lg:col-span-4 bg-surface-container-lowest p-6 sm:p-8 rounded-2xl shadow-sm flex flex-col justify-between" data-card-tilt>
        <div>
          <h3
            class="font-title-lg text-title-lg text-on-surface font-bold mb-4 flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-primary">security</span>
            <span>Site Access Protocol</span>
          </h3>
          <ul class="space-y-4 font-body-sm text-body-sm text-secondary">
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>
              <span
                ><strong class="text-on-surface">Prior Appointment:</strong> Sample instruction. Confirm real visitor registration procedures before use.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>
              <span
                ><strong class="text-on-surface">PPE Requirement:</strong> Example safety guidance. Obtain site-specific PPE rules from the responsible site owner.</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">check</span>
              <span
                ><strong class="text-on-surface">Deliveries:</strong> Sample logistics note. Confirm actual delivery hours and access arrangements before use.</span
              >
            </li>
          </ul>
        </div>
        <div class="mt-8 pt-6 bg-surface-container-low p-4 rounded-xl">
          <span class="font-label-caps text-label-caps uppercase text-secondary block mb-1"
            >Direct Gate Dispatch</span
          >
          <div class="flex items-center justify-between">
            <span class="font-title-md text-title-md text-on-surface font-semibold"
              >Security Gate House</span
            >
            <span class="text-secondary" aria-hidden="true">
              <span class="material-symbols-outlined text-2xl">call</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>