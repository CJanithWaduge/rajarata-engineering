---
/**
 * Workshop & office visitor information (Steps C6.36–C6.41)
 * Facility map card plus Site Access Protocol instructions. Address
 * stays a placeholder; directions are not built until a verified
 * location is supplied (see C6.39).
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 bg-surface">
  <Container>
    <div class="mb-8">
      <div></div>
      <p class="font-body-md text-body-md text-secondary mt-1"></p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-8 flex flex-col"></div>
      <div class="lg:col-span-4 bg-surface-container-lowest p-6 sm:p-8 rounded-2xl shadow-sm flex flex-col justify-between"></div>
    </div>
  </Container>
</section>