---
/**
 * Operational desks and support channels (Steps C6.12–C6.18)
 * Heading block and a responsive grid of illustrative contact information.
 */
import Container from '../Container.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { parseWhatsAppNumber } from '../../lib/whatsapp';

const whatsapp = parseWhatsAppNumber(import.meta.env.PUBLIC_WHATSAPP_NUMBER);
if (whatsapp.status === 'invalid') {
  console.warn('PUBLIC_WHATSAPP_NUMBER must be 8–15 digits in international format.');
}
---

<section class="w-full py-16 bg-surface" data-scroll-reveal>
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest"
          >Connect Directly</span
        >
        <h2 class="font-headline-md text-headline-md text-on-surface tracking-tight mt-1">
          Operational Desks &amp; Support Channels
        </h2>
      </div>
      <p class="font-body-md text-body-md text-secondary max-w-[28rem]">
        Example contact details for a website template. Replace them with verified business information before use.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group" data-card-tilt>
        <div>
          <div
            class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors mb-6"
          >
            <span class="material-symbols-outlined text-2xl">call</span>
          </div>
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block mb-1"
            >Direct Telephony</span
          >
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2 font-bold">Sample Phone</h3>
          <span class="font-title-md text-title-md text-on-surface font-semibold block mb-3 break-all">
            Sample phone — demo only
          </span>
        </div>
        <div class="pt-4 bg-surface-container-low px-3 py-2 rounded-lg mt-4">
          <div class="flex items-center gap-1.5 text-secondary font-body-sm text-body-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
            <span>Example service availability — verify before use</span>
          </div>
        </div>
      </div>
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group" data-card-tilt>
        <div>
          <div
            class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors mb-6"
          >
            <span class="material-symbols-outlined text-2xl">drafts</span>
          </div>
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block mb-1"
            >Technical Correspondence</span
          >
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2 font-bold">Sample Email</h3>
          <span class="font-title-md text-title-md text-on-surface font-semibold block mb-3 break-all">
            sample@example.invalid
          </span>
        </div>
        <div class="pt-4 bg-surface-container-low px-3 py-2 rounded-lg mt-4">
          <div class="flex items-center gap-1.5 text-secondary font-body-sm text-body-sm">
            <span class="material-symbols-outlined text-[16px] text-tertiary">assignment</span>
            <span>Example inquiry channel — not monitored</span>
          </div>
        </div>
      </div>
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group" data-card-tilt>
        <div>
          <div
            class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors mb-6"
          >
            <span class="material-symbols-outlined text-2xl">location_on</span>
          </div>
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block mb-1"
            >Central Operations</span
          >
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2 font-bold">Sample Location</h3>
          <p class="font-body-md text-body-md text-on-surface font-medium leading-snug mb-3">
            Sample address — no visitor location configured
          </p>
        </div>
        <div class="pt-4 bg-surface-container-low px-3 py-2 rounded-lg mt-4">
          <div class="flex items-center gap-1.5 text-secondary font-body-sm text-body-sm">
            <span class="material-symbols-outlined text-[16px] text-tertiary">factory</span>
            <span>Example facility information — verify before use</span>
          </div>
        </div>
      </div>
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group" data-card-tilt>
        <div>
          <div
            class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors mb-6"
          >
            <span class="material-symbols-outlined text-2xl">schedule</span>
          </div>
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block mb-1"
            >Site Availability</span
          >
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2 font-bold">Sample Hours</h3>
          <p class="font-body-sm text-body-sm text-on-surface font-semibold mb-1">
            Example schedule — verify before use
          </p>
          <p class="font-body-sm text-body-sm text-secondary">
            Sample availability copy only; no on-call service is represented.
          </p>
        </div>
        {whatsapp.status === 'ready' && (
          <div class="mt-4 pt-3">
            <a
              href={whatsapp.href}
              aria-label={`Chat with Rajarata Engineering on WhatsApp at ${whatsapp.displayNumber}`}
              class="inline-flex min-h-11 w-full max-w-full flex-wrap items-center justify-center gap-2 break-all rounded-lg bg-whatsapp px-4 py-2.5 font-label-md text-label-md text-white shadow-sm transition-colors hover:bg-whatsapp-hover active:translate-y-px focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <WhatsAppIcon class="h-5 w-5" />
              <span>{whatsapp.displayNumber}</span>
            </a>
          </div>
        )}
      </div>
    </div>
  </Container>
</section>