---
/**
 * Operational desks and support channels (Steps C6.12–C6.18)
 * Heading block and a responsive grid of direct-contact information cards.
 * Phone, email, address, and hours remain placeholders; availability copy
 * stays as supplied prototype text pending verification.
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 bg-surface">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest"
          >Connect Directly</span
        >
        <h2 class="font-headline-md text-headline-md text-on-surface tracking-tight mt-1">
          Operational Desks &amp; Support Channels
        </h2>
      </div>
      <p class="font-body-md text-body-md text-secondary max-w-[28rem]">
        Direct engineering access for procurement teams, site facility managers, and project contractors.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div
            class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors mb-6"
          >
            <span class="material-symbols-outlined text-2xl">call</span>
          </div>
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block mb-1"
            >Direct Telephony</span
          >
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2 font-bold">Voice Support</h3>
          <a
            class="font-title-md text-title-md text-primary hover:underline font-semibold block mb-3 break-all focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
            href="tel:[REPLACE: PHONE NUMBER]"
          >
            [REPLACE: PHONE NUMBER]
          </a>
        </div>
        <div class="pt-4 bg-surface-container-low px-3 py-2 rounded-lg mt-4">
          <div class="flex items-center gap-1.5 text-secondary font-body-sm text-body-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
            <span>24/7 Emergency dispatch available</span>
          </div>
        </div>
      </div>
      <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div
            class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors mb-6"
          >
            <span class="material-symbols-outlined text-2xl">drafts</span>
          </div>
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block mb-1"
            >Technical Correspondence</span
          >
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2 font-bold">Email Desk</h3>
          <a
            class="font-title-md text-title-md text-primary hover:underline font-semibold block mb-3 break-all focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
            href="mailto:[REPLACE: EMAIL ADDRESS]"
          >
            [REPLACE: EMAIL ADDRESS]
          </a>
        </div>
        <div class="pt-4 bg-surface-container-low px-3 py-2 rounded-lg mt-4">
          <div class="flex items-center gap-1.5 text-secondary font-body-sm text-body-sm">
            <span class="material-symbols-outlined text-[16px] text-tertiary">assignment</span>
            <span>Official project estimation &amp; BOQ tenders</span>
          </div>
        </div>
      </div>
      <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div
            class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors mb-6"
          >
            <span class="material-symbols-outlined text-2xl">location_on</span>
          </div>
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block mb-1"
            >Central Operations</span
          >
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2 font-bold">Headquarters</h3>
          <p class="font-body-md text-body-md text-on-surface font-medium leading-snug mb-3">
            [REPLACE: BUSINESS ADDRESS]
          </p>
        </div>
        <div class="pt-4 bg-surface-container-low px-3 py-2 rounded-lg mt-4">
          <div class="flex items-center gap-1.5 text-secondary font-body-sm text-body-sm">
            <span class="material-symbols-outlined text-[16px] text-tertiary">factory</span>
            <span>Engineering workshop &amp; fabrication bay</span>
          </div>
        </div>
      </div>
      <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div
            class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors mb-6"
          >
            <span class="material-symbols-outlined text-2xl">schedule</span>
          </div>
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block mb-1"
            >Site Availability</span
          >
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2 font-bold">Working Hours</h3>
          <p class="font-body-sm text-body-sm text-on-surface font-semibold mb-1">
            [REPLACE: BUSINESS HOURS]
          </p>
          <p class="font-body-sm text-body-sm text-secondary">
            Technicians on on-call rotation over weekends.
          </p>
        </div>
        <div class="mt-4 pt-3">
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            data-site-field="whatsapp"
            data-site-href="whatsapp"
            data-site-text="false"
            aria-label="WhatsApp direct chat"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-whatsapp text-white font-label-md text-label-md hover:bg-whatsapp-hover transition-all shadow-sm focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>WhatsApp Direct</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>