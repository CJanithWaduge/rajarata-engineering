---
/**
 * Emergency support strip (Steps C6.8–C6.11)
 * Inverse-surface urgent-support banner. The hotline stays a placeholder
 * — availability is not implied until the user confirms it.
 */
import Container from '../Container.astro';
---

<section class="w-full bg-inverse-surface text-inverse-on-surface py-4 shadow-sm">
  <Container class="flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3"></div>
    <div class="flex items-center gap-3 w-full md:w-auto justify-end"></div>
  </Container>
</section>