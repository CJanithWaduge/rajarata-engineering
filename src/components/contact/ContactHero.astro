---
/**
 * Contact hero (Steps C6.2–C6.7)
 * Section shell, background treatment, breadcrumb, eyebrow, heading,
 * introduction, and standards indicator.
 */
import Container from '../Container.astro';
---

<section class="relative w-full bg-surface-container-low py-12 lg:py-16 overflow-hidden">
  <!-- Primary Glow Accent -->
  <div
    class="absolute -right-20 -top-24 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <!-- Secondary Glow Accent -->
  <div
    class="absolute left-1/3 -bottom-20 w-80 h-80 rounded-full bg-tertiary/5 blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <Container class="relative z-10">
    <nav
      aria-label="Breadcrumb"
      class="flex items-center gap-2 font-label-sm text-label-sm text-secondary mb-6"
    >
      <a
        class="hover:text-primary transition-colors focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
        data-path="home"
        href="#"
      >
        Home
      </a>
      <span class="material-symbols-outlined text-[16px] text-secondary">chevron_right</span>
      <span class="text-on-surface font-title-md">Contact</span>
    </nav>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8 flex flex-col space-y-4">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-surface-container text-on-surface w-fit"
        >
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary">
            Field Operations &amp; Engineering Consultation
          </span>
        </div>
      </div>
      <div class="lg:col-span-4 flex lg:justify-end"></div>
    </div>
  </Container>
</section>