---
/**
 * Technical quotation request and estimation process
 * (Steps C6.19–C6.35)
 * Two-column layout: inquiry form (7 cols) and estimation/support
 * sidebar (5 cols). The form submits through the callable Cloud
 * Function; success is reported only after the function confirms
 * acceptance (see C6.30).
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 bg-surface-container-low">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-7 bg-surface-container-lowest p-8 lg:p-10 rounded-2xl shadow-md">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 text-primary font-label-caps text-label-caps uppercase tracking-wider mb-2">
            <span class="material-symbols-outlined text-[16px]">engineering</span>
            <span>Engineering Tender &amp; Estimation</span>
          </div>
          <h2 class="font-headline-md text-headline-md text-on-surface tracking-tight font-bold">
            Request a Technical Quotation or Consultation
          </h2>
          <p class="font-body-md text-body-md text-secondary mt-2">
            Submit your project requirements and our engineering estimation team will respond within 24 hours.
          </p>
        </div>
        <form class="space-y-6" id="contact-quotation-form">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col space-y-1.5">
            <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="full-name">
              Full Name <span class="text-primary">*</span>
            </label>
            <input
              class="w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-secondary/60 shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
              id="full-name"
              placeholder="e.g. Priyantha Jayasuriya"
              required
              type="text"
            />
          </div>
        </div>

        <div class="pt-2">
          <button
            class="w-full h-14 rounded-xl bg-primary-container text-on-primary font-title-md text-title-md tracking-wider uppercase font-bold shadow-md hover:bg-primary transition-all duration-150 active:translate-y-[1px] flex items-center justify-center gap-3 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            type="submit"
          >
            <span class="material-symbols-outlined">send</span>
            <span>SEND INQUIRY</span>
          </button>
          <div
            class="hidden mt-4 p-4 rounded-xl bg-secondary-container text-on-secondary-fixed flex items-center gap-3"
            id="form-feedback"
            role="status"
            aria-live="polite"
          ></div>
        </div>
      </form>
      </div>
      <div class="lg:col-span-5 flex flex-col space-y-8"></div>
    </div>
  </Container>
</section>