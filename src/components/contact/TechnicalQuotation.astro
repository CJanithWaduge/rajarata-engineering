---
/**
 * Technical quotation request and estimation process
 * (Steps C6.19–C6.35)
 * Two-column layout: inquiry form (7 cols) and estimation/support
 * sidebar (5 cols). The form submits through the callable Cloud
 * Function; success is reported only after the function confirms
 * acceptance (see C6.30).
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 bg-surface-container-low">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-7 bg-surface-container-lowest p-8 lg:p-10 rounded-2xl shadow-md">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 text-primary font-label-caps text-label-caps uppercase tracking-wider mb-2">
            <span class="material-symbols-outlined text-[16px]">engineering</span>
            <span>Engineering Tender &amp; Estimation</span>
          </div>
          <h2 class="font-headline-md text-headline-md text-on-surface tracking-tight font-bold">
            Request a Technical Quotation or Consultation
          </h2>
          <p class="font-body-md text-body-md text-secondary mt-2">
            Submit your project requirements and our engineering estimation team will respond within 24 hours.
          </p>
        </div>
        <form class="space-y-6" id="contact-quotation-form">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col space-y-1.5">
            <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="full-name">
              Full Name <span class="text-primary">*</span>
            </label>
            <input
              class="w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-secondary/60 shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
              id="full-name"
              placeholder="e.g. Priyantha Jayasuriya"
              required
              type="text"
            />
          </div>

          <div class="flex flex-col space-y-1.5">
            <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="company">
              Company / Organization
            </label>
            <input
              class="w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-secondary/60 shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
              id="company"
              placeholder="e.g. Apex Industrial Parks"
              type="text"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col space-y-1.5">
            <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="email">
              Email Address <span class="text-primary">*</span>
            </label>
            <input
              class="w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-secondary/60 shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
              id="email"
              placeholder="name@company.com"
              required
              type="email"
            />
          </div>

          <div class="flex flex-col space-y-1.5">
            <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="phone">
              Phone Number <span class="text-primary">*</span>
            </label>
            <input
              class="w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-secondary/60 shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
              id="phone"
              placeholder="+94 7X XXX XXXX"
              required
              type="tel"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col space-y-1.5">
            <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="service-required">
              Service Required <span class="text-primary">*</span>
            </label>
            <select
              class="w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
              id="service-required"
              required
            >
              <option disabled selected value="">Select service discipline...</option>
              <option value="Residential &amp; Commercial Electrical Wiring"
                >Residential &amp; Commercial Electrical Wiring</option
              >
              <option value="Industrial Electrical Installations">Industrial Electrical Installations</option>
              <option value="MDB / SMDB Panel Installation">MDB / SMDB Panel Installation</option>
              <option value="Cable Tray Installation &amp; Cable Laying"
                >Cable Tray Installation &amp; Cable Laying</option
              >
              <option value="Testing &amp; Commissioning">Testing &amp; Commissioning</option>
              <option value="Electrical Maintenance &amp; Troubleshooting"
                >Electrical Maintenance &amp; Troubleshooting</option
              >
              <option value="All Kinds of ELV Solutions">All Kinds of ELV Solutions</option>
              <option value="Lightning Protection System (LPS)">Lightning Protection System (LPS)</option>
              <option value="General Engineering Inquiry">General Engineering Inquiry</option>
            </select>
          </div>

          <div class="flex flex-col space-y-1.5">
            <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="location">
              Project Location <span class="text-primary">*</span>
            </label>
            <input
              class="w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-secondary/60 shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
              id="location"
              placeholder="e.g. Colombo, Kandy, Anuradhapura"
              required
              type="text"
            />
          </div>
        </div>

        <div class="flex flex-col space-y-1.5">
          <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="urgency">
            Project Urgency / Timeline
          </label>
          <select
            class="w-full h-12 px-4 rounded-xl bg-surface-container-lowest text-on-surface shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
            id="urgency"
          >
            <option value="Immediate">Immediate Execution (Critical Path)</option>
            <option value="Within 1 Month">Within 1 Month</option>
            <option value="1-3 Months">1 – 3 Months</option>
            <option value="Planning Stage">Planning Stage / Preliminary BOQ</option>
          </select>
        </div>

        <div class="flex flex-col space-y-1.5">
          <label class="font-label-sm text-label-sm text-on-surface font-semibold" for="project-message">
            Project Scope / Technical Details <span class="text-primary">*</span>
          </label>
          <textarea
            class="w-full p-4 rounded-xl bg-surface-container-lowest text-on-surface placeholder:text-secondary/60 shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors min-h-[120px]"
            id="project-message"
            placeholder="Describe electrical load ratings, switchgear requirements, architectural constraints, or site drawings info..."
            required
            rows="5"
          ></textarea>
        </div>

        <div class="pt-2">
          <button
            class="w-full h-14 rounded-xl bg-primary-container text-on-primary font-title-md text-title-md tracking-wider uppercase font-bold shadow-md hover:bg-primary transition-all duration-150 active:translate-y-[1px] flex items-center justify-center gap-3 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            type="submit"
          >
            <span class="material-symbols-outlined">send</span>
            <span>SEND INQUIRY</span>
          </button>
          <div
            class="hidden mt-4 p-4 rounded-xl bg-secondary-container text-on-secondary-fixed flex items-center gap-3"
            id="form-feedback"
            role="status"
            aria-live="polite"
          ></div>
        <div class="flex items-center justify-center gap-2 mt-4 text-secondary font-body-sm text-body-sm">
            <span class="material-symbols-outlined text-[18px] text-tertiary">lock</span>
            <span>Your engineering details and site plans are kept strictly confidential.</span>
          </div>
        </div>
      </form>
      </div>
      <div class="lg:col-span-5 flex flex-col space-y-8">
        <div class="relative w-full rounded-2xl overflow-hidden shadow-md bg-surface-container">
          <img
            class="w-full h-64 object-cover"
            alt="An experienced chief electrical engineer in a yellow safety hardhat reviewing high-voltage industrial switchgear blueprints"
            loading="lazy"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDIBOjXTE4dV76eMe-J9yzOF3sEWBg5BP4alxNSY1ZKNg9Uy6-kWXKP38MLRNhiB3lEx0ILzoY800gX2jiXg6-UFtUnzyji3IuKT-pK_PAtqPMurSQ79vH-o7TFeIAhKzjGZt227Kemw6Dg3Q46haVtr9ocpkgseq1lokiPc4L4F6RA6boBBvpEvO-59pNoIeygRQPogv9_TeZszpgdCke4uX7eeUo4RBwkOm_7V5JCVD7g_AQqGMvG1A"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-inverse-surface/90 via-inverse-surface/40 to-transparent p-6 flex flex-col justify-end text-inverse-on-surface"
          >
            <span class="font-label-caps text-label-caps uppercase text-primary-fixed-dim tracking-wider"
              >Certified Engineers</span
            >
            <h3 class="font-title-lg text-title-lg font-bold">Chartered Technical Supervision</h3>
            <p class="font-body-sm text-body-sm text-secondary-fixed mt-1">
              Every proposal is vetted against IEEE regulations, IET wiring guidelines, and national CEB
              standards.
            </p>
          </div>
        </div>

        <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm">
          <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest block mb-1"
            >Workflow Transparency</span
          >
          <h4 class="font-title-lg text-title-lg text-on-surface font-bold mb-4">Our Estimation Protocol</h4>
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div
                class="w-8 h-8 rounded-lg bg-surface-container flex-shrink-0 flex items-center justify-center text-primary font-bold text-sm"
              >
                01
              </div>
              <div>
                <h5 class="font-title-md text-title-md text-on-surface font-semibold"
                  >Load &amp; Single Line Diagram Analysis</h5
                >
                <p class="font-body-sm text-body-sm text-secondary mt-0.5">
                  Comprehensive review of client drawings, power distribution requirements, and busbar ratings.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div
                class="w-8 h-8 rounded-lg bg-surface-container flex-shrink-0 flex items-center justify-center text-primary font-bold text-sm"
              >
                02
              </div>
              <div>
                <h5 class="font-title-md text-title-md text-on-surface font-semibold"
                  >On-Site Feasibility Audit</h5
                >
                <p class="font-body-sm text-body-sm text-secondary mt-0.5">
                  Physical site inspection for cable tray pathways, transformer housing, and earth pit soil
                  resistivity tests.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div
                class="w-8 h-8 rounded-lg bg-surface-container flex-shrink-0 flex items-center justify-center text-primary font-bold text-sm"
              >
                03
              </div>
              <div>
                <h5 class="font-title-md text-title-md text-on-surface font-semibold"
                  >Comprehensive BOQ Delivery</h5
                >
                <p class="font-body-sm text-body-sm text-secondary mt-0.5">
                  Transparent, itemized pricing breakdown covering switchgear, cabling, containment, and labor
                  certifications.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-secondary-container text-on-secondary-fixed shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class="material-symbols-outlined text-primary text-2xl">support_agent</span>
            <h4 class="font-title-md text-title-md font-bold">Have Urgent Tender Deadlines?</h4>
          </div>
          <p class="font-body-sm text-body-sm text-on-secondary-fixed-variant leading-relaxed">
            For active government or commercial tender submittals requiring quick turnarounds, mark your message
            urgent or contact our direct project desk.
          </p>
          <div class="mt-4 flex items-center justify-between">
            <span class="font-label-caps text-label-caps tracking-widest text-primary font-bold"
              >Priority Tenders</span
            >
            <a
              class="font-label-md text-label-md font-bold text-on-secondary-fixed hover:text-primary transition-colors flex items-center gap-1 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              href="tel:[REPLACE: PHONE NUMBER]"
            >
              Call Direct <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>