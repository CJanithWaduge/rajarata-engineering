---
/**
 * Projects hero (Steps P5.2–P5.7)
 * Section shell, background treatment, breadcrumb, trust label, heading,
 * introduction, and compliance/scope indicators.
 */
import Container from '../Container.astro';
---

<section class="relative w-full bg-surface-container-lowest overflow-hidden">
  <!-- Dotted Technical Background Pattern -->
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none [background-image:radial-gradient(var(--color-on-surface)_1px,transparent_1px)] [background-size:24px_24px]"
    aria-hidden="true"
  ></div>
  <!-- Secondary Glow Accent -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20"></div>
  <Container class="pt-10 pb-16 lg:pt-14 lg:pb-20 relative z-10">
    <div class="flex items-center gap-2 mb-6 text-on-surface-variant font-label-sm text-label-sm">
      <a
        class="hover:text-primary transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container"
        data-path="home"
        href="#"
      >
        <span class="material-symbols-outlined text-[16px]">home</span>
        <span>Home</span>
      </a>
      <span class="text-secondary/50">/</span>
      <span class="text-primary font-semibold">Projects</span>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8 flex flex-col space-y-4">
        <div
          class="inline-flex items-center gap-2 self-start px-3 py-1 rounded-md bg-secondary-container text-on-secondary-fixed font-label-caps text-label-caps uppercase tracking-widest"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
          Verified Track Record
        </div>
        <h1 class="font-headline-lg text-headline-lg tracking-tight text-on-surface lg:text-[46px] lg:leading-[54px]">
          Engineering Projects &amp; Portfolio
        </h1>
        <p class="font-body-lg text-body-lg text-secondary max-w-3xl leading-relaxed">
          [REPLACE: Project portfolio introduction]
        </p>
      </div>
    </div>
  </Container>
</section>