---
/**
 * Track record metrics band (Steps P5.24–P5.27)
 * Inverse-surface section with a three-column trust/metrics layout.
 * Metric values are sample labels, not verified company statistics.
 */
import Container from '../Container.astro';
---

<section class="w-full bg-inverse-surface text-inverse-on-surface py-16 relative overflow-hidden" data-scroll-reveal>
  <!-- Faint Technical Background Glow -->
  <div
    class="absolute -right-24 -bottom-24 w-96 h-96 rounded-full bg-primary/10 blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <Container class="relative z-10">
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left divide-y md:divide-y-0 md:divide-x divide-white/10"
    >
      <div class="flex flex-col space-y-2 pt-6 md:pt-0 md:pr-8">
        <div class="flex items-center justify-center md:justify-start gap-2">
          <span class="material-symbols-outlined text-primary text-[28px]">electric_meter</span>
          <span class="font-label-caps text-label-caps text-gray-400 uppercase tracking-widest">Delivered Infrastructure</span>
        </div>
        <div class="font-headline-lg text-headline-lg text-white font-extrabold tracking-tight">
          SAMPLE
        </div>
        <p class="font-body-sm text-body-sm text-gray-400">
          Example project metric. Replace with a verified figure before real-world use.
        </p>
      </div>
      <div class="flex flex-col space-y-2 pt-6 md:pt-0 md:px-8">
        <div class="flex items-center justify-center md:justify-start gap-2">
          <span class="material-symbols-outlined text-primary text-[28px]">security</span>
          <span class="font-label-caps text-label-caps text-gray-400 uppercase tracking-widest">Operational Safety</span>
        </div>
        <div class="font-headline-lg text-headline-lg text-white font-extrabold tracking-tight">
          SAMPLE
        </div>
        <p class="font-body-sm text-body-sm text-gray-400">
          Example safety metric. Do not interpret this as an actual incident or safety record.
        </p>
      </div>
      <div class="flex flex-col space-y-2 pt-6 md:pt-0 md:pl-8">
        <div class="flex items-center justify-center md:justify-start gap-2">
          <span class="material-symbols-outlined text-primary text-[28px]">badge</span>
          <span class="font-label-caps text-label-caps text-gray-400 uppercase tracking-widest">Technical Workforce</span>
        </div>
        <div class="font-headline-lg text-headline-lg text-white font-extrabold tracking-tight">
          SAMPLE
        </div>
        <p class="font-body-sm text-body-sm text-gray-400">
          Example workforce metric. Add only verified qualifications and staffing details.
        </p>
      </div>
    </div>
  </Container>
</section>