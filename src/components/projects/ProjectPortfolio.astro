---
/**
 * Filterable project portfolio (Steps P5.8–P5.23)
 * Sticky filter toolbar, six project cards, accessible filtering,
 * live project count, and per-card specification disclosures.
 */
import Container from '../Container.astro';
import ProjectCard from './ProjectCard.astro';

const projects = [
  {
    id: 'ind-01',
    category: 'industrial',
    categoryLabel: 'Industrial',
    categoryChip: 'bg-surface-container-lowest text-primary',
    subTag: 'HV/LV',
    imgSrc:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuBjRu2nMAVReuf9ds1eO-Ub5BEZTvRpvAfnwRgzLpDJ_qKpPqVKd7bplMfoFb0oaVpoqQ32KPeHRDxUAlhncJXZuwf161sXakiXjObTVwZ82h5S3jfIMCKq7WJ-5G2ze3xT0eA0eqstgA8cV-vzh34vd5kkmSmvdhNQzBLVYvTNmzC5zv_W39QF47SwSq5CS17f6n_tL87K7520S60i8q3ufur_Oq0qKju-Wt5BEdPAd6skXr9K9pCW1Q',
    imgAlt:
      'Modern high-voltage industrial manufacturing substation with heavy duty copper busbars, main distribution switchboards, and red safety indicators under bright architectural illumination.',
    locationIcon: 'text-primary-fixed',
    ref: 'REF: IND-01',
    refColor: 'text-primary',
    typePlaceholder: '[REPLACE: PROJECT TYPE]',
    titlePlaceholder: '[REPLACE: PROJECT 01]',
    summaryPlaceholder: '[REPLACE: Brief scope of electrical installation, capacity, and results]',
    specLabel: 'Execution Scope',
    specValue: 'Substation & Heavy Feeders',
    specDetail: '[REPLACE: Supplemental Execution Scope details]',
  },
  {
    id: 'com-02',
    category: 'commercial',
    categoryLabel: 'Commercial',
    categoryChip: 'bg-surface-container-lowest text-tertiary',
    subTag: 'MDB Panels',
    imgSrc:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuAkGwuLh-L7eOuS1TVIKP4AxkfdgVlLVW5gM53sABsjEgq-xLxlS2e21TrZ4M8qypWg8X5_3n_mpflSI4i59LuH1f2X3ElbsQAIXR1_1GQXqPnFvhGYEkTIdaJE9uUxPRsoKxtz8qoyj1MiFM0syzodQxsuDWf6H8XN9RIeNS6MEzSMU5vDGP3pQFJ1iLjC-A_fYchUBSVVgfrPj2Qucf5TzikFCIWMxnHQUtpb0_VpekTt85YS0t-iPQ',
    imgAlt:
      'Sophisticated corporate tower main switchboard room showing custom built MDB and sub main distribution panels with digital metering displays and neatly run heavy trunking.',
    locationIcon: 'text-tertiary-fixed',
    ref: 'REF: COM-02',
    refColor: 'text-tertiary',
    typePlaceholder: '[REPLACE: PROJECT TYPE]',
    titlePlaceholder: '[REPLACE: PROJECT 02]',
    summaryPlaceholder: '[REPLACE: Scope of MDB panel installation and energy distribution]',
    specLabel: 'System Architecture',
    specValue: 'Dual Incomer & ATS Unit',
    specDetail: '[REPLACE: Supplemental System Architecture details]',
  },
];
---

<section class="w-full bg-surface py-6 sticky top-20 z-30 backdrop-blur-md bg-surface/90 shadow-sm">
  <Container>
    <div class="flex items-center justify-between gap-4">
      <div class="w-full overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden py-1">
        <div class="flex items-center gap-2 sm:gap-3 min-w-max">
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-primary-container text-on-primary transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="all"
            type="button"
            aria-pressed="true"
          >
            <span class="material-symbols-outlined text-[18px]">apps</span>
            <span>All Projects</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="residential"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">domain</span>
            <span>Residential</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="commercial"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">apartment</span>
            <span>Commercial</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="industrial"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">factory</span>
            <span>Industrial</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="elv"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">settings_ethernet</span>
            <span>ELV Solutions</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="maintenance"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">build</span>
            <span>Maintenance &amp; Testing</span>
          </button>
        </div>
      </div>
      <div class="hidden xl:flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm whitespace-nowrap pl-4">
        <span class="inline-block w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span aria-live="polite">Showing <strong class="text-on-surface" id="project-count">0</strong> Projects</span>
      </div>
    </div>
  </Container>
</section>

<section class="w-full bg-surface py-12 lg:py-16">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((p) => (
          <ProjectCard
            category={p.category}
            categoryLabel={p.categoryLabel}
            categoryChip={p.categoryChip}
            subTag={p.subTag}
            imgSrc={p.imgSrc}
            imgAlt={p.imgAlt}
            locationIcon={p.locationIcon}
            ref={p.ref}
            refColor={p.refColor}
            typePlaceholder={p.typePlaceholder}
            titlePlaceholder={p.titlePlaceholder}
            summaryPlaceholder={p.summaryPlaceholder}
            specLabel={p.specLabel}
            specValue={p.specValue}
            specDetail={p.specDetail}
            specId={`spec-${p.id}`}
          />
        ))
      }
    </div>
  </Container>
</section>