---
/**
 * Filterable project portfolio (Steps P5.8–P5.23)
 * Sticky filter toolbar, six project cards, accessible filtering,
 * live project count, and per-card specification disclosures.
 */
import Container from '../Container.astro';
import ProjectCard from './ProjectCard.astro';

const projects = [
  {
    id: 'ind-01',
    category: 'industrial',
    categoryLabel: 'Industrial',
    categoryChip: 'bg-surface-container-lowest text-primary',
    subTag: 'HV/LV',
    imgSrc: '/images/sample-project.svg',
    imgAlt: 'Illustrative electrical engineering project artwork; not a photograph of a completed project.',
    locationIcon: 'text-primary-fixed',
    ref: 'REF: IND-01',
    refColor: 'text-primary',
    typePlaceholder: 'Sample industrial',
    titlePlaceholder: 'Sample distribution project',
    summaryPlaceholder: 'Illustrative concept for an industrial distribution upgrade. This is not a completed or contracted project.',
    specLabel: 'Execution Scope',
    specValue: 'Example distribution scope',
    specDetail: 'Sample detail for layout demonstration only; no site, capacity, or delivery claim is represented.',
  },
  {
    id: 'com-02',
    category: 'commercial',
    categoryLabel: 'Commercial',
    categoryChip: 'bg-surface-container-lowest text-tertiary',
    subTag: 'MDB Panels',
    imgSrc: '/images/sample-project.svg',
    imgAlt: 'Illustrative electrical engineering project artwork; not a photograph of a completed project.',
    locationIcon: 'text-tertiary-fixed',
    ref: 'REF: COM-02',
    refColor: 'text-tertiary',
    typePlaceholder: 'Sample commercial',
    titlePlaceholder: 'Sample panel project',
    summaryPlaceholder: 'Illustrative concept for a building distribution panel. This is not a completed or contracted project.',
    specLabel: 'System Architecture',
    specValue: 'Example panel scope',
    specDetail: 'Sample detail for layout demonstration only; no equipment, site, or installation claim is represented.',
  },
  {
    id: 'elv-03',
    category: 'elv',
    categoryLabel: 'ELV Solutions',
    categoryChip: 'bg-secondary-container text-on-secondary-fixed',
    subTag: 'Automation',
    imgSrc: '/images/sample-project.svg',
    imgAlt: 'Illustrative electrical engineering project artwork; not a photograph of a completed project.',
    locationIcon: 'text-secondary-fixed',
    ref: 'REF: ELV-03',
    refColor: 'text-tertiary',
    typePlaceholder: 'Sample ELV',
    titlePlaceholder: 'Sample building systems project',
    summaryPlaceholder: 'Illustrative concept for connected building systems. This is not a completed or contracted project.',
    specLabel: 'Integration Points',
    specValue: 'Example integration scope',
    specDetail: 'Sample detail for layout demonstration only; no client, installation, or outcome is represented.',
  },
  {
    id: 'res-04',
    category: 'residential',
    categoryLabel: 'Residential',
    categoryChip: 'bg-surface-container-lowest text-on-surface',
    subTag: 'Smart Power',
    imgSrc: '/images/sample-project.svg',
    imgAlt: 'Illustrative electrical engineering project artwork; not a photograph of a completed project.',
    locationIcon: 'text-primary-fixed',
    ref: 'REF: RES-04',
    refColor: 'text-secondary',
    typePlaceholder: 'Sample residential',
    titlePlaceholder: 'Sample residential wiring project',
    summaryPlaceholder: 'Illustrative concept for a residential wiring upgrade. This is not a completed or contracted project.',
    specLabel: 'Specialty',
    specValue: 'Example residential scope',
    specDetail: 'Sample detail for layout demonstration only; no property, client, or delivery claim is represented.',
  },
  {
    id: 'lps-05',
    category: 'industrial',
    categoryLabel: 'Lightning Protection',
    categoryChip: 'bg-error-container text-on-error-container',
    subTag: 'Surge Safe',
    imgSrc: '/images/sample-project.svg',
    imgAlt: 'Illustrative electrical engineering project artwork; not a photograph of a completed project.',
    locationIcon: 'text-primary-fixed',
    ref: 'REF: LPS-05',
    refColor: 'text-error',
    typePlaceholder: 'Sample protection',
    titlePlaceholder: 'Sample surge protection project',
    summaryPlaceholder: 'Illustrative concept for a lightning-protection system. This is not a completed or contracted project.',
    specLabel: 'Compliance Grade',
    specValue: 'Example design scope',
    specDetail: 'Sample detail for layout demonstration only; verify standards and design suitability before use.',
  },
  {
    id: 'tst-06',
    category: 'maintenance',
    categoryLabel: 'Testing & Commissioning',
    categoryChip: 'bg-secondary-fixed text-on-secondary-fixed',
    subTag: 'Inspection',
    imgSrc: '/images/sample-project.svg',
    imgAlt: 'Illustrative electrical engineering project artwork; not a photograph of a completed project.',
    locationIcon: 'text-primary-fixed',
    ref: 'REF: TST-06',
    refColor: 'text-tertiary',
    typePlaceholder: 'Sample testing',
    titlePlaceholder: 'Sample testing project',
    summaryPlaceholder: 'Illustrative concept for electrical testing and commissioning. This is not a completed or contracted project.',
    specLabel: 'Test Protocol',
    specValue: 'Insulation & Earth Loop Array',
    specDetail: 'Sample detail for layout demonstration only; verify instruments, methods, and qualifications before use.',
  },
];
---

<section class="w-full bg-surface py-6 sticky top-20 z-30 backdrop-blur-md bg-surface/90 shadow-sm">
  <Container>
    <div class="flex items-center justify-between gap-4">
      <div class="w-full overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden py-1">
        <div class="flex items-center gap-2 sm:gap-3 min-w-max">
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-primary-container text-on-primary transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="all"
            type="button"
            aria-pressed="true"
          >
            <span class="material-symbols-outlined text-[18px]">apps</span>
            <span>All Projects</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="residential"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">domain</span>
            <span>Residential</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="commercial"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">apartment</span>
            <span>Commercial</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="industrial"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">factory</span>
            <span>Industrial</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="elv"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">settings_ethernet</span>
            <span>ELV Solutions</span>
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl font-label-md text-label-md bg-surface-container-lowest text-secondary hover:text-on-surface hover:bg-surface-container transition-all duration-150 shadow-sm flex items-center gap-2"
            data-filter="maintenance"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]">build</span>
            <span>Maintenance &amp; Testing</span>
          </button>
        </div>
      </div>
      <div class="hidden xl:flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm whitespace-nowrap pl-4">
        <span class="inline-block w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span aria-live="polite">Showing <strong class="text-on-surface" id="project-count">0</strong> Projects</span>
      </div>
    </div>
  </Container>
</section>

<section class="w-full bg-surface py-12 lg:py-16" data-scroll-reveal>
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((p) => (
          <ProjectCard
            category={p.category}
            categoryLabel={p.categoryLabel}
            categoryChip={p.categoryChip}
            subTag={p.subTag}
            imgSrc={p.imgSrc}
            imgAlt={p.imgAlt}
            locationIcon={p.locationIcon}
            ref={p.ref}
            refColor={p.refColor}
            typePlaceholder={p.typePlaceholder}
            titlePlaceholder={p.titlePlaceholder}
            summaryPlaceholder={p.summaryPlaceholder}
            specLabel={p.specLabel}
            specValue={p.specValue}
            specDetail={p.specDetail}
            specId={`spec-${p.id}`}
          />
        ))
      }
    </div>
  </Container>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');
  const counterDisplay = document.getElementById('project-count');

  const activeClasses = ['bg-primary-container', 'text-on-primary'];
  const inactiveClasses = ['bg-surface-container-lowest', 'text-secondary'];

  const applyFilter = (active: HTMLButtonElement) => {
    const filterValue = active.dataset.filter ?? 'all';

    filterButtons.forEach((btn) => {
      const on = btn === active;
      btn.classList.remove(...(on ? inactiveClasses : activeClasses));
      btn.classList.add(...(on ? activeClasses : inactiveClasses));
      btn.setAttribute('aria-pressed', String(on));
    });

    let visibleCount = 0;
    projectCards.forEach((card) => {
      const match = filterValue === 'all' || card.dataset.category === filterValue;
      card.classList.toggle('hidden', !match);
      if (match) visibleCount++;
    });

    if (counterDisplay) counterDisplay.textContent = String(visibleCount);
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => applyFilter(button));
  });

  const initCount = () => {
    const visible = Array.from(projectCards).filter(
      (card) => !card.classList.contains('hidden')
    ).length;
    if (counterDisplay) counterDisplay.textContent = String(visible);
  };
  initCount();

  document.querySelectorAll<HTMLButtonElement>('.spec-toggle').forEach((toggle) => {
    const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    const icon = toggle.querySelector<HTMLElement>('.spec-icon');
    toggle.addEventListener('click', () => {
      if (!panel) return;
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      panel.classList.toggle('hidden', expanded);
      icon?.classList.toggle('rotate-180', !expanded);
    });
  });
</script>