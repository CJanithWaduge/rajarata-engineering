---
/**
 * Engineering consultation CTA (Steps A4.44–A4.48)
 * Inverse CTA panel, grid background motif, actions, and contact methods.
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 bg-surface-container-lowest">
  <Container>
    <div class="bg-inverse-surface rounded-3xl p-8 sm:p-12 lg:p-16 relative overflow-hidden shadow-2xl">
      <!-- Technical Grid Background Pattern Accent -->
      <div class="absolute inset-0 opacity-5 pointer-events-none">
        <svg height="100%" width="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern height="40" id="cta-grid" patternUnits="userSpaceOnUse" width="40">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ffffff" stroke-width="1"></path>
            </pattern>
          </defs>
          <rect fill="url(#cta-grid)" height="100%" width="100%"></rect>
        </svg>
      </div>
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-on-surface/20 text-error-container font-label-caps text-label-caps uppercase tracking-wider mb-6">
          <span class="material-symbols-outlined text-[16px]">engineering</span>
          Direct Technical Consultation
        </div>
        <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-white tracking-tight mb-4">
          Connect with Our Engineering Directors &amp; Senior Project Managers
        </h2>
        <p class="font-body-lg text-body-lg text-gray-300 leading-relaxed mb-8">
          Whether you require comprehensive turnkey electrical contracting, switchgear upgrades, compliance audits, or building automation systems, our certified engineers are ready to assess your project specifications.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-lg hover:bg-primary-container transition-all active:translate-y-[1px] focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container" data-path="contact" href="#">
            <span>Initiate Project Consultation</span>
            <span class="material-symbols-outlined text-[20px]">send</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>