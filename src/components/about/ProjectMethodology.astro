---
/**
 * Five-stage project methodology (Steps A4.28–A4.35)
 * Protocol indicator and five process stages.
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 lg:py-24 bg-surface-container-lowest">
  <Container>
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-16 gap-6">
      <div>
        <span class="font-label-caps text-label-caps tracking-widest text-primary uppercase">Execution Architecture</span>
        <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface tracking-tight mt-2">
          Our 5-Stage Project Methodology
        </h2>
        <p class="font-body-md text-body-md text-secondary mt-2 max-w-2xl">
          From initial site audits through to final testing and lifelong preventative maintenance, our framework guarantees compliance, reliability, and precision.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded bg-surface-container font-label-caps text-label-caps text-secondary uppercase">Lifecycle Protocol</span>
        <span class="px-3 py-1 rounded bg-secondary-container font-label-caps text-label-caps text-on-secondary-fixed uppercase">ISO Standardized</span>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 relative">
      <!-- Step 1: Understand -->
      <div class="p-6 rounded-2xl bg-surface-container-low flex flex-col justify-between hover:bg-surface-container transition-colors relative">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="font-headline-md text-headline-md text-outline font-extrabold opacity-40">01</span>
            <div class="w-10 h-10 rounded-lg bg-surface-container-lowest flex items-center justify-center text-primary shadow-sm">
              <span class="material-symbols-outlined text-[22px]">manage_search</span>
            </div>
          </div>
          <h3 class="font-title-lg text-title-lg text-on-surface mb-2">Understand</h3>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed">
            In-depth requirement analysis, site constraints, load surveys, and environmental hazard evaluations.
          </p>
        </div>
        <div class="mt-6 pt-4 flex items-center gap-1 font-label-caps text-label-caps text-secondary uppercase">
          <span>Audit &amp; Assessment</span>
        </div>
      </div>
    </div>
  </Container>
</section>