---
/**
 * Industries and sectors served (Steps A4.36–A4.43)
 * Section heading, introduction, and six sector cards.
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 lg:py-24 bg-surface" data-scroll-reveal>
  <Container>
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="font-label-caps text-label-caps tracking-widest text-primary uppercase">Sector Experience</span>
      <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface tracking-tight mt-2">
        Industries &amp; Sectors Served
      </h2>
      <p class="font-body-md text-body-md text-secondary mt-3">
        Deploying specialized electrical and low-voltage engineering across high-demand industrial, commercial, and institutional environments.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Sector 1: Factories & Manufacturing -->
      <div class="card-interactive card-tilt bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex items-start gap-4" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[28px]">precision_manufacturing</span>
        </div>
        <div>
          <h3 class="font-title-lg text-title-lg text-on-surface mb-1">Factories &amp; Manufacturing</h3>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed">
            High-capacity industrial transformers, motor control centers (MCC), sub-distribution panels, and heavy machinery cabling.
          </p>
        </div>
      </div>
      <!-- Sector 2: Commercial & Retail -->
      <div class="card-interactive card-tilt bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex items-start gap-4" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[28px]">storefront</span>
        </div>
        <div>
          <h3 class="font-title-lg text-title-lg text-on-surface mb-1">Commercial &amp; Retail</h3>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed">
            Energy-efficient architectural lighting systems, complex interior power grids, emergency backup supplies, and smart sub-metering.
          </p>
        </div>
      </div>
      <!-- Sector 3: Residential Developers -->
      <div class="card-interactive card-tilt bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex items-start gap-4" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[28px]">apartment</span>
        </div>
        <div>
          <h3 class="font-title-lg text-title-lg text-on-surface mb-1">Residential Developers</h3>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed">
            Turnkey electrical infrastructure for multi-unit high-rises, gated housing schemes, EV charging infrastructure, and surge protection.
          </p>
        </div>
      </div>
      <!-- Sector 4: Hospitality & Hotels -->
      <div class="card-interactive card-tilt bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex items-start gap-4" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[28px]">hotel</span>
        </div>
        <div>
          <h3 class="font-title-lg text-title-lg text-on-surface mb-1">Hospitality &amp; Hotels</h3>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed">
            Continuous redundant power distribution, acoustic low-noise generators, room automation systems, and guest-facing safety ELV.
          </p>
        </div>
      </div>
      <!-- Sector 5: Warehouses & Logistics -->
      <div class="card-interactive card-tilt bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex items-start gap-4" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[28px]">warehouse</span>
        </div>
        <div>
          <h3 class="font-title-lg text-title-lg text-on-surface mb-1">Warehouses &amp; Logistics</h3>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed">
            High-bay LED installations, extensive cable tray management systems, automated conveyor power lines, and lightning protection.
          </p>
        </div>
      </div>
      <!-- Sector 6: Educational & Healthcare -->
      <div class="card-interactive card-tilt bg-surface-container-lowest rounded-2xl p-6 shadow-sm flex items-start gap-4" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-surface-container flex-shrink-0 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[28px]">local_hospital</span>
        </div>
        <div>
          <h3 class="font-title-lg text-title-lg text-on-surface mb-1">Educational &amp; Healthcare</h3>
          <p class="font-body-sm text-body-sm text-secondary leading-relaxed">
            Mission-critical UPS backup, medical-grade isolated power systems (IPS), campus-wide structured cabling, and life-safety systems.
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>