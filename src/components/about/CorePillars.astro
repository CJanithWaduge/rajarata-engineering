---
/**
 * Core pillars of engineering conduct (Steps A4.21–A4.27)
 * Section heading, introduction, and five principles.
 */
import Container from '../Container.astro';
---

<section class="w-full py-16 lg:py-24 bg-surface" data-scroll-reveal>
  <Container>
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="font-label-caps text-label-caps tracking-widest text-primary uppercase">Guiding Code</span>
      <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface tracking-tight mt-2">
        Core Pillars of Engineering Conduct
      </h2>
      <p class="font-body-md text-body-md text-secondary mt-3">
        Our foundational principles mandate technical accountability, unbending safety culture, and verifiable installation craftsmanship.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      <!-- Value 1: Safety -->
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-2xl shadow-sm flex flex-col h-full" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-error-container text-primary flex items-center justify-center mb-5">
          <span class="material-symbols-outlined text-[28px]">health_and_safety</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface mb-2">Safety</h3>
        <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
          [REPLACE: Commitment to absolute workplace and electrical safety]
        </p>
        <div class="mt-4 pt-3 flex items-center gap-1.5 text-primary font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-[16px]">check_circle</span>
          <span>Zero-Harm Standard</span>
        </div>
      </div>
      <!-- Value 2: Quality -->
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-2xl shadow-sm flex flex-col h-full" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-secondary-container text-secondary flex items-center justify-center mb-5">
          <span class="material-symbols-outlined text-[28px]">precision_manufacturing</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface mb-2">Quality</h3>
        <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
          [REPLACE: High engineering standards and certified components]
        </p>
        <div class="mt-4 pt-3 flex items-center gap-1.5 text-secondary font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-[16px]">verified</span>
          <span>Certified Materials</span>
        </div>
      </div>
      <!-- Value 3: Integrity -->
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-2xl shadow-sm flex flex-col h-full" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-surface-container-high text-on-surface flex items-center justify-center mb-5">
          <span class="material-symbols-outlined text-[28px]">balance</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface mb-2">Integrity</h3>
        <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
          [REPLACE: Transparent contracting, honest estimates, and accountability]
        </p>
        <div class="mt-4 pt-3 flex items-center gap-1.5 text-on-surface font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-[16px]">fact_check</span>
          <span>Honest Contracts</span>
        </div>
      </div>
      <!-- Value 4: Reliability -->
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-2xl shadow-sm flex flex-col h-full" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-tertiary-fixed text-tertiary flex items-center justify-center mb-5">
          <span class="material-symbols-outlined text-[28px]">schedule</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface mb-2">Reliability</h3>
        <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
          [REPLACE: On-time delivery and dependable systems]
        </p>
        <div class="mt-4 pt-3 flex items-center gap-1.5 text-tertiary font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-[16px]">alarm_on</span>
          <span>On-Time Milestone</span>
        </div>
      </div>
      <!-- Value 5: Continuous Improvement -->
      <div class="card-interactive card-tilt bg-surface-container-lowest p-6 rounded-2xl shadow-sm flex flex-col h-full" data-card-tilt>
        <div class="w-12 h-12 rounded-xl bg-primary-fixed text-primary flex items-center justify-center mb-5">
          <span class="material-symbols-outlined text-[28px]">trending_up</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface mb-2">Improvement</h3>
        <p class="font-body-sm text-body-sm text-secondary leading-relaxed flex-grow">
          [REPLACE: Adopting latest engineering codes, tech, and training]
        </p>
        <div class="mt-4 pt-3 flex items-center gap-1.5 text-primary font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-[16px]">auto_awesome</span>
          <span>Latest Standards</span>
        </div>
      </div>
    </div>
  </Container>
</section>