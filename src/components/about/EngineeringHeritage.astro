---
/**
 * Engineering heritage and milestones (Steps A4.11–A4.17)
 * Chronology narrative panel and milestone timeline.
 */
import Container from '../Container.astro';
---

<section id="story" class="w-full py-16 lg:py-24 bg-surface">
  <Container>
    <div class="flex flex-col mb-12">
      <span class="font-label-caps text-label-caps tracking-widest text-primary uppercase">Chronology of Growth</span>
      <h2 class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface tracking-tight mt-2">
        Engineering Heritage &amp; Milestones
      </h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Story Narrative Panel -->
      <div class="lg:col-span-5 flex flex-col space-y-6 bg-surface-container-lowest p-8 rounded-2xl shadow-sm">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[28px]">domain_verification</span>
          </div>
          <div>
            <span class="font-label-caps text-label-caps text-secondary uppercase">Year of Establishment</span>
            <div class="font-headline-md text-headline-md text-on-surface font-bold">
              [REPLACE: COMPANY FOUNDING YEAR]
            </div>
          </div>
        </div>
        <div class="font-body-lg text-body-lg text-secondary leading-relaxed">
          [REPLACE: COMPANY HISTORY]
        </div>
        <div class="p-5 rounded-xl bg-surface-container-low flex flex-col space-y-2">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">military_tech</span>
            <span class="font-label-caps text-label-caps uppercase text-on-surface">Current Standing</span>
          </div>
          <p class="font-body-md text-body-md text-on-surface font-medium">
            [REPLACE: CURRENT COMPANY POSITION]
          </p>
        </div>
      </div>
      <!-- Milestones Timeline -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <div class="relative pl-8 sm:pl-10 space-y-8 before:content-[''] before:absolute before:left-3 sm:before:left-4 before:top-3 before:bottom-3 before:w-0.5 before:bg-surface-variant">
          <!-- Milestone Node 1: Founding -->
          <div class="relative group">
            <div class="absolute -left-8 sm:-left-10 top-1.5 w-7 h-7 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform">
              <div class="w-3.5 h-3.5 rounded-full bg-primary"></div>
            </div>
            <div class="p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="font-label-caps text-label-caps uppercase text-primary tracking-wider">Foundation &amp; Groundwork</span>
                <span class="px-2.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-secondary">[REPLACE: COMPANY FOUNDING YEAR]</span>
              </div>
              <h3 class="font-title-lg text-title-lg text-on-surface mb-2">Incorporation &amp; First Major Grid Contract</h3>
              <p class="font-body-md text-body-md text-secondary">
                Established with a primary focus on specialized commercial electrical services, safety certification, and engineering adherence.
              </p>
            </div>
          </div>
          <!-- Milestone Node 2: Key Milestone 1 -->
          <div class="relative group">
            <div class="absolute -left-8 sm:-left-10 top-1.5 w-7 h-7 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform">
              <div class="w-3.5 h-3.5 rounded-full bg-primary-container"></div>
            </div>
            <div class="p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="font-label-caps text-label-caps uppercase text-primary tracking-wider">Scale &amp; Expansion</span>
                <span class="px-2.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-secondary">Expansion Era</span>
              </div>
              <h3 class="font-title-lg text-title-lg text-on-surface mb-2">Industrial Heavy Power Infrastructure</h3>
              <p class="font-body-md text-body-md text-secondary">
                [REPLACE: KEY MILESTONE]
              </p>
            </div>
          </div>
          <!-- Milestone Node 3: Key Milestone 2 -->
          <div class="relative group">
            <div class="absolute -left-8 sm:-left-10 top-1.5 w-7 h-7 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform">
              <div class="w-3.5 h-3.5 rounded-full bg-tertiary"></div>
            </div>
            <div class="p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="font-label-caps text-label-caps uppercase text-tertiary tracking-wider">Technological Diversification</span>
                <span class="px-2.5 py-0.5 rounded bg-secondary-container font-label-sm text-label-sm text-on-secondary-fixed">Innovation</span>
              </div>
              <h3 class="font-title-lg text-title-lg text-on-surface mb-2">ELV, Automation &amp; Renewable Integration</h3>
              <p class="font-body-md text-body-md text-secondary">
                [REPLACE: KEY MILESTONE]
              </p>
            </div>
          </div>
          <!-- Milestone Node 4: Contemporary Position -->
          <div class="relative group">
            <div class="absolute -left-8 sm:-left-10 top-1.5 w-7 h-7 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform">
              <div class="w-3.5 h-3.5 rounded-full bg-on-surface"></div>
            </div>
            <div class="p-6 rounded-2xl bg-inverse-surface text-on-primary shadow-md">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="font-label-caps text-label-caps uppercase text-error-container tracking-wider">Today &amp; Tomorrow</span>
                <span class="px-2.5 py-0.5 rounded bg-on-secondary-fixed-variant/40 font-label-sm text-label-sm text-white">Present Stage</span>
              </div>
              <h3 class="font-title-lg text-title-lg text-white mb-2">Premier National Engineering Contractor</h3>
              <p class="font-body-md text-body-md text-gray-300">
                [REPLACE: CURRENT COMPANY POSITION]
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>