---
/**
 * Site footer.
 *
 * Light surface. The prototypes use a near-black footer (#0b0f17) with
 * colours that are not in DESIGN.md — a second red (#ef4444) and a grey
 * (#9ca3af) that exists nowhere else in the system. That palette has been
 * dropped in favour of the approved tokens.
 *
 * Every foreground/background pair below was contrast-checked against
 * surface-container-low (#f3f3f3); all pass WCAG AA. See the WhatsApp block
 * in global.css for the one deliberate exception to the palette.
 *
 * Business details are baked into the static build. Public pages do not read
 * Firestore at runtime; published content is supplied by the build pipeline.
 */
import Container from './Container.astro';
import Logo from './Logo.astro';
import WhatsAppIcon from './ui/WhatsAppIcon.astro';
import { parseWhatsAppNumber } from '../lib/whatsapp';

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '/contact' },
];

// The prototype lists seven, not the six the plan mentions. Kept as-is
// rather than dropping one to hit the count.
const services = [
  { label: 'Residential & Commercial Wiring', href: '/services#service-01' },
  { label: 'Industrial Installations', href: '/services#service-02' },
  { label: 'MDB / SMDB Panel Installation', href: '/services#service-03' },
  { label: 'Cable Tray & Laying', href: '/services#service-04' },
  { label: 'Testing & Commissioning', href: '/services#service-05' },
  { label: 'ELV Solutions & Automation', href: '/services#service-07' },
  { label: 'Lightning Protection System', href: '/services#service-08' },
];

const badges = ['ISO 9001:2015', 'Safety First'];

const details = {
  address: 'Rajarata Engineering, Anuradhapura',
  phone: '+94 77 XXX XXXX',
  email: 'contact@rajarata.lk',
  hours: 'Mon – Fri, 8:00 – 17:30',
};

const whatsapp = parseWhatsAppNumber(import.meta.env.PUBLIC_WHATSAPP_NUMBER);
if (whatsapp.status === 'invalid') {
  console.warn('PUBLIC_WHATSAPP_NUMBER must be 8–15 digits in international format.');
}

// Each row pairs its icon with the field key and how to rebuild its href.
// `href` is optional: address and hours are plain text, the rest are links.
const contact = [
  { icon: 'location_on', key: 'address', href: undefined },
  { icon: 'call', key: 'phone', href: 'tel' },
  { icon: 'mail', key: 'email', href: 'mailto' },
  { icon: 'schedule', key: 'hours', href: undefined },
] as const;

const year = new Date().getFullYear();

// Focus rings on a light footer need the ink outline, not the white one the
// dark footer used.
const focus = 'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';
---

<footer
  class="w-full bg-surface-container-low text-secondary font-body-sm text-body-sm border-t border-outline-variant"
>
  <Container class="pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      <!-- Column 1 — brand -->
      <div class="lg:col-span-4 flex flex-col space-y-4">
        <a href="/" class={`flex items-center gap-3 w-fit ${focus}`}>
          <Logo class="h-10 w-auto" />
          <span class="flex flex-col">
            <span class="font-title-lg text-title-lg tracking-tight text-on-surface uppercase"
              >Rajarata</span
            >
            <span
              class="font-label-caps text-label-caps tracking-widest text-primary uppercase"
              >Engineering</span
            >
          </span>
        </a>
        <p class="text-secondary font-body-md text-body-md pr-4 leading-relaxed">
          Premier electrical engineering and contracting infrastructure solutions. Delivering
          utility-grade industrial power distribution, commercial installations, and
          mission-critical ELV building automation systems with uncompromising safety and
          compliance standards.
        </p>
        <div class="flex items-center gap-2 pt-2">
          {
            badges.map((badge) => (
              <span class="inline-flex items-center px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-label-caps text-label-caps uppercase">
                {badge}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Column 2 — quick links -->
      <nav class="lg:col-span-2 flex flex-col space-y-3" aria-label="Footer">
        <span class="font-title-md text-title-md text-on-surface tracking-wide"
          >Quick Links</span
        >
        <ul class="space-y-2.5 mt-2">
          {
            quickLinks.map((item) => (
              <li class="h-7 flex items-center">
                <a
                  href={item.href}
                  class={`hover:text-on-surface transition-colors ${focus}`}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Column 3 — services -->
      <nav class="lg:col-span-3 flex flex-col space-y-3" aria-label="Services">
        <span class="font-title-md text-title-md text-on-surface tracking-wide"
          >Our Services</span
        >
        <ul class="space-y-2.5 mt-2">
          {
            services.map((service) => (
              <li class="h-7 flex items-center">
                <a
                  href={service.href}
                  class={`hover:text-on-surface transition-colors truncate ${focus}`}
                >
                  {service.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Column 4 — contact -->
      <div class="lg:col-span-3 flex flex-col space-y-3">
        <span class="font-title-md text-title-md text-on-surface tracking-wide"
          >Contact Info</span
        >
        <div class="space-y-3 mt-2">
          {
            contact.map((item) => (
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-primary text-[20px] mt-0.5">
                  {item.icon}
                </span>
                <span
                  class={item.href ? 'truncate' : ''}
                >
                  {details[item.key]}
                </span>
              </div>
            ))
          }
          {whatsapp.status === 'ready' && (
            <div class="pt-2">
              <a
                href={whatsapp.href}
                aria-label={`Chat with Rajarata Engineering on WhatsApp at ${whatsapp.displayNumber}`}
                class={`inline-flex min-h-11 max-w-full flex-wrap items-center gap-2 break-all rounded-control bg-whatsapp px-3 py-2 font-label-sm text-label-sm text-white transition-colors hover:bg-whatsapp-hover active:translate-y-px ${focus}`}
              >
                <WhatsAppIcon class="h-5 w-5" />
                <span>{whatsapp.displayNumber}</span>
              </a>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-outline-variant"
    >
      <p class="text-xs text-secondary">
        &copy; {year} Rajarata Engineering. All Rights Reserved. Electrical Engineering
        &amp; Contracting.
      </p>
      <p class="text-xs text-secondary font-label-caps uppercase tracking-wider">
        Built for Safety &amp; Performance
      </p>
    </div>
  </Container>
</footer>