---
/**
 * Card.
 *
 * 18px radius, 1px hairline border, 24px padding. The prototypes use
 * `p-6 rounded-2xl` with no border, relying on `shadow-sm` alone to separate
 * the card from the page — the hairline is an addition from DESIGN.md, and
 * it is what makes the border read as crisp rather than blurry.
 *
 * The `inverted` variant carries the 3px red accent strip and uses the
 * palette's inverse surface (#303030). Nothing in the prototypes actually
 * uses it — it exists for a future dark CTA band or promo section. The
 * strip is decorative, so it is hidden from assistive tech.
 */
interface Props {
  inverted?: boolean;
  /** Removes padding for cards that manage their own inner spacing. */
  flush?: boolean;
  /** Renders as a link wrapper. Use for cards that are navigation targets. */
  href?: string;
  class?: string;
}

const {
  inverted = false,
  flush = false,
  href,
  class: className,
} = Astro.props;

const shell = inverted
  ? 'bg-inverse-surface text-inverse-on-surface border-white/10'
  : 'bg-surface-container-lowest text-on-surface border-outline-variant';

const base =
  'relative flex flex-col rounded-card border transition-all duration-200';

const interactive = href
  ? 'hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container'
  : 'shadow-sm';

const classes = `${base} ${shell} ${interactive} ${flush ? '' : 'p-6'} ${className ?? ''}`;

// Drawn with a pseudo-element rather than a real child div — a sibling would
// sit in the flex flow and push the card's content sideways.
const hasStrip = inverted
  ? 'before:absolute before:left-0 before:top-0 before:h-full before:w-[3px] before:bg-primary-container before:rounded-l-card before:content-[""]'
  : '';
---

{
  href ? (
    <a class={`${classes} ${hasStrip} hover:shadow-md`} href={href}>
      <slot />
    </a>
  ) : (
    <div class={`${classes} ${hasStrip}`}>
      <slot />
    </div>
  )
}
