---
/**
 * Button.
 *
 * Renders an <a> when `href` is given, otherwise a <button>. Same props,
 * same look, so a link-that-goes-somewhere and a button-that-does-a-thing
 * are interchangeable in layout.
 *
 * Sizing follows DESIGN.md: 48px desktop, 40px compact. The prototypes
 * express this with padding pairs rather than fixed heights, so `sm` here
 * maps to their compact button and `md` to their full-size one.
 *
 * Note on the prototypes' `rounded-xl`: their inline Tailwind config
 * remapped the radius scale (xl -> 0.75rem), so `rounded-xl` there means
 * 12px. This uses the named token instead, which is unambiguous.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Marks the control unavailable. Only valid on <button>. */
  disabled?: boolean;
  /** Accessible name when the visible content is an icon. */
  'aria-label'?: string;
  class?: string;
}

/**
 * Variant colours are taken from the prototypes, not invented:
 *   primary   — red fill, white text, shadow
 *   secondary — grey `surface-container` fill, dark text, no shadow
 *   outline   — transparent, 1.5px hairline
 *
 * The secondary button carries no shadow in any prototype; a grey fill on a
 * light page does not need one to separate it.
 *
 * Focus: the ring matches Header, Footer, and Card — 2px primary-container
 * outline at 2px offset, suppressed for pointer focus via `focus:outline-none`
 * so it only appears for keyboard users. Button was the one interactive
 * component missing this.
 */

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-label-md text-label-md ' +
  'rounded-control whitespace-nowrap transition-all duration-150 ' +
  'active:translate-y-[1px] ' +
  'focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-container';

const variants = {
  primary:
    'bg-primary-container text-on-primary shadow-sm hover:bg-primary hover:shadow-md',
  secondary:
    'bg-surface-container text-on-surface hover:bg-surface-container-high',
  outline:
    'bg-transparent text-on-surface border-[1.5px] border-outline-variant hover:bg-surface-container-low hover:border-outline',
} as const;

const sizes = {
  sm: 'h-10 px-5',
  md: 'h-12 px-7',
} as const;

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className ?? ''}`;

// A disabled <a> is not a real state — it stays focusable and clickable.
// Callers should not pass disabled together with href.
const classesForAnchor = disabled
  ? `${classes} pointer-events-none opacity-50`
  : classes;
---

{
  href ? (
    <a class={classesForAnchor} href={href} aria-label={Astro.props['aria-label']}>
      <slot />
    </a>
  ) : (
    <button
      class={classes}
      type={type}
      disabled={disabled}
      aria-label={Astro.props['aria-label']}
    >
      <slot />
    </button>
  )
}
