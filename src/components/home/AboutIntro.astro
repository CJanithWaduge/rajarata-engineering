---
/**
 * About introduction (Step 3.4)
 * Added body paragraph with [REPLACE: Company introduction].
 */
import Container from "../Container.astro";
---

<section class="w-full bg-surface-container-lowest py-16 lg:py-24">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Text Details -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <div class="flex items-center gap-2">
          <span class="w-8 h-1 bg-primary-container rounded-full"></span>
          <span class="font-label-caps text-label-caps uppercase text-primary tracking-wider"
            >About Rajarata Engineering</span
          >
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface leading-tight">
          Engineering Solutions You Can Rely On
        </h2>
        <p class="font-body-lg text-body-lg text-secondary leading-relaxed">
          [REPLACE: Company introduction]
        </p>
      </div>
    </div>
  </Container>
</section>
