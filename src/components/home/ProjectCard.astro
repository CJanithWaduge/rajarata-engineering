---
/**
 * Project card (Step 6.3)
 * Image slot, category chip, title, and metadata row.
 * Structure proven against the prototype's real project card markup.
 *
 * NOTE: imageSrc is a hotlinked placeholder for now — real assets must be
 * sourced into Firebase Storage before Home ships (see IMPLEMENTATION.md).
 */
interface Props {
  imageSrc: string;
  imageAlt: string;
  category: string;
  location: string;
  year: string;
  name: string;
}

const { imageSrc, imageAlt, category, location, year, name } = Astro.props;
---

<div
  class="card-interactive card-tilt flex flex-col rounded-2xl overflow-hidden bg-surface-container-lowest shadow-sm"
  data-card-tilt
>
  <div class="relative w-full h-56 bg-surface-container">
    <img class="w-full h-full object-cover" src={imageSrc} alt={imageAlt} loading="lazy" />
    <div
      class="absolute top-4 left-4 px-2.5 py-1 rounded-md bg-inverse-surface/80 text-white font-label-caps text-label-caps uppercase"
    >
      {category}
    </div>
  </div>
  <div class="p-6 flex flex-col flex-1 justify-between space-y-5">
    <div class="flex flex-col space-y-2">
      <div class="flex items-center justify-between text-secondary font-body-sm text-body-sm">
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">location_on</span>
          {location}
        </span>
        <span>{year}</span>
      </div>
      <h3 class="font-title-lg text-title-lg text-on-surface">{name}</h3>
    </div>
    <div>
      <a
        class="inline-flex items-center gap-1 text-primary-container font-label-md text-label-md hover:underline"
        data-path="projects"
        href="#">
        <span>View Project</span>
        <span class="material-symbols-outlined text-sm">north_east</span>
      </a>
    </div>
  </div>
</div>
