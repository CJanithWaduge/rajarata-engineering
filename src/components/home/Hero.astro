---
/**
 * Hero — section 1 of the Home page.
 *
 * Source: the first <section> in UI-UX-design/home_rajarata_engineering/code.html
 *
 * Structure. The grid is two 6-column halves at `lg`, stacked below it:
 *   - left  — eyebrow pill, h1, intro paragraph, CTA row
 *   - right — hero image, gradient scrim, telemetry badge, status tag
 *
 * Note: Astro does NOT strip HTML comments from templates, so nothing
 * explanatory belongs in the markup below — it would ship to production.
 * Planning notes live in this frontmatter block instead, which is stripped.
 *
 * Anchor targets. Both CTA hrefs point at ids that do not exist yet, so both
 * are inert until those sections are built:
 *   #contact        — Contact page, not started
 *   #services-list  — Services grid, step 4.1 must add `id="services-list"`
 *
 * The local illustration is intentionally labeled as sample artwork.
 *
 * Deliberately no `width`/`height` on the images: each sits in a fixed-height
 * container at `h-full object-cover`, so the box never reflows and there is no
 * layout shift to prevent. Intrinsic dimensions would be ignored anyway.
 *
 * Overlay stacking. The scrim, telemetry badge, and status tag are all
 * `absolute` siblings of the image. Order alone would put the badge and tag
 * above the scrim, but that is implicit and breaks the moment either is
 * reordered — so all three overlays carry `z-10`, which makes the intent
 * explicit and keeps the badge and tag at equal rank.
 *
 * Badge text fitting. The title is kept to one line and truncated when the
 * badge is too narrow. The mobile insets keep the card within the image;
 * from `sm` upward it shrinks to its content and is capped at `max-w-xs`.
 *
 * On mobile, the badge's left and right insets bound its width without needing
 * an arbitrary `calc()` value.
 */
import Container from '../Container.astro';
import Button from '../ui/Button.astro';
---

<section
  class="relative w-full bg-surface-container-lowest overflow-hidden py-12 md:py-16 lg:py-24"
  data-scroll-reveal
>
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-6 flex flex-col items-start space-y-6">
        <p class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-error-container/40">
          <span
            class="w-2.5 h-2.5 rounded-full bg-primary-container animate-pulse"
            aria-hidden="true"></span>
          <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary"
            >Electrical Engineering &amp; Solutions</span
          >
        </p>

        <h1 class="text-[34px] sm:text-[46px] lg:text-[56px] leading-[1.12] tracking-tight font-display-hero text-on-surface">Reliable Electrical Solutions Built for <span class="text-primary-container">Safety &amp; Performance</span></h1>

        <p class="w-full max-w-xl font-body-lg text-body-lg text-secondary leading-relaxed">
          Sample electrical engineering and contracting content for this website template. Replace it with an owner-approved company introduction before real-world use.
        </p>

        <div class="w-full sm:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <Button variant="primary" href="/contact#quotation">
            <span>VIEW SAMPLE CONTACT</span>
            <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_forward</span>
          </Button>
          <Button variant="secondary" href="#services-list">EXPLORE SERVICES</Button>
        </div>

        <div class="flex items-center gap-6 pt-4 text-secondary">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container text-xl" aria-hidden="true"
              >verified</span
            >
            <span class="font-label-sm text-label-sm text-on-surface">Example compliance content</span>
          </div>
          <div class="flex items-center gap-2">
            <span
              class="material-symbols-outlined text-primary-container text-xl"
              aria-hidden="true">precision_manufacturing</span
            >
            <span class="font-label-sm text-label-sm text-on-surface">Verify standards before use</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 relative w-full">
        <div
          class="relative w-full h-[360px] sm:h-[420px] lg:h-[480px] rounded-2xl overflow-hidden shadow-xl bg-surface-container"
        >
          <img
            class="w-full h-full object-cover object-center"
            src="/images/sample-engineering.svg"
            alt="Sample engineering illustration showing electrical distribution panels; not a photograph of a company project"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
            <div
              class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-inverse-surface/20 to-transparent"
            >
            </div>
            <div
              class="absolute bottom-6 left-6 z-10 w-[calc(100%-3rem)] sm:w-80 p-4 rounded-xl bg-surface-container-lowest/95 backdrop-blur-md shadow-lg flex items-center gap-3.5"
            >
              <div
                class="w-12 h-12 rounded-lg bg-error-container/60 flex items-center justify-center text-primary-container shrink-0"
              >
                <span class="material-symbols-outlined text-2xl" aria-hidden="true"
                  >shield</span
                >
              </div>
              <div class="flex flex-col flex-1 min-w-0">
              <span class="font-title-md text-title-md text-on-surface leading-tight"
                >Example safety content</span
              >
                <span class="font-label-sm text-label-sm text-secondary truncate"
                  >Replace with verified policy</span
                >
              </div>
            </div>
            <div
              class="absolute top-5 right-5 z-10 px-3 py-1.5 rounded-lg bg-inverse-surface/90 text-on-primary font-label-caps text-label-caps uppercase flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
              <span>SAMPLE TEMPLATE</span>
            </div>
          </div>
        </div>
    </div>
  </Container>
</section>