---
/**
 * Hero — section 1 of the Home page.
 *
 * Source: the first <section> in UI-UX-design/home_rajarata_engineering/code.html
 *
 * Structure. The grid is two 6-column halves at `lg`, stacked below it:
 *   - left  — eyebrow pill, h1, intro paragraph, CTA row
 *   - right — hero image, gradient scrim, telemetry badge, status tag
 *
 * Note: Astro does NOT strip HTML comments from templates, so nothing
 * explanatory belongs in the markup below — it would ship to production.
 * Planning notes live in this frontmatter block instead, which is stripped.
 *
 * Anchor targets. Both CTA hrefs point at ids that do not exist yet, so both
 * are inert until those sections are built:
 *   #contact        — Contact page, not started
 *   #services-list  — Services grid, step 4.1 must add `id="services-list"`
 *
 * Images. Every `src` below is still the prototype's `lh3.googleusercontent`
 * hotlink. Those URLs will not survive. Each needs a real asset uploaded to
 * Firebase Storage before Home ships. The parent element carries
 * `bg-surface-container`, so a failed load degrades to a grey panel rather
 * than a broken-image icon.
 *
 * Deliberately no `width`/`height` on the images: each sits in a fixed-height
 * container at `h-full object-cover`, so the box never reflows and there is no
 * layout shift to prevent. Intrinsic dimensions would be ignored anyway.
 */
import Container from '../Container.astro';
import Button from '../ui/Button.astro';
---

<section
  class="relative w-full bg-surface-container-lowest overflow-hidden py-12 md:py-16 lg:py-24"
>
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-6 flex flex-col items-start space-y-6">
        <p class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-error-container/40">
          <span
            class="w-2.5 h-2.5 rounded-full bg-primary-container animate-pulse"
            aria-hidden="true"></span>
          <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary"
            >Electrical Engineering &amp; Solutions</span
          >
        </p>

        <h1 class="text-[34px] sm:text-[46px] lg:text-[56px] leading-[1.12] tracking-tight font-display-hero text-on-surface">Reliable Electrical Solutions Built for <span class="text-primary-container">Safety &amp; Performance</span></h1>

        <p class="font-body-lg text-body-lg text-secondary leading-relaxed max-w-xl">
          [REPLACE: 1–2 sentence company introduction]
        </p>

        <div class="w-full sm:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <Button variant="primary" href="#contact">
            <span>GET A QUOTE</span>
            <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_forward</span>
          </Button>
          <Button variant="secondary" href="#services-list">EXPLORE SERVICES</Button>
        </div>

        <div class="flex items-center gap-6 pt-4 text-secondary">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container text-xl" aria-hidden="true"
              >verified</span
            >
            <span class="font-label-sm text-label-sm text-on-surface">Certified Compliance</span>
          </div>
          <div class="flex items-center gap-2">
            <span
              class="material-symbols-outlined text-primary-container text-xl"
              aria-hidden="true">precision_manufacturing</span
            >
            <span class="font-label-sm text-label-sm text-on-surface">Industrial Standard</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 relative w-full">
        <div
          class="relative w-full h-[360px] sm:h-[420px] lg:h-[480px] rounded-2xl overflow-hidden shadow-xl bg-surface-container"
        >
          <img
            class="w-full h-full object-cover object-center"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBGCO8SgW7oLqCs8-k81OOZount04OcaGdN0vURh96M3xpQaJ3Pg1m8LRdkTImpJzcKL7SbAA8ESnnXfP5e0H6gXrHEUAMuIR43rsW4jkChGBn4lWyIlSkbFt7HEOBVfrWTJSubBPVpCPt7q9e4LgBocmHQkji7DAGzJpYcw61eRDRR-z_yFTGzXZGbuhtDtmzjWXU6ydWyfZsFQeXH5RQq3u1fiUE_Rb6gb5cscKzkV808qS3luJlobQ"
            alt="Professional female electrical engineer wearing white safety hardhat, high-visibility orange safety vest, and safety goggles examining an open industrial electrical MDB control panel board with terminal blocks and wiring harnesses inside a modern high-tech manufacturing plant"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-inverse-surface/20 to-transparent"
          >
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>