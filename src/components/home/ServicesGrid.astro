---
/**
 * Services grid (Step 4.1)
 * Shell: wrapper, grid, and the id="services-list" anchor target
 * for the Hero "EXPLORE SERVICES" button.
 */
import Container from "../Container.astro";
---

<section class="w-full bg-surface-container-low py-16 lg:py-24" id="services-list">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"></div>
  </Container>
</section>
