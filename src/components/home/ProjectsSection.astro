---
/**
 * Featured projects (Step 6.4)
 * Added Project card 1 via ProjectCard component.
 * Cards use clearly labeled sample content and local template artwork.
 */
import Container from "../Container.astro";
import ProjectCard from "./ProjectCard.astro";
---

<section class="w-full bg-surface-container-low py-16 lg:py-24" data-scroll-reveal>
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="flex flex-col space-y-3">
        <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary"
          >Demonstrated Capability</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface"
          >Featured Engineering Projects</h2
        >
      </div>
      <a
        class="inline-flex items-center gap-2 font-label-md text-label-md text-primary-container hover:text-primary transition-colors"
        data-path="projects"
        href="/projects">
        <span>View Sample Projects</span>
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <ProjectCard
        imageSrc="/images/sample-project.svg"
        imageAlt="Illustrative electrical engineering project artwork; not a photograph of a completed project"
        category="Sample industrial"
        location="Sample location"
        year="20XX"
        name="Sample distribution project"
      />
      <ProjectCard
        imageSrc="/images/sample-project.svg"
        imageAlt="Illustrative electrical engineering project artwork; not a photograph of a completed project"
        category="Sample commercial"
        location="Sample location"
        year="20XX"
        name="Sample control panel project"
      />
      <ProjectCard
        imageSrc="/images/sample-project.svg"
        imageAlt="Illustrative electrical engineering project artwork; not a photograph of a completed project"
        category="Sample ELV"
        location="Sample location"
        year="20XX"
        name="Sample building systems project"
      />
    </div>
  </Container>
</section>
