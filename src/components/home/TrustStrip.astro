---
/**
 * Trust strip - social proof with credibility indicators (Step 2.5)
 * Fourth trust item added: ELV Solutions (Smart Automation & Data) with router icon.
 */
import Container from "../Container.astro";
---

<section class="w-full bg-surface-container-low py-8">
  <Container>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Trust Item 1 -->
      <div
        class="flex items-center gap-4 p-4 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0"
        >
          <span class="material-symbols-outlined text-2xl">electric_meter</span>
        </div>
        <div class="flex flex-col">
          <span class="font-title-md text-title-md text-on-surface">Electrical Installations</span>
          <span class="font-body-sm text-body-sm text-secondary">MV &amp; LV Distribution</span>
        </div>
      </div>

      <!-- Trust Item 2 -->
      <div
        class="flex items-center gap-4 p-4 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0"
        >
          <span class="material-symbols-outlined text-2xl">factory</span>
        </div>
        <div class="flex flex-col">
          <span class="font-title-md text-title-md text-on-surface">Industrial Solutions</span>
          <span class="font-body-sm text-body-sm text-secondary">Manufacturing &amp; Plants</span>
        </div>
      </div>

      <!-- Trust Item 3 -->
      <div
        class="flex items-center gap-4 p-4 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0"
        >
          <span class="material-symbols-outlined text-2xl">troubleshoot</span>
        </div>
        <div class="flex flex-col">
          <span class="font-title-md text-title-md text-on-surface">Testing &amp; Commissioning</span>
          <span class="font-body-sm text-body-sm text-secondary">Calibrated Diagnostic Rig</span>
        </div>
      </div>

      <!-- Trust Item 4 -->
      <div
        class="flex items-center gap-4 p-4 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0"
        >
          <span class="material-symbols-outlined text-2xl">router</span>
        </div>
        <div class="flex flex-col">
          <span class="font-title-md text-title-md text-on-surface">ELV Solutions</span>
          <span class="font-body-sm text-body-sm text-secondary">Smart Automation &amp; Data</span>
        </div>
      </div>
    </div>
  </Container>
</section>
