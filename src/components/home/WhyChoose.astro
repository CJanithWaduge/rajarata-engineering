      <!-- Feature 2 -->
      <div class="p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4">
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl">high_quality</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface">Quality Work</h3>
        <p class="font-body-md text-body-md text-secondary leading-relaxed">
          [REPLACE: Quality engineering standards and certified components]
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4">
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl">engineering</span>
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface"
