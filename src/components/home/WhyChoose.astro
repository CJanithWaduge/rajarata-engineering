<section class="w-full bg-surface-container-lowest py-16 lg:py-24">
  <Container>
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto space-y-4 mb-14">
      <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary"
        >Proven Excellence</span
      >
      <h2 class="font-headline-lg text-headline-lg text-on-surface"
        >Why Choose Rajarata Engineering</h2
      >
      <p class="font-body-lg text-body-lg text-secondary">
        Engineering rigor, technical competence, and complete regulatory accountability deployed on every site.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Feature 1 -->
      <div class="p-6 rounded-2xl bg-surface-container-low flex flex-col space-y-4">
        <div
          class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-sm"
        >
          <span class="material-symbols-outlined text-2xl"
            >health_and_safety</span
          >
        </div>
        <h3 class="font-title-lg text-title-lg text-on-surface">Safety First</h3>
        <p class="font-body-md text-body-md text-secondary leading-relaxed">
          [REPLACE: Safety protocols and zero-hazard commitment]
