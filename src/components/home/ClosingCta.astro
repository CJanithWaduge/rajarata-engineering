---
/**
 * Closing CTA (Step 7.2)
 * Added 64px red rule (w-16 h-1 bg-primary-container rounded-full)
 * and h2 "Have an Electrical Project in Mind?" at display-hero.
 */
---

<section class="w-full bg-[#111827] text-white py-16 lg:py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center space-y-8">
      <div class="w-16 h-1 bg-primary-container rounded-full"></div>
      <h2 class="font-display-hero text-display-hero text-white tracking-tight">
        Have an Electrical Project in Mind?
      </h2>
      <p class="font-body-lg text-body-lg text-gray-300 max-w-2xl leading-relaxed">
        Talk to our team about your electrical installation, maintenance or engineering requirements.
      </p>
      <div class="w-full sm:w-auto flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 pt-2">
        <a
          class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-primary-container text-on-primary font-label-md text-label-md shadow-lg hover:bg-primary transition-all duration-150 active:translate-y-[1px]"
          data-path="contact"
          href="#">
          <span>REQUEST A QUOTE</span>
          <span class="material-symbols-outlined ml-2 text-base">request_quote</span>
        </a>
        <a
          class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-label-md text-label-md transition-all duration-150 active:translate-y-[1px]"
          data-path="contact"
          href="#">
          <span>CONTACT US</span>
          <span class="material-symbols-outlined ml-2 text-base">support_agent</span>
        </a>
      </div>
      <!-- Immediate Contact Details Pill -->
      <div class="pt-6 flex flex-wrap items-center justify-center gap-8 text-gray-400 font-body-sm text-body-sm">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary-container text-lg">call</span>
          <span>Emergency Response Available</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary-container text-lg">verified</span>
          <span>Licensed Engineering Standards</span>
        </div>
      </div>
    </div>
  </div>
</section>
