# Fictional values for local development only. Use the Firebase Functions
# emulator with a local SMTP sink such as Mailpit; replace every value before
# deployment. The .invalid domain is reserved and cannot receive real mail.
CONTACT_SMTP_HOST=127.0.0.1
CONTACT_SMTP_PORT=1025
CONTACT_SMTP_SECURE=false
CONTACT_SENDER=website@example.invalid
CONTACT_RECIPIENT=inquiries@example.invalid
