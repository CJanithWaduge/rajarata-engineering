# Public Firebase web config.
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
#
# These are NOT secrets. A Firebase web API key identifies the project and
# rate-limits requests; it does not grant access on its own. Everything that
# actually protects data lives in firestore.rules. It is safe to ship to the
# browser — Firebase requires it to be visible there.
#
# Where to find them: Firebase console > Project settings > General >
# "Your apps" > Web app. They are also in google-services.json if you have
# one. Do NOT use the Admin SDK private key here — that one is a real secret
# and belongs in Cloud Functions config.

PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_API_KEY=