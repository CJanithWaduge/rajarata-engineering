# Public Firebase web config.
#
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
#
# These are NOT secrets. A Firebase web API key identifies the project and
# rate-limits requests; it does not grant access on its own. Everything that
# actually protects data lives in firestore.rules. It is safe to ship to the
# browser — Firebase requires it to be visible there.
#
# Where to find them: Firebase console > Project settings > General >
# "Your apps" > Web app. They are also in google-services.json if you have
# one. Do NOT use the Admin SDK private key here. The server uses its attached
# Cloud Run identity through Application Default Credentials.

PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Optional public WhatsApp contact. Include the country code; digits only.
# It is embedded in the static site at build time. Leave empty to hide the link.
PUBLIC_WHATSAPP_NUMBER=

# Server-only settings for the Admin SSR service.
FIREBASE_PROJECT_ID=demo-rajarata-engineering
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
ADMIN_PUBLIC_ORIGINS=